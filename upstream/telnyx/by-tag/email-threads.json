  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/email_threads": {
      "get": {
        "description": "Lists thread summaries for the whole account, newest first, using stable\ncursor pagination. An agent operating many inboxes gets every\nconversation in one call instead of one call per inbox. Each thread\ncarries its own `inbox_id` so a reply can be routed back to the right\ninbox. Use `filter[inbox_id]` (repeatable) to narrow the result to\nspecific inboxes. Because a thread ID can be delivered to multiple\ninboxes, each result is identified by its `(inbox_id, id)` pair.\n",
        "operationId": "ListEmailThreads",
        "parameters": [
          {
            "description": "Restrict results to one or more inboxes. Repeat the parameter\n(`filter[inbox_id][]=...\u0026filter[inbox_id][]=...`) or pass a\ncomma-separated list. Omit to list every inbox in the account.\nInboxes outside the account are silently excluded. If the filter\nis present, it must contain at least one non-empty UUID.\n",
            "explode": true,
            "in": "query",
            "name": "filter[inbox_id]",
            "required": false,
            "schema": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          {
            "description": "Number of results to return. Defaults to 25; maximum is 100.",
            "in": "query",
            "name": "page[size]",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "page[after]",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Returns only threads carrying this label. Matching is exact and case-sensitive. Thread labels are independent of the labels on the thread's messages.",
            "in": "query",
            "name": "filter[label]",
            "required": false,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "created_at": "2026-07-14T10:00:00Z",
                      "id": "33333333-3333-3333-3333-333333333333",
                      "inbox_id": "11111111-1111-1111-1111-111111111111",
                      "labels": [
                        "needs_review"
                      ],
                      "last_message_at": "2026-07-15T12:30:00Z",
                      "last_message_id": "55555555-5555-5555-5555-555555555555",
                      "message_count": 2,
                      "preview": null,
                      "record_type": "email_thread",
                      "subject": "Project update",
                      "unread_count": 1,
                      "updated_at": "2026-07-15T12:30:00Z"
                    },
                    {
                      "created_at": "2026-07-15T09:00:00Z",
                      "id": "44444444-4444-4444-4444-444444444444",
                      "inbox_id": "22222222-2222-2222-2222-222222222222",
                      "labels": [],
                      "last_message_at": "2026-07-15T09:00:00Z",
                      "last_message_id": "66666666-6666-6666-6666-666666666666",
                      "message_count": 1,
                      "preview": null,
                      "record_type": "email_thread",
                      "subject": "Support request",
                      "unread_count": 0,
                      "updated_at": "2026-07-15T09:00:00Z"
                    }
                  ],
                  "meta": {
                    "page_cursor": "MjAyNi0wNy0xNVQxMjozMDowMFp8MzMzMzMzMzMtMzMzMy0zMzMzLTMzMzMtMzMzMzMzMzMzMzMz",
                    "page_size": 25
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/InboundThreadListResponse"
                }
              }
            },
            "description": "Paginated account-wide threads."
          },
          "401": {
            "$ref": "#/components/responses/email_UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/email_NotFoundResponse"
          },
          "422": {
            "$ref": "#/components/responses/ValidationErrorResponse"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10016",
                      "detail": "Email threads are temporarily unavailable. Please try again later.",
                      "title": "Service Unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "Inbound thread storage is temporarily unavailable."
          }
        },
        "summary": "List threads across every inbox in the account",
        "tags": [
          "Email Threads"
        ]
      }
    },
    "/email_threads/{thread_id}": {
      "get": {
        "description": "Returns a thread and a bounded page of its inbound and outbound messages,\ninterleaved in chronological order. The `inbox_id` returned by the list\nendpoint is required because a thread ID can occur in multiple inboxes.\nOnly messages matching that `(inbox_id, thread_id)` pair are returned. Threads outside the account\nreturn an opaque 404.\n",
        "operationId": "GetEmailThread",
        "parameters": [
          {
            "description": "Email thread UUID.",
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Inbox UUID that, together with `thread_id`, identifies the thread.",
            "in": "query",
            "name": "inbox_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Number of thread messages to return. Defaults to 25; maximum is 100.",
            "in": "query",
            "name": "page[size]",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque message cursor returned by the previous thread-detail page.",
            "in": "query",
            "name": "page[after]",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "created_at": "2026-07-15T12:30:00Z",
                    "id": "33333333-3333-3333-3333-333333333333",
                    "inbox_id": "11111111-1111-1111-1111-111111111111",
                    "labels": [
                      "needs_review"
                    ],
                    "last_message_at": "2026-07-15T12:30:00Z",
                    "last_message_id": "55555555-5555-5555-5555-555555555555",
                    "message_count": 1,
                    "messages": [
                      {
                        "attachments": [],
                        "bcc": [],
                        "cc": [],
                        "created_at": "2026-07-15T12:30:00Z",
                        "direction": "inbound",
                        "from": {
                          "email": "alice@example.com",
                          "name": "Alice"
                        },
                        "has_quoted_text": true,
                        "headers": {},
                        "html_body_url": null,
                        "id": "55555555-5555-5555-5555-555555555555",
                        "in_reply_to": null,
                        "inbox_id": "11111111-1111-1111-1111-111111111111",
                        "inline_files": [],
                        "labels": [],
                        "message_id": "\u003cmessage@example.com\u003e",
                        "read_at": null,
                        "received_at": "2026-07-15T12:30:00Z",
