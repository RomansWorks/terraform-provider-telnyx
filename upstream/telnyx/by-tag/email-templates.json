    "/email_templates/{id}/render": {
      "post": {
        "description": "Renders a template using the provided Liquid variables. Missing `template_variables` defaults to `{}`.\n\nWhen the template has `strict_variables` enabled and a required variable (per `variable_schema`) is missing, returns 422 naming the variable. When the template has `autoescape` enabled, the rendered `html_body` expression output is HTML-escaped at the output boundary; `subject` and `text_body` are not autoescaped.",
        "operationId": "RenderEmailTemplate",
        "parameters": [
          {
            "$ref": "#/components/parameters/TemplateId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "template_variables": {
                  "first_name": "Ada"
                }
              },
              "schema": {
                "$ref": "#/components/schemas/RenderEmailTemplateRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "autoescape": false,
                    "created_at": "2024-01-23T18:10:02.574Z",
                    "html_body": "string",
                    "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "name": "string",
                    "record_type": "email_template",
                    "strict_variables": false,
                    "subject": "string",
