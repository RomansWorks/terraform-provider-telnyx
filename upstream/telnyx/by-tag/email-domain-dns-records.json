{
  "components": {
    "parameters": {
      "EmailDomainDomainId": {
        "description": "Email domain UUID",
        "in": "path",
        "name": "domain_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "responses": {
      "InternalServerError": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "500",
                  "detail": "An unexpected error occurred",
                  "title": "Internal Server Error"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/DomainsErrorResponse"
            }
          }
        },
        "description": "Internal server error"
      },
      "ValidationFailed": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10015",
                  "detail": "domain is invalid",
                  "source": {
                    "pointer": "/data/attributes/domain"
                  },
                  "title": "Validation Failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/DomainsErrorResponse"
            }
          }
        },
        "description": "Validation failed"
      },
      "email_NotFound": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10001",
                  "detail": "The requested email domain was not found",
                  "title": "Not Found"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/DomainsErrorResponse"
            }
          }
        },
        "description": "Resource not found"
      }
    },
    "schemas": {
      "DKIMStatus": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "algorithm": {
            "enum": [
              "rsa-sha256",
              null
            ],
            "nullable": true,
            "type": "string"
          },
          "key_length": {
            "enum": [
              2048,
              null
            ],
            "nullable": true,
            "type": "integer"
          },
          "rotated_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "selector": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "selector",
          "algorithm",
          "key_length",
          "active",
          "rotated_at"
        ],
        "type": "object"
      },
      "DNSRecord": {
        "example": {
          "actual_value": null,
          "host": "_telnyx-email.example.com",
          "id": "123e4567-e89b-12d3-a456-426614174001",
          "priority": null,
          "purpose": "ownership",
          "record_type": "TXT",
          "required": true,
          "status": "pending",
          "value": "telnyx-domain-verification=abc123"
        },
        "properties": {
          "actual_value": {
            "nullable": true,
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "priority": {
            "nullable": true,
            "type": "integer"
          },
          "purpose": {
            "enum": [
              "ownership",
              "spf",
              "dkim",
              "dmarc",
              "mx"
            ],
            "type": "string"
          },
          "record_type": {
            "enum": [
              "TXT",
              "MX"
            ],
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pending",
              "verified",
              "failed",
              "not_required"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "purpose",
          "record_type",
          "host",
          "value",
          "required",
          "status"
        ],
        "type": "object"
      },
      "DNSRecordListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DNSRecord"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "DomainsErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/email_Error"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "DomainsTrackingSettings": {
        "properties": {
          "click_tracking": {
            "default": false,
            "description": "Rewrite HTML links through a tracking redirect to record click events.",
            "type": "boolean"
          },
          "open_tracking": {
            "default": false,
            "description": "Inject a tracking pixel into HTML messages to record open events.",
            "type": "boolean"
          },
          "unsubscribe_tracking": {
            "default": true,
            "description": "Add RFC 8058 List-Unsubscribe headers with a signed one-click unsubscribe URL. Enabled by default; Gmail/Yahoo bulk-sender rules require one-click unsubscribe support.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "EmailDMARCPolicy": {
        "description": "DMARC policy for a sending domain. Drives the recommended _dmarc.\u003cdomain\u003e TXT record. DMARC is advisory and never blocks sending. When omitted or null, the domain uses the advisory default (v=DMARC1; p=none; rua=mailto:dmarc@telnyx.com).",
        "properties": {
          "p": {
            "default": "none",
            "description": "Policy applied to messages that fail alignment.",
            "enum": [
              "none",
              "quarantine",
              "reject"
            ],
            "type": "string"
          },
          "pct": {
            "default": 100,
            "description": "Percentage of messages the policy applies to. Omitted from the record when 100.",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "rua": {
            "description": "URI for aggregate reports. Defaults to the Telnyx address when absent; null omits it.",
            "nullable": true,
            "type": "string"
          },
          "sp": {
            "description": "Policy for subdomains. Omitted from the record when null.",
            "enum": [
              "none",
              "quarantine",
              "reject"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EmailDomain": {
        "example": {
          "created_at": "2026-01-01T00:00:00Z",
          "dkim": {
            "active": false,
            "algorithm": null,
            "key_length": null,
            "rotated_at": null,
            "selector": null
          },
          "dmarc_policy": {
            "p": "none",
            "pct": 100,
            "rua": "mailto:dmarc@telnyx.com"
          },
          "dns_records": [],
          "domain": "example.com",
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "inbound": {
            "catch_all": false,
            "enabled": false,
            "mx_required": false
          },
          "record_type": "email_domain",
          "status": "pending",
          "tracking": {
            "click_tracking": false,
            "open_tracking": false,
            "unsubscribe_tracking": false
          },
          "type": "custom",
          "updated_at": "2026-01-01T00:00:00Z",
          "usable_for_inbound": false,
          "usable_for_sending": false,
          "verification": {
            "dkim": "pending",
            "dmarc": "missing_optional",
            "mx": "not_required",
            "ownership": "pending",
            "spf": "missing_optional"
          },
          "verified_at": null
        },
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "dkim": {
            "$ref": "#/components/schemas/DKIMStatus"
          },
          "dmarc_policy": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EmailDMARCPolicy"
              }
            ],
            "description": "Customer DMARC policy. null means use the advisory default (v=DMARC1; p=none; rua=mailto:dmarc@telnyx.com).\n",
            "nullable": true,
            "type": "object"
          },
          "dns_records": {
            "items": {
              "$ref": "#/components/schemas/DNSRecord"
            },
            "type": "array"
          },
          "domain": {
            "example": "example.com",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "inbound": {
            "$ref": "#/components/schemas/InboundConfig"
          },
          "record_type": {
            "enum": [
              "email_domain"
            ],
            "type": "string"
          },
          "reputation": {
            "description": "Sender reputation for this domain (present on all domain responses).",
            "properties": {
              "band": {
                "description": "Reputation band, e.g. good/warn/poor.",
                "type": "string"
              },
              "breakdown": {
                "additionalProperties": true,
                "type": "object"
              },
              "computed_at": {
                "format": "date-time",
                "nullable": true,
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/EmailDomainStatus"
          },
          "tracking": {
            "$ref": "#/components/schemas/DomainsTrackingSettings"
          },
          "type": {
            "$ref": "#/components/schemas/EmailDomainType",
            "description": "Domain type. `custom` domains are account-owned (BYOD). `shared` domains are Telnyx-managed, visible to and usable by ALL accounts for sending, but read-only: only the owning (system) account may modify, verify, or delete them; other accounts receive 403 (code 10008)."
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "usable_for_inbound": {
            "type": "boolean"
          },
          "usable_for_sending": {
            "type": "boolean"
          },
          "verification": {
            "$ref": "#/components/schemas/EmailDomainVerification"
          },
          "verified_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "record_type",
          "domain",
          "type",
          "status",
          "usable_for_sending",
          "usable_for_inbound",
          "verification",
          "dns_records",
          "dkim",
          "inbound",
          "dmarc_policy",
          "tracking",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "EmailDomainResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmailDomain"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EmailDomainStatus": {
        "enum": [
          "pending",
          "verifying",
          "verified",
          "failed",
          "degraded",
          "suspended"
        ],
        "type": "string"
      },
      "EmailDomainType": {
        "enum": [
          "custom",
          "shared",
          "shared_inbound"
        ],
        "type": "string"
      },
      "EmailDomainVerification": {
        "properties": {
          "dkim": {
            "enum": [
              "pending",
              "verified",
              "failed"
            ],
            "type": "string"
          },
          "dmarc": {
            "enum": [
              "missing_optional",
              "verified",
              "failed"
            ],
            "type": "string"
          },
          "mx": {
            "enum": [
              "not_required",
              "pending",
              "verified",
              "failed"
            ],
            "type": "string"
          },
          "ownership": {
            "enum": [
              "pending",
              "verified",
              "not_required"
            ],
            "type": "string"
          },
          "spf": {
            "enum": [
              "missing_optional",
              "verified",
              "failed",
              "not_required"
            ],
            "type": "string"
          }
        },
        "required": [
          "ownership",
          "spf",
          "dkim",
          "dmarc",
          "mx"
        ],
        "type": "object"
      },
      "InboundConfig": {
        "properties": {
          "catch_all": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "mx_required": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "catch_all",
          "mx_required"
        ],
        "type": "object"
      },
      "email_Error": {
        "properties": {
          "code": {
            "enum": [
              "10001",
              "10015",
              "500",
              "10007",
              "10008",
              "10020",
              "40901"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "properties": {
              "pointer": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/email_domains/{domain_id}/dns_records": {
      "get": {
        "description": "Returns the DNS records Telnyx generated for domain ownership and DKIM verification, plus MX records when inbound delivery is enabled.",
        "operationId": "listEmailDomainDnsRecords",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainDomainId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DNSRecordListResponse"
                }
              }
            },
            "description": "DNS records for the email domain"
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "List DNS records for an email domain",
        "tags": [
          "Email Domain DNS Records"
        ]
      }
    },
    "/email_domains/{domain_id}/verify": {
      "post": {
        "description": "Checks the published DNS records against the records required for the email domain and returns the latest verification results.",
        "operationId": "verifyEmailDomainDnsRecords",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainDomainId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainResponse"
                }
              }
            },
            "description": "Updated email domain with latest DNS verification results"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainsErrorResponse"
                }
              }
            },
            "description": "Forbidden — shared domains are read-only for non-owner accounts (error code 10008)."
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Verify DNS records for an email domain",
        "tags": [
          "Email Domain DNS Records"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
