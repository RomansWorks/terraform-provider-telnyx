{
  "components": {
    "schemas": {
      "ForgetSourceResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ForgottenSource"
          }
        },
        "required": [
          "data"
        ],
        "title": "ForgetSourceResponse",
        "type": "object"
      },
      "ForgottenSource": {
        "properties": {
          "memories_deleted": {
            "description": "Memories the profile held and no longer does, counted before and after across the whole profile: it includes memories derived from this source together with others, and anything else the profile lost in between. A report rather than an audit. The status carries the outcome.",
            "title": "Memories Deleted",
            "type": "integer"
          },
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "source_id": {
            "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "profile_id",
          "source_id",
          "memories_deleted"
        ],
        "title": "ForgottenSource",
        "type": "object"
      },
      "PageMeta": {
        "description": "Where a listing's page sits in the whole.\n\nA page is a snapshot: the counts it reports and the order it is drawn in\nboth move as writes land, so paging through a busy namespace can repeat or\nmiss an entry at a page boundary.",
        "properties": {
          "page_number": {
            "description": "The page returned, counting from 1.",
            "title": "Page Number",
            "type": "integer"
          },
          "page_size": {
            "description": "How many results a page holds.",
            "title": "Page Size",
            "type": "integer"
          },
          "total_pages": {
            "description": "Pages that can be requested; 0 when nothing matched. Page until `page_number` reaches it rather than until a page comes back short: a page can hold fewer than `page_size` results without being the last. Capped at the deepest page served, so on a very large listing it covers fewer results than `total_results`.",
            "title": "Total Pages",
            "type": "integer"
          },
          "total_results": {
            "description": "Results the request matched, including any past the deepest page.",
            "title": "Total Results",
            "type": "integer"
          }
        },
        "required": [
          "page_number",
          "page_size",
          "total_pages",
          "total_results"
        ],
        "title": "PageMeta",
        "type": "object"
      },
      "Source": {
        "properties": {
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the source was first stored.",
            "title": "Created At"
          },
          "id": {
            "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
            "title": "Id",
            "type": "string"
          },
          "memory_count": {
            "description": "Memories extracted from this source. A memory derived from several sources is not counted here.",
            "title": "Memory Count",
            "type": "integer"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The session this source was ingested as. Null for a remembered fact.",
            "title": "Session Id"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the source was last written; re-ingesting moves it.",
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "session_id",
          "memory_count"
        ],
        "title": "Source",
        "type": "object"
      },
