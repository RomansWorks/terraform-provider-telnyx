{
  "components": {
    "schemas": {
      "AgentGatewayAwsSigV4Auth": {
        "description": "The gateway signs each request with AWS Signature Version 4. Without keys or a role, it uses the instance's own AWS identity. Keys are write-only.",
        "properties": {
          "access_key_id": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          },
          "region": {
            "description": "The AWS region to sign for.",
            "type": "string"
          },
          "role_name": {
            "description": "The ARN of a role for the gateway to assume.",
            "type": [
              "string",
              "null"
            ]
          },
          "secret_access_key": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          },
          "service": {
            "default": "bedrock-agentcore",
            "description": "The AWS service to sign for.",
            "type": "string"
          },
          "session_token": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          },
          "type": {
            "const": "aws_sigv4",
            "type": "string"
          }
        },
        "required": [
          "type",
          "region"
        ],
        "title": "AWS Signature Version 4",
        "type": "object"
      },
      "AgentGatewayMcpServer": {
        "properties": {
          "auth": {
            "$ref": "#/components/schemas/AgentGatewayShownAuth"
          },
          "created_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "forwarded_headers": {
            "description": "Headers copied from the agent's request, by name.",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "id": {
            "description": "Identifies the server.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "description": "A name for the server, unique on the instance across MCP servers and APIs, regardless of case. Letters, digits, `_`, and `.`. The gateway prefixes the server's tools with it and a hyphen.",
            "type": "string"
          },
          "open_to_every_key": {
            "default": false,
            "description": "`true` lets every key on the instance use the server, granted or not.",
            "type": "boolean"
          },
          "static_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers sent on every request.",
            "type": "object"
          },
          "tools": {
            "description": "The tools the server exposes to every key, by name. `[]` exposes every tool.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "transport": {
            "description": "`http` for Streamable HTTP, or `sse` for Server-Sent Events.",
            "enum": [
              "http",
              "sse"
            ],
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "description": "The server's MCP endpoint.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "transport",
          "auth",
          "tools",
          "static_headers",
          "forwarded_headers",
          "open_to_every_key",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "AgentGatewayMcpServerCreate": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "description": "How the gateway authenticates to the server. Replaced whole on an update; `{\"type\": \"none\"}` removes the credential.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentGatewayNoAuth"
              },
              {
                "$ref": "#/components/schemas/AgentGatewayStaticAuth"
              },
              {
                "$ref": "#/components/schemas/AgentGatewayOAuthClientCredentials"
              },
              {
                "$ref": "#/components/schemas/AgentGatewayPassthroughAuth"
              },
              {
                "$ref": "#/components/schemas/AgentGatewayAwsSigV4Auth"
              }
            ]
          },
          "forwarded_headers": {
            "description": "Headers copied from the agent's request, by name.",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "name": {
            "description": "A name for the server, unique on the instance across MCP servers and APIs, regardless of case. Up to 100 letters, digits, `_`, and `.`. The gateway prefixes the server's tools with it and a hyphen.",
            "pattern": "^[A-Za-z0-9_.]{1,100}$",
            "type": "string"
          },
          "open_to_every_key": {
            "default": false,
            "description": "`true` lets every key on the instance use the server, granted or not.",
            "type": "boolean"
          },
          "static_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers sent on every request.",
            "type": "object"
          },
          "tools": {
            "description": "The tools the server exposes to every key, by name. `[]` exposes every tool.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "transport": {
            "default": "http",
            "description": "`http` for Streamable HTTP, or `sse` for Server-Sent Events.",
            "enum": [
              "http",
              "sse"
            ],
            "type": "string"
          },
          "url": {
            "description": "The server's MCP endpoint, `http` or `https`.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "type": "object"
      },
