                  "transaction"
                ],
                "type": "string"
              },
              "transaction_processing_type": {
                "enum": [
                  "stored_payment"
                ],
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "stored-payment-transactions_ErrorResponse": {
        "properties": {
