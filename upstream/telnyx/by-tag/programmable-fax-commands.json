          "monochrome": {
            "$ref": "#/components/schemas/Monochrome"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "store_media": {
            "$ref": "#/components/schemas/StoreMedia"
          },
          "store_preview": {
            "$ref": "#/components/schemas/StorePreview"
          },
          "t38_enabled": {
            "$ref": "#/components/schemas/T38Enabled"
          },
          "to": {
