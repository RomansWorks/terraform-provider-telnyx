 "components": {
  "responses": {
   "Widget": {
    "description": "ok",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "data": {
         "$ref": "#/components/schemas/Widget"
        }
       }
      }
     }
    }
   }
  },
  "schemas": {
   "WidgetCreate": {
    "type": "object",
    "required": [
     "name"
    ],
    "properties": {
     "name": {
      "type": "string",
      "description": "The   widget's\nname."
     },
     "color": {
      "type": "string",
      "enum": [
       "red",
       "blue"
      ]
     },
     "size": {
      "type": [
       "integer",
       "null"
      ]
     },
     "region": {
      "type": "string",
      "description": "Where it lives; cannot change."
     },
     "secret": {
      "type": "string",
      "writeOnly": true
     },
     "labels": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "tools": {
      "type": "array",
      "items": {
       "oneOf": [
        {
         "$ref": "#/components/schemas/WebhookTool"
        },
        {
         "$ref": "#/components/schemas/HangupTool"
        }
       ]
      }
     },
     "target": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       }
      ]
     },
     "avatar": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Avatar"
       },
       {
        "type": "null"
       }
      ]
     },
     "deep": {
      "$ref": "#/components/schemas/Level1"
     },
     "matrix": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       }
      }
     },
     "old_flag": {
      "type": "boolean",
      "deprecated": true
     },
     "count": {
      "type": "integer"
     }
    }
   },
   "WidgetUpdate": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "color": {
      "type": "string",
      "enum": [
       "red",
       "blue",
       "green"
      ]
     },
     "size": {
      "type": [
       "integer",
       "null"
      ]
     },
     "secret": {
      "type": "string",
      "writeOnly": true
     },
     "labels": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     },
     "tools": {
      "type": "array",
      "items": {
       "oneOf": [
        {
         "$ref": "#/components/schemas/WebhookTool"
        },
        {
         "$ref": "#/components/schemas/HangupTool"
        }
       ]
      }
     },
     "target": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       }
      ]
     },
     "avatar": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Avatar"
       },
       {
        "type": "null"
       }
      ]
     },
     "deep": {
      "$ref": "#/components/schemas/Level1"
     },
     "matrix": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "number"
       }
      }
     },
     "old_flag": {
      "type": "boolean",
      "deprecated": true
     },
     "count": {
      "type": "integer"
     },
     "publish": {
      "type": "boolean",
      "description": "Publish after saving."
     }
    }
   },
   "Widget": {
    "allOf": [
     {
      "$ref": "#/components/schemas/WidgetCreate"
     },
     {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "readOnly": true
       },
       "created_at": {
        "type": "string",
        "format": "date-time"
       },
       "status": {
        "type": "string",
        "enum": [
         "pending",
         "ready"
        ]
       }
      }
     }
    ]
   },
   "WebhookTool": {
    "type": "object",
    "required": [
     "type",
     "webhook"
    ],
    "properties": {
     "type": {
      "type": "string",
      "enum": [
       "webhook"
      ]
     },
     "webhook": {
      "type": "object",
      "properties": {
       "url": {
        "type": "string"
       }
      }
     }
    }
   },
   "HangupTool": {
    "type": "object",
    "required": [
     "type"
    ],
    "properties": {
     "type": {
      "type": "string",
      "const": "hangup"
     },
     "hangup": {
      "type": "object",
      "additionalProperties": true
     }
    }
   },
   "Avatar": {
    "type": "object",
    "properties": {
     "avatar_id": {
      "type": "string"
     }
    }
   },
   "Level1": {
    "type": "object",
    "properties": {
     "level2": {
      "type": "object",
      "properties": {
       "level3": {
        "type": "object",
        "properties": {
         "level4": {
          "type": "object",
          "properties": {
           "leaf": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "Note": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "count": {
      "type": "integer"
     },
     "created_at": {
      "type": "string"
     }
    }
   },
   "GadgetCreate": {
    "type": "object",
    "required": [
     "name"
    ],
    "properties": {
     "name": {
      "type": "string",
      "description": "The gadget's name."
     }
    }
   },
   "Gadget": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "on",
       "off"
      ]
     },
     "blocklist_id": {
      "type": [
       "string",
       "null"
      ],
      "description": "The blocklist applied to the gadget."
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "Secret": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "value": {
      "type": "string",
      "writeOnly": true
     }
    }
   }
  }
 }
}
