{
  "openapi": "3.1.0",
  "info": {"title": "Codegen fixture", "version": "1"},
  "paths": {
    "/widgets": {
      "post": {
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/WidgetCreate"}}}},
        "responses": {"200": {"$ref": "#/components/responses/Widget"}}
      }
    },
    "/widgets/{widget_id}": {
      "get": {"responses": {"200": {"$ref": "#/components/responses/Widget"}}},
      "patch": {
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/WidgetUpdate"}}}},
        "responses": {"200": {"$ref": "#/components/responses/Widget"}}
      },
      "delete": {"responses": {"204": {"description": "deleted"}}}
    },
    "/folders/{folder_id}/notes": {
      "post": {
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}, "count": {"type": "integer"}}}}}},
        "responses": {"201": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}}
      }
    },
    "/folders/{folder_id}/notes/{note_id}": {
      "get": {"responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}}},
      "put": {
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}},
        "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}}
      }
    }
  },
  "components": {
    "responses": {
      "Widget": {"description": "ok", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Widget"}}}}}}
    },
    "schemas": {
      "WidgetCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "description": "The   widget's\nname."},
          "color": {"type": "string", "enum": ["red", "blue"]},
          "size": {"type": ["integer", "null"]},
          "region": {"type": "string", "description": "Where it lives; cannot change."},
          "secret": {"type": "string", "writeOnly": true},
          "labels": {"type": "object", "additionalProperties": {"type": "string"}},
          "tools": {"type": "array", "items": {"oneOf": [{"$ref": "#/components/schemas/WebhookTool"}, {"$ref": "#/components/schemas/HangupTool"}]}},
          "target": {"anyOf": [{"type": "string"}, {"type": "integer"}]},
          "avatar": {"anyOf": [{"$ref": "#/components/schemas/Avatar"}, {"type": "null"}]},
          "deep": {"$ref": "#/components/schemas/Level1"},
          "matrix": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
          "old_flag": {"type": "boolean", "deprecated": true},
          "count": {"type": "integer"}
        }
      },
      "WidgetUpdate": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "color": {"type": "string", "enum": ["red", "blue", "green"]},
          "size": {"type": ["integer", "null"]},
          "secret": {"type": "string", "writeOnly": true},
          "labels": {"type": "object", "additionalProperties": {"type": "string"}},
          "tools": {"type": "array", "items": {"oneOf": [{"$ref": "#/components/schemas/WebhookTool"}, {"$ref": "#/components/schemas/HangupTool"}]}},
          "target": {"anyOf": [{"type": "string"}, {"type": "integer"}]},
          "avatar": {"anyOf": [{"$ref": "#/components/schemas/Avatar"}, {"type": "null"}]},
          "deep": {"$ref": "#/components/schemas/Level1"},
          "matrix": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
          "old_flag": {"type": "boolean", "deprecated": true},
          "count": {"type": "integer"},
          "publish": {"type": "boolean", "description": "Publish after saving."}
        }
      },
      "Widget": {
        "allOf": [
          {"$ref": "#/components/schemas/WidgetCreate"},
          {"type": "object", "properties": {
            "id": {"type": "string", "readOnly": true},
            "created_at": {"type": "string", "format": "date-time"},
            "status": {"type": "string", "enum": ["pending", "ready"]}
          }}
        ]
      },
      "WebhookTool": {"type": "object", "required": ["type", "webhook"], "properties": {"type": {"type": "string", "enum": ["webhook"]}, "webhook": {"type": "object", "properties": {"url": {"type": "string"}}}}},
      "HangupTool": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "const": "hangup"}, "hangup": {"type": "object", "additionalProperties": true}}},
      "Avatar": {"type": "object", "properties": {"avatar_id": {"type": "string"}}},
      "Level1": {"type": "object", "properties": {"level2": {"type": "object", "properties": {"level3": {"type": "object", "properties": {"level4": {"type": "object", "properties": {"leaf": {"type": "string"}}}}}}}}},
      "Note": {"type": "object", "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "count": {"type": "integer"}, "created_at": {"type": "string"}}}
    }
  }
}
