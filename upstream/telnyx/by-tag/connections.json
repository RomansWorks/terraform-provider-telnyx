      "ConnectionsCount": {
        "properties": {
          "counts": {
            "description": "Counts of the authenticated user's connections, grouped by connection type. Forward-only connections are excluded.",
            "properties": {
              "call_control_applications": {
                "description": "Number of Call Control applications.",
                "type": "integer"
              },
              "credential_connections": {
                "description": "Number of credential connections.",
                "type": "integer"
              },
              "external_connections": {
                "description": "Number of external connections.",
                "type": "integer"
              },
              "fax_connections": {
                "description": "Number of Fax applications.",
                "type": "integer"
              },
              "fqdn_connections": {
                "description": "Number of FQDN connections.",
                "type": "integer"
              },
              "ip_connections": {
                "description": "Number of IP connections.",
                "type": "integer"
              },
              "microsoft_teams_sbc_connections": {
                "description": "Number of Microsoft Teams SBC (direct routing) connections.",
                "type": "integer"
              },
              "mobile_voice_connections": {
                "description": "Number of mobile voice (IMS) connections.",
                "type": "integer"
              },
              "operator_connect_connections": {
                "description": "Number of Microsoft Operator Connect connections.",
                "type": "integer"
              },
              "texml_applications": {
                "description": "Number of TeXML applications.",
                "type": "integer"
              },
              "third_party_provider_connections": {
                "description": "Number of third-party provider connections.",
                "type": "integer"
              },
              "uac_connections": {
                "description": "Number of UAC connections.",
                "type": "integer"
              },
              "zoom_sbc_connections": {
                "description": "Number of Zoom SBC connections.",
                "type": "integer"
              }
            },
            "required": [
              "ip_connections",
              "credential_connections",
              "uac_connections",
              "fqdn_connections",
              "call_control_applications",
              "texml_applications",
              "third_party_provider_connections",
              "external_connections",
              "fax_connections",
              "mobile_voice_connections",
              "microsoft_teams_sbc_connections",
              "zoom_sbc_connections",
              "operator_connect_connections"
            ],
            "type": "object"
          },
          "limits": {
            "description": "Connection limits that apply to the user. Contains a single global_limit when a global connection limit applies, or per-type limits (standard_limit, texml_limit and uac_limit) when the user has per-type connection count capabilities.",
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "global_limit": {
                    "description": "Maximum total number of connections allowed, when a global limit applies.",
                    "example": 10000,
                    "type": "integer"
                  }
                },
                "required": [
                  "global_limit"
                ],
                "title": "Global Connection Limit",
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "standard_limit": {
                    "description": "Maximum number of standard connections allowed, when per-type limits apply.",
                    "type": "integer"
                  },
                  "texml_limit": {
                    "description": "Maximum number of TeXML applications allowed, when per-type limits apply.",
                    "type": "integer"
                  },
                  "uac_limit": {
                    "description": "Maximum number of UAC connections allowed, when per-type limits apply.",
                    "type": "integer"
                  }
                },
                "required": [
                  "standard_limit",
                  "texml_limit",
                  "uac_limit"
                ],
                "title": "Per-type Connection Limits",
                "type": "object"
              }
            ],
            "type": "object"
          },
          "record_type": {
            "description": "Identifies the type of the resource.",
            "example": "connections_count",
            "type": "string"
          }
        },
        "required": [
          "record_type",
          "counts",
          "limits"
        ],
        "title": "Connections Count",
        "type": "object"
      },
