{
  "components": {
    "parameters": {
      "DomainsPageSize": {
        "description": "Number of records per page",
        "in": "query",
        "name": "page[size]",
        "required": false,
        "schema": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "EmailDomainDomainId": {
        "description": "Email domain UUID",
        "in": "path",
        "name": "domain_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "EmailDomainId": {
        "description": "Email domain UUID",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "PageAfter": {
        "description": "Cursor for records after the provided value (cursor pagination)",
        "in": "query",
        "name": "page[after]",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "PageBefore": {
        "description": "Cursor for records before the provided value (cursor pagination)",
        "in": "query",
        "name": "page[before]",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "email_PageNumber": {
        "description": "Page number to return (offset pagination)",
        "in": "query",
        "name": "page[number]",
        "required": false,
        "schema": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "InternalServerError": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "500",
                  "detail": "An unexpected error occurred",
                  "title": "Internal Server Error"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/DomainsErrorResponse"
            }
          }
        },
        "description": "Internal server error"
      },
      "ValidationFailed": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10015",
                  "detail": "domain is invalid",
                  "source": {
                    "pointer": "/data/attributes/domain"
                  },
                  "title": "Validation Failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/DomainsErrorResponse"
            }
          }
        },
        "description": "Validation failed"
      },
      "email_NotFound": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10001",
                  "detail": "The requested email domain was not found",
                  "title": "Not Found"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/DomainsErrorResponse"
            }
          }
        },
        "description": "Resource not found"
      }
    },
    "schemas": {
      "CreateEmailDomainRequest": {
        "properties": {
          "dmarc_policy": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EmailDMARCPolicy"
              }
            ],
            "description": "DMARC policy. Omit/null for the advisory default (v=DMARC1; p=none; rua=mailto:dmarc@telnyx.com).\n",
            "nullable": true,
            "type": "object"
          },
          "domain": {
            "example": "example.com",
            "type": "string"
          },
          "inbound_enabled": {
            "default": false,
            "description": "Enable inbound routing for this domain",
            "type": "boolean"
          },
          "tracking": {
            "$ref": "#/components/schemas/DomainsTrackingSettings"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "DKIMStatus": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "algorithm": {
            "enum": [
              "rsa-sha256",
              null
            ],
            "nullable": true,
            "type": "string"
          },
          "key_length": {
            "enum": [
              2048,
              null
            ],
            "nullable": true,
            "type": "integer"
          },
          "rotated_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "selector": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "selector",
          "algorithm",
          "key_length",
          "active",
          "rotated_at"
        ],
        "type": "object"
      },
      "DNSRecord": {
        "example": {
          "actual_value": null,
          "host": "_telnyx-email.example.com",
          "id": "123e4567-e89b-12d3-a456-426614174001",
          "priority": null,
          "purpose": "ownership",
          "record_type": "TXT",
          "required": true,
          "status": "pending",
          "value": "telnyx-domain-verification=abc123"
        },
        "properties": {
          "actual_value": {
            "nullable": true,
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "priority": {
            "nullable": true,
            "type": "integer"
          },
          "purpose": {
            "enum": [
              "ownership",
              "spf",
              "dkim",
              "dmarc",
              "mx"
            ],
            "type": "string"
          },
          "record_type": {
            "enum": [
              "TXT",
              "MX"
            ],
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pending",
              "verified",
              "failed",
              "not_required"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "purpose",
          "record_type",
          "host",
          "value",
          "required",
          "status"
        ],
        "type": "object"
      },
      "DomainsErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/email_Error"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "DomainsTrackingSettings": {
        "properties": {
          "click_tracking": {
            "default": false,
            "description": "Rewrite HTML links through a tracking redirect to record click events.",
            "type": "boolean"
          },
          "open_tracking": {
            "default": false,
            "description": "Inject a tracking pixel into HTML messages to record open events.",
            "type": "boolean"
          },
          "unsubscribe_tracking": {
            "default": true,
            "description": "Add RFC 8058 List-Unsubscribe headers with a signed one-click unsubscribe URL. Enabled by default; Gmail/Yahoo bulk-sender rules require one-click unsubscribe support.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "EmailDMARCPolicy": {
        "description": "DMARC policy for a sending domain. Drives the recommended _dmarc.\u003cdomain\u003e TXT record. DMARC is advisory and never blocks sending. When omitted or null, the domain uses the advisory default (v=DMARC1; p=none; rua=mailto:dmarc@telnyx.com).",
        "properties": {
          "p": {
            "default": "none",
            "description": "Policy applied to messages that fail alignment.",
            "enum": [
              "none",
              "quarantine",
              "reject"
            ],
            "type": "string"
          },
          "pct": {
            "default": 100,
            "description": "Percentage of messages the policy applies to. Omitted from the record when 100.",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "rua": {
            "description": "URI for aggregate reports. Defaults to the Telnyx address when absent; null omits it.",
            "nullable": true,
            "type": "string"
          },
          "sp": {
            "description": "Policy for subdomains. Omitted from the record when null.",
            "enum": [
              "none",
              "quarantine",
              "reject"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "EmailDomain": {
        "example": {
          "created_at": "2026-01-01T00:00:00Z",
          "dkim": {
            "active": false,
            "algorithm": null,
            "key_length": null,
            "rotated_at": null,
            "selector": null
          },
          "dmarc_policy": {
            "p": "none",
            "pct": 100,
            "rua": "mailto:dmarc@telnyx.com"
          },
          "dns_records": [],
          "domain": "example.com",
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "inbound": {
            "catch_all": false,
            "enabled": false,
            "mx_required": false
          },
          "record_type": "email_domain",
          "status": "pending",
          "tracking": {
            "click_tracking": false,
            "open_tracking": false,
            "unsubscribe_tracking": false
          },
          "type": "custom",
          "updated_at": "2026-01-01T00:00:00Z",
          "usable_for_inbound": false,
          "usable_for_sending": false,
          "verification": {
            "dkim": "pending",
            "dmarc": "missing_optional",
            "mx": "not_required",
            "ownership": "pending",
            "spf": "missing_optional"
          },
          "verified_at": null
        },
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "dkim": {
            "$ref": "#/components/schemas/DKIMStatus"
          },
          "dmarc_policy": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EmailDMARCPolicy"
              }
            ],
            "description": "Customer DMARC policy. null means use the advisory default (v=DMARC1; p=none; rua=mailto:dmarc@telnyx.com).\n",
            "nullable": true,
            "type": "object"
          },
          "dns_records": {
            "items": {
              "$ref": "#/components/schemas/DNSRecord"
            },
            "type": "array"
          },
          "domain": {
            "example": "example.com",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "inbound": {
            "$ref": "#/components/schemas/InboundConfig"
          },
          "record_type": {
            "enum": [
              "email_domain"
            ],
            "type": "string"
          },
          "reputation": {
            "description": "Sender reputation for this domain (present on all domain responses).",
            "properties": {
              "band": {
                "description": "Reputation band, e.g. good/warn/poor.",
                "type": "string"
              },
              "breakdown": {
                "additionalProperties": true,
                "type": "object"
              },
              "computed_at": {
                "format": "date-time",
                "nullable": true,
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/EmailDomainStatus"
          },
          "tracking": {
            "$ref": "#/components/schemas/DomainsTrackingSettings"
          },
          "type": {
            "$ref": "#/components/schemas/EmailDomainType",
            "description": "Domain type. `custom` domains are account-owned (BYOD). `shared` domains are Telnyx-managed, visible to and usable by ALL accounts for sending, but read-only: only the owning (system) account may modify, verify, or delete them; other accounts receive 403 (code 10008)."
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "usable_for_inbound": {
            "type": "boolean"
          },
          "usable_for_sending": {
            "type": "boolean"
          },
          "verification": {
            "$ref": "#/components/schemas/EmailDomainVerification"
          },
          "verified_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "record_type",
          "domain",
          "type",
          "status",
          "usable_for_sending",
          "usable_for_inbound",
          "verification",
          "dns_records",
          "dkim",
          "inbound",
          "dmarc_policy",
          "tracking",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "EmailDomainDKIMRotation": {
        "description": "Result of rotating a domain's DKIM key. The new key is active and signing switches to it immediately; the previous key is retired to a `retiring` state (retained, not revoked) so it can be revoked after the DNS propagation grace period. Selectors are fixed, so the DKIM DNS record's TXT value is replaced in place at the shared `\u003cselector\u003e._domainkey.\u003cdomain\u003e` host — `old_selector_retained` is false and the returned dns_records carry the new value the customer must publish promptly.\n",
        "example": {
          "dkim": {
            "activated_at": "2026-09-11T12:00:00Z",
            "algorithm": "rsa-sha256",
            "id": "123e4567-e89b-12d3-a456-42661417400a",
            "key_length": 2048,
            "selector": "telnyx1",
            "status": "active",
            "version": 2
          },
          "dns_records": [
            {
              "actual_value": null,
              "host": "telnyx1._domainkey.example.com",
              "id": "123e4567-e89b-12d3-a456-42661417400b",
              "priority": null,
              "purpose": "dkim",
              "record_type": "TXT",
              "required": true,
              "status": "pending",
              "value": "v=DKIM1; k=rsa; p=MIIBIjANBgkqh..."
            }
          ],
          "domain": "example.com",
          "domain_id": "123e4567-e89b-12d3-a456-426614174002",
          "old_selector_retained": false,
          "previous_dkim_key": {
            "id": "123e4567-e89b-12d3-a456-426614174009",
            "selector": "telnyx1",
            "status": "retiring",
            "version": 1
          },
          "record_type": "email_domain_dkim_rotation"
        },
        "properties": {
          "dkim": {
            "description": "The new active DKIM key.",
            "properties": {
              "activated_at": {
                "format": "date-time",
                "nullable": true,
                "type": "string"
              },
              "algorithm": {
                "enum": [
                  "rsa-sha256"
                ],
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "key_length": {
                "enum": [
                  2048
                ],
                "type": "integer"
              },
              "selector": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "active"
                ],
                "type": "string"
              },
              "version": {
                "description": "Monotonically increasing per-domain key version.",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "selector",
              "algorithm",
              "key_length",
              "version",
              "status"
            ],
            "type": "object"
          },
          "dns_records": {
            "description": "The DKIM DNS records the customer must publish, carrying the new key's TXT value with verification reset to pending.\n",
            "items": {
              "$ref": "#/components/schemas/DNSRecord"
            },
            "type": "array"
          },
          "domain": {
            "type": "string"
          },
          "domain_id": {
            "format": "uuid",
            "type": "string"
          },
          "old_selector_retained": {
            "description": "False for this service: one selector is fixed per domain, so rotation replaces the TXT value at the existing _domainkey host. There is no dual-selector overlap; publish the replacement TXT promptly because signing switches immediately.",
            "type": "boolean"
          },
          "previous_dkim_key": {
            "description": "The retired previous key, or null when the domain had no active key before rotation. Retained in a `retiring` state so it can be revoked after the DNS propagation grace period.\n",
            "nullable": true,
            "properties": {
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "selector": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "retiring",
                  "revoked"
                ],
                "type": "string"
              },
              "version": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "selector",
              "version",
              "status"
            ],
            "type": "object"
          },
          "record_type": {
            "enum": [
              "email_domain_dkim_rotation"
            ],
            "type": "string"
          }
        },
        "required": [
          "record_type",
          "domain_id",
          "domain",
          "dkim",
          "previous_dkim_key",
          "old_selector_retained",
          "dns_records"
        ],
        "type": "object"
      },
      "EmailDomainDKIMRotationResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmailDomainDKIMRotation"
          }
        },
        "required": [
          "data"
