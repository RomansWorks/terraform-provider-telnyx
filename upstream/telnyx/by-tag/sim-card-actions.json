                "description": "JSON pointer (RFC6901) to the offending entity.",
                "format": "json-pointer",
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title"
