  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/sources": {
      "get": {
        "description": "Everything a profile has stored and extracts memories from: each ingested session, and each remembered fact, which has no session. Content is not listed; read one source for it. A source whose ingest is still queued is not here yet. Re-ingesting a session moves it to the front, so a listing paged while sessions are written can repeat or miss one at a page boundary. A `session_id` narrows the listing to the source that session was stored as: one source or none, and none -- an empty page, not a 404 -- for a session never ingested, still queued, or another profile's.",
        "operationId": "ListMemorySources",
        "parameters": [
          {
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "description": "An ingested session, by the `session_id` it was ingested with. Narrows the request to the source that session was stored as.",
            "in": "query",
            "name": "session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          },
          {
            "description": "The page to return, counting from 1. Bounded in depth: (page[number] - 1) * page[size] may be at most 10000.",
            "in": "query",
            "name": "page[number]",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 10001,
              "minimum": 1,
              "title": "Number",
              "type": "integer"
            }
          },
          {
            "description": "How many results a page holds.",
            "in": "query",
            "name": "page[size]",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "created_at": "2026-08-26T21:14:11Z",
                      "id": "b1e6c0a2-4f3d-4a2e-9c7b-8e1f2a3b4c5d",
                      "memory_count": 3,
                      "session_id": "conv_8901",
                      "updated_at": "2026-08-26T21:14:11Z"
                    },
                    {
                      "created_at": "2026-08-25T09:02:44Z",
                      "id": "9af23d17-2b6c-4d8e-a1f0-3c4b5d6e7f80",
                      "memory_count": 1,
                      "session_id": null,
                      "updated_at": "2026-08-25T09:02:44Z"
                    }
                  ],
                  "meta": {
                    "page_number": 1,
                    "page_size": 20,
                    "total_pages": 1,
                    "total_results": 2
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/SourceListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "Could not find any usable credentials in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "source": {
                        "pointer": "/"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "namespace_not_found",
                      "detail": "no such namespace"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The namespace does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "invalid_request",
                      "detail": "limit is no longer supported: page with page[number] and page[size] instead"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "upstream_error",
                      "detail": "the memory dataplane is unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Upstream error"
          }
        },
        "summary": "List a profile's sources, most recently written first",
        "tags": [
          "Sources"
        ]
      }
    },
    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/sources/{source_id}": {
      "delete": {
        "description": "Deletes one source -- an ingested session or a remembered fact -- together with the memories derived from it. A memory derived from this source and others is deleted too, and derived again from what remains in the background. It answers only once the source is gone. A source that is not there -- never stored, another profile's, or already deleted -- answers 404, so on a `502` or a `504` repeat the identical request and read a 404 as done. An ingest of the same session that is still queued is not cancelled, and stores the session again when it runs. Nothing here can be undone.",
        "operationId": "ForgetSource",
        "parameters": [
          {
            "description": "The namespace. `default` exists for every organization.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "description": "The namespace. `default` exists for every organization.",
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "description": "The profile: your identifier for the user, caller or agent this memory is about.",
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "description": "The profile: your identifier for the user, caller or agent this memory is about.",
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "memories_deleted": 3,
                    "profile_id": "caller:+13128675309",
                    "source_id": "b1e6c0a2-4f3d-4a2e-9c7b-8e1f2a3b4c5d"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ForgetSourceResponse"
                }
              }
            },
            "description": "The source and its memories are gone"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "Could not find any usable credentials in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "source": {
                        "pointer": "/"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "source_not_found",
                      "detail": "no such source"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The source does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "invalid_request",
                      "detail": "source id must be a UUID"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "upstream_error",
                      "detail": "the memory dataplane is unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Upstream error"
          }
        },
        "summary": "Forget one source",
        "tags": [
          "Sources"
        ]
      },
      "get": {
        "description": "One source and its content, as it was stored: an ingested session's payload or a remembered fact. A source whose ingest is still queued answers 404 until it has been stored.",
        "operationId": "GetMemorySource",
        "parameters": [
          {
            "description": "The namespace. `default` exists for every organization.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "description": "The namespace. `default` exists for every organization.",
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "description": "The profile: your identifier for the user, caller or agent this memory is about.",
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "description": "The profile: your identifier for the user, caller or agent this memory is about.",
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "content": {
                      "messages": [
                        {
                          "content": "invoices go to 220 W Chicago Ave now",
                          "role": "user"
                        }
                      ]
                    },
                    "created_at": "2026-08-26T21:14:11Z",
                    "id": "b1e6c0a2-4f3d-4a2e-9c7b-8e1f2a3b4c5d",
                    "memory_count": 3,
                    "session_id": "conv_8901",
                    "updated_at": "2026-08-26T21:14:11Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/SourceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "Could not find any usable credentials in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "source": {
                        "pointer": "/"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "source_not_found",
                      "detail": "no such source"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The source does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "invalid_request",
                      "detail": "source id must be a UUID"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "upstream_error",
                      "detail": "the memory dataplane is unavailable"
                    }
                  ]
