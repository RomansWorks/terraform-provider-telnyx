    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/summary": {
      "get": {
        "description": "The whole profile as one card, precomputed, with no query. Built for the start of a session, where there is no question to ask yet.\n\nA summary is generated in the background. `is_stale` tells you newer memories have arrived since it was written; that is ordinary and the card is still usable.",
        "operationId": "GetProfileSummary",
        "parameters": [
