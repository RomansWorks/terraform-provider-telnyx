                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ValidateAddressField": {
        "properties": {
          "administrative_area": {
            "$ref": "#/components/schemas/administrative_area"
          },
          "borough": {
            "$ref": "#/components/schemas/borough"
          },
