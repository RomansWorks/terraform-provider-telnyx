                }
              },
              "invalid_parameter_type": {
                "summary": "Invalid parameter type",
                "value": {
                  "errors": [
                    {
                      "code": "10026",
                      "detail": "The 'To' parameter must be of type 'string'",
                      "source": {
                        "pointer": "/To"
                      },
                      "title": "Invalid parameter type"
                    }
                  ]
                }
              },
              "invalid_send_digits": {
                "summary": "Invalid SendDigits format",
                "value": {
                  "errors": [
                    {
                      "code": "90014",
