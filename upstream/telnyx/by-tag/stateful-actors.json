{
  "components": {
    "schemas": {
      "ActorClusterResult": {
        "properties": {
          "cluster_id": {
            "description": "Public region, or unknown when no mapping exists",
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ActorPlacement": {
        "description": "Last deployment fan-out report, not a live probe. Omitted on actor types without a placement-aware deployment.",
        "properties": {
          "cluster_results": {
            "items": {
              "$ref": "#/components/schemas/ActorClusterResult"
            },
            "type": "array"
          },
          "clusters": {
            "description": "Public regions with successful deployment",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "excluded_clusters": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "observed_at": {
            "description": "Optional ISO-8601 millisecond timestamp",
            "type": "string"
          },
          "partial": {
            "type": "boolean"
          },
          "policy": {
            "enum": [
              "everywhere",
              "single_site"
            ],
            "type": "string"
          },
          "unchecked_clusters": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ComputeActorType": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "owner_function_id": {
            "description": "ID of the function that owns and ships this actor type. Empty when the type is unowned.",
            "type": "string"
          },
          "placement": {
            "$ref": "#/components/schemas/ActorPlacement"
          },
          "record_type": {
            "example": "compute_actor_type",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "type": {
            "example": "Counter",
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ComputeActorTypeResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ComputeActorType"
          }
        },
        "type": "object"
      },
      "Error": {
        "example": {
          "code": "20207",
          "description": "The street address provided is invalid.",
          "source": {
            "pointer": "/street_address"
          },
          "title": "Invalid street address"
        },
        "properties": {
          "code": {
            "type": "string",
            "x-format": "int64"
          },
          "description": {
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation of the error.",
            "type": "string"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "description": "Indicates which query parameter caused the error.",
                "type": "string"
              },
              "pointer": {
                "description": "JSON pointer (RFC6901) to the offending entity.",
                "format": "json-pointer",
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title"
        ],
        "type": "object"
      },
      "ErrorMeta": {
        "properties": {
          "url": {
            "example": "https://docs.telnyx.com/api/errors/10005",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorSource": {
        "properties": {
          "parameter": {
            "example": "id",
            "type": "string"
          },
          "pointer": {
            "example": "/id",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Errors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Error"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "GenericErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/edge-compute_Error"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "edge-compute_Error": {
        "properties": {
          "code": {
            "example": "10005",
            "type": "string"
          },
          "detail": {
            "example": "The requested function does not exist or you don't have access to it",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/ErrorMeta"
          },
          "source": {
            "$ref": "#/components/schemas/ErrorSource"
          },
          "title": {
            "example": "Function not found",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/compute/actors/{id}": {
      "get": {
        "description": "Retrieve one account-scoped Stateful Actor type. owner_function_id identifies the function that owns and ships the actor class; other functions may reference the same actor type through actor bindings.",
        "operationId": "GetComputeActor",
        "parameters": [
          {
            "description": "Actor type ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComputeActorTypeResponse"
                }
              }
            },
            "description": "Actor type retrieved successfully"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Actor type not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Invalid actor type ID"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Retrieve a Stateful Actor type",
        "tags": [
          "stateful actors"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
