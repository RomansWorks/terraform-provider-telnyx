  },
  "openapi": "3.1.0",
  "paths": {
    "/external_requirements/{regulatory_requirement_id}/sub_number_orders/{sub_number_order_id}": {
      "get": {
        "description": "Returns the input fields an action requirement needs and the current requirement action for a sub number order. Action requirements are fulfilled by an external step rather than by uploading documents. Australia mobile ID verification is currently the only action requirement. Once a verification link has been generated, it is returned in `requirement_action.value`.",
        "operationId": "getExternalRequirement",
        "parameters": [
          {
            "description": "The ID of the regulatory (action) requirement. For Australia mobile ID verification this is `b7c72fb8-fa08-4529-aaf6-b9117d3f3698`.",
            "in": "path",
            "name": "regulatory_requirement_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The ID of the sub number order the requirement belongs to.",
            "in": "path",
            "name": "sub_number_order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "fields_required": [
                      {
                        "description": "First Name",
                        "name": "first_name",
                        "type": "string",
                        "value": null
                      },
                      {
                        "description": "Last Name",
                        "name": "last_name",
                        "type": "string",
                        "value": null
                      }
                    ],
                    "regulatory_requirement_id": "a5b8f1d2-3c4e-4f6a-8b9c-0d1e2f3a4b5c",
                    "requirement_action": {
                      "type": "id_verification",
                      "value": null
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "fields_required": {
                          "description": "The fields the end user must provide to fulfill this requirement.",
                          "items": {
                            "properties": {
                              "description": {
                                "example": "First Name",
                                "type": "string"
                              },
                              "name": {
                                "description": "The field name to send inside the `requirement` object on the POST.",
                                "example": "first_name",
                                "type": "string"
                              },
                              "type": {
                                "example": "string",
                                "type": "string"
                              },
                              "value": {
                                "description": "The value already stored for this field, or null if not yet provided.",
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "regulatory_requirement_id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "requirement_action": {
                          "properties": {
                            "type": {
                              "description": "The type of action the end user must complete.",
                              "type": "string"
                            },
                            "value": {
                              "description": "The action value. For ID verification this is the verification link URL, or null until it has been generated.",
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Action requirement details retrieved successfully."
          },
          "401": {
            "$ref": "#/components/responses/numbers_UnauthorizedResponse_73c9788e53"
          },
          "404": {
            "$ref": "#/components/responses/numbers_NotFoundResponse_73c9788e53"
          },
          "500": {
            "$ref": "#/components/responses/GenericErrorResponse"
          }
        },
        "summary": "Get action requirement details for a sub number order",
        "tags": [
          "Requirement Groups"
        ]
      },
      "post": {
        "description": "Submits the end user's details to the external verification provider and returns the requirement action. Australia mobile ID verification is currently the only action requirement. It generates a unique Onfido verification link, returned in `requirement_action.value`, which you share with the end user. The end user's `first_name` and `last_name` must be nested inside a `requirement` object; sending them at the top level is rejected.",
        "operationId": "createExternalRequirement",
        "parameters": [
          {
            "description": "The ID of the regulatory (action) requirement. For Australia mobile ID verification this is `b7c72fb8-fa08-4529-aaf6-b9117d3f3698`.",
            "in": "path",
            "name": "regulatory_requirement_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The ID of the sub number order the requirement belongs to.",
            "in": "path",
            "name": "sub_number_order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "requirement": {
                  "first_name": "Jane",
                  "last_name": "Doe"
                }
              },
              "schema": {
                "properties": {
                  "requirement": {
                    "description": "The end user's identity details for the action requirement. Australia mobile ID verification is currently the only action requirement. It requires `first_name` and `last_name`, the same fields the corresponding GET lists in `fields_required`.",
                    "properties": {
                      "first_name": {
                        "description": "The end user's first name.",
                        "type": "string"
                      },
                      "last_name": {
                        "description": "The end user's last name.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "first_name",
                      "last_name"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "requirement"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "regulatory_requirement_id": "a5b8f1d2-3c4e-4f6a-8b9c-0d1e2f3a4b5c",
                    "requirement_action": {
                      "type": "id_verification",
                      "value": "https://verify.onfido.com/v/8f3c2a1b-9d4e-4f6a-8b9c-0d1e2f3a4b5c"
                    },
                    "sub_order_id": "5f8e6b1a-2d3c-4e5f-9a0b-1c2d3e4f5a6b"
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "regulatory_requirement_id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "requirement_action": {
                          "properties": {
                            "type": {
                              "type": "string"
                            },
                            "value": {
                              "description": "For Australia mobile ID verification, the unique Onfido verification link to share with the end user.",
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "type": "object"
                        },
                        "sub_order_id": {
                          "format": "uuid",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Action requirement submitted successfully."
          },
          "400": {
            "$ref": "#/components/responses/numbers_BadRequestResponse_73c9788e53"
          },
          "401": {
            "$ref": "#/components/responses/numbers_UnauthorizedResponse_73c9788e53"
          },
          "404": {
            "$ref": "#/components/responses/numbers_NotFoundResponse_73c9788e53"
          },
          "422": {
            "$ref": "#/components/responses/numbers_UnprocessableEntity_73c9788e53"
          },
          "500": {
            "$ref": "#/components/responses/GenericErrorResponse"
          }
        },
        "summary": "Fulfill an action requirement for a sub number order",
        "tags": [
          "Requirement Groups"
        ]
      }
    },
    "/number_order_phone_numbers/{id}/requirement_group": {
      "post": {
        "description": "Associates an existing requirement group with a phone number in a number order. The response contains the updated number-order phone-number details.",
