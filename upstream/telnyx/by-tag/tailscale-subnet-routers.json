  "paths": {
    "/tailscale_subnet_routers": {
      "get": {
        "description": "Returns a paginated list of the Tailscale Subnet Routers on the account, with support for filtering by Network.",
        "operationId": "ListTailscaleSubnetRouters",
        "parameters": [
          {
            "description": "Consolidated filter parameter (deepObject style). Originally: filter[network_id]",
            "explode": true,
            "in": "query",
            "name": "filter",
            "schema": {
              "properties": {
                "network_id": {
                  "description": "The id of the Network to filter on.",
                  "example": "0de011ae-ee53-4df4-ba96-754728eb5aad",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "style": "deepObject"
          },
          {
            "$ref": "#/components/parameters/PageConsolidated"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "advertised_routes": [
                        "172.27.0.0/24"
                      ],
                      "created_at": "2026-10-13T15:04:05.123456Z",
                      "customer_address": "172.27.254.1",
                      "device_id": "n5c6f0a7e1CNTRL",
                      "id": "5c6f0a7e-6c7b-4d7f-9f2e-3b1e4e9a8c21",
                      "name": "tailnet-ashburn",
                      "network_id": "0de011ae-ee53-4df4-ba96-754728eb5aad",
                      "record_type": "tailscale_subnet_router",
                      "region_code": "ashburn-va",
                      "status": "provisioned",
                      "tailnet_name": "acme.example",
                      "tailscale_ips": [
                        "100.101.2.30",
                        "fd7a:115c:a1e0::2a"
                      ],
                      "updated_at": "2026-10-13T15:09:41.654321Z"
                    }
                  ],
                  "meta": {
                    "page_number": 1,
                    "page_size": 25,
                    "total_pages": 1,
                    "total_results": 1
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/TailscaleSubnetRouter"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "422": {
            "$ref": "#/components/responses/netapps_UnprocessableEntity_17904fcfbc"
          },
          "default": {
            "$ref": "#/components/responses/GenericErrorResponse"
          }
        },
        "summary": "List all Tailscale Subnet Routers",
        "tags": [
          "Tailscale Subnet Routers"
        ]
      },
      "post": {
        "description": "Creates a Tailscale Subnet Router on a Network and enrolls it in the user's tailnet with the auth key. The response returns the router with `status` `provisioning`. Poll `GET /tailscale_subnet_routers/{id}` until it is `provisioned`. Then approve its routes in the tailnet, unless an auto-approver covers them.",
        "operationId": "CreateTailscaleSubnetRouter",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "advertised_routes": [
                  "172.27.0.0/24"
                ],
                "auth_key": "tskey-auth-k1AbCdEfGh2IjKlMnOpQrStUv",
                "name": "tailnet-ashburn",
                "network_id": "0de011ae-ee53-4df4-ba96-754728eb5aad",
                "region_code": "ashburn-va"
              },
              "schema": {
                "$ref": "#/components/schemas/TailscaleSubnetRouterCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "advertised_routes": [
                      "172.27.0.0/24"
                    ],
                    "created_at": "2026-10-13T15:04:05.123456Z",
                    "customer_address": "172.27.254.1",
                    "device_id": null,
                    "id": "5c6f0a7e-6c7b-4d7f-9f2e-3b1e4e9a8c21",
                    "name": "tailnet-ashburn",
                    "network_id": "0de011ae-ee53-4df4-ba96-754728eb5aad",
                    "record_type": "tailscale_subnet_router",
                    "region_code": "ashburn-va",
                    "status": "provisioning",
                    "tailnet_name": null,
                    "tailscale_ips": [],
                    "updated_at": "2026-10-13T15:04:05.123456Z"
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TailscaleSubnetRouter"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response. The router is created and provisioning has started."
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10015",
                      "detail": "Routes must exclude default, local, and Tailscale ranges.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10015"
                      },
                      "title": "Bad Request"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Bad request: the body failed validation. `detail` says what failed, for example `Routes must exclude default, local, and Tailscale ranges.` or `The request contains unknown or read-only fields.`; a missing parameter or an unknown `network_id` or `region_code` names the field in `source.pointer`."
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10027",
                      "detail": "The server understood the syntax of the request but was unable to process the instructions.",
                      "title": "Unprocessable Entity"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unprocessable entity: an advertised route overlaps the addresses reserved for routers, `172.27.254.0/24` and `198.18.0.0/20`. The body is the generic error; it does not name the route."
          },
          "default": {
            "$ref": "#/components/responses/GenericErrorResponse"
          }
        },
        "summary": "Create a Tailscale Subnet Router",
        "tags": [
          "Tailscale Subnet Routers"
        ]
      }
    },
    "/tailscale_subnet_routers/{id}": {
      "delete": {
        "description": "Removes the router from the Network and logs it out of the tailnet. The response returns the router with `status` `deleting`. The record disappears once removal completes. A machine entry can remain in the tailnet's admin console until it is removed there.",
        "operationId": "DeleteTailscaleSubnetRouter",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "advertised_routes": [
                      "172.27.0.0/24"
                    ],
                    "created_at": "2026-10-13T15:04:05.123456Z",
                    "customer_address": "172.27.254.1",
                    "device_id": "n5c6f0a7e1CNTRL",
                    "id": "5c6f0a7e-6c7b-4d7f-9f2e-3b1e4e9a8c21",
                    "name": "tailnet-ashburn",
                    "network_id": "0de011ae-ee53-4df4-ba96-754728eb5aad",
                    "record_type": "tailscale_subnet_router",
                    "region_code": "ashburn-va",
                    "status": "deleting",
                    "tailnet_name": "acme.example",
                    "tailscale_ips": [
                      "100.101.2.30",
                      "fd7a:115c:a1e0::2a"
                    ],
                    "updated_at": "2026-10-14T10:30:12.000000Z"
                  }
