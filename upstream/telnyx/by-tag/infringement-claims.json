  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/dir/{dir_id}/infringement_claims": {
      "get": {
        "description": "Return the trademark or copyright claims filed against this DIR. Each claim's `status` is `pending` (newly filed; DIR auto-suspended), `contested` (you have submitted contest evidence; awaiting resolution), or `resolved` (final). Resolution outcomes: `upheld` (claim accepted; DIR stays suspended/permanently_rejected), `rejected` (claim dismissed; DIR restored to `verified`), `modified` (partial outcome).",
        "operationId": "listInfringementClaimsForDir",
        "parameters": [
          {
            "$ref": "#/components/parameters/DirId"
          },
          {
            "$ref": "#/components/parameters/BcPageNumber"
          },
          {
            "$ref": "#/components/parameters/BcPageSize"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfringementClaimList"
                }
              }
            },
            "description": "Paginated list of claims for this DIR."
          },
          "4XX": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "default": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          }
        },
        "summary": "List infringement claims for a DIR",
        "tags": [
          "Infringement Claims"
        ]
      }
    },
    "/dir/{dir_id}/infringement_update": {
      "put": {
        "description": "Push a fix for a DIR that is `suspended` with an open infringement claim back into vetting. `POST /dir/{dir_id}/submit` is blocked while a claim is open, so this is the customer-callable path to update the DIR's content and re-certify before Telnyx adjudicates the claim. All four certification booleans must be `true`. Optional content fields (`display_name`, `logo_url`, `call_reasons`, `documents`) update the DIR; documents are append-only.",
        "operationId": "updateDirInfringement",
        "parameters": [
          {
            "$ref": "#/components/parameters/DirId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "certify_brand_is_accurate": true,
                "certify_ip_ownership": true,
                "certify_no_infringement": true,
                "certify_no_shaft_content": true,
                "infringement_resolution_notes": "Updated the display name to remove the disputed mark and re-uploaded the authorization."
              },
              "schema": {
                "$ref": "#/components/schemas/DirInfringementUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirWrapped"
                }
              }
            },
            "description": "DIR updated and re-submitted for vetting."
          },
          "400": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "422": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          }
        },
        "summary": "Update a DIR to resolve an infringement concern",
        "tags": [
          "Infringement Claims"
        ]
      }
    },
    "/infringement_claims/{claim_id}": {
      "get": {
        "description": "Retrieve a single claim by id. Returns `404` if the claim does not exist or is not against a DIR you own.",
        "operationId": "getInfringementClaim",
        "parameters": [
          {
            "description": "Claim id (lowercase UUID).",
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "example": "e379fbc8-cd83-4bef-a280-a0ac9d00dcf8",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfringementClaimWrapped"
                }
              }
            },
            "description": "Claim."
          },
          "4XX": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "default": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          }
        },
        "summary": "Get an infringement claim",
        "tags": [
          "Infringement Claims"
        ]
      }
    },
    "/infringement_claims/{claim_id}/contest": {
      "post": {
        "description": "Submit a written response and supporting documents disputing the claim. The first call moves the claim from `pending` to `contested`; subsequent calls append supplementary evidence without changing status. The `documents[]` you attach are aggregated across rounds in the claim's `contest_documents` field.\n\nOnly `pending` and `contested` claims accept new evidence. A `resolved` claim returns `400`.\n\nFailure modes:\n- `400` - the claim is `resolved` (terminal); cannot be contested further.\n- `404` - the claim does not exist or is not against a DIR you own.\n- `422` - `contest_notes` is too short (\u003c 10 chars), too long (\u003e 2000 chars), `documents` is \u003e 20 entries, or a `document_id` is duplicated within the same submission.",
        "operationId": "contestInfringementClaim",
        "parameters": [
          {
            "description": "Unique identifier of the claim.",
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "example": "e379fbc8-cd83-4bef-a280-a0ac9d00dcf8",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "contest_notes": "We own the trademark outright; our registration precedes the claimant by three years. See attached certificate.",
                "documents": [
                  {
                    "description": "USPTO trademark certificate.",
                    "document_id": "2a7e8337-e803-4057-a4ae-26c40eb0bc6c",
                    "document_type": "trademark_registration"
                  }
                ]
              },
              "schema": {
                "$ref": "#/components/schemas/InfringementClaimContest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfringementClaimWrapped"
                }
              }
            },
            "description": "Updated claim, status `contested`."
          },
          "4XX": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          },
          "default": {
            "$ref": "#/components/responses/branded-calling_GenericErrorResponse"
          }
        },
        "summary": "Contest an infringement claim",
        "tags": [
          "Infringement Claims"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
