          "webhook_event_url": {
            "$ref": "#/components/schemas/WebhookEventUrl"
          },
          "webhook_timeout_secs": {
            "$ref": "#/components/schemas/WebhookTimeoutSecs"
          }
        },
        "required": [
          "application_name",
          "webhook_event_url"
        ],
        "title": "Create Fax Application Request",
        "type": "object"
      },
