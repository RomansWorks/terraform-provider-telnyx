{
  "components": {
    "schemas": {
      "AgentGatewayPolicyAttachment": {
        "description": "Where an instance applies a policy.",
        "properties": {
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the attachment was created."
          },
          "default": {
            "default": false,
            "description": "`true` applies the policy only to the requests no other attachment matches.",
            "type": "boolean"
          },
          "id": {
            "description": "The attachment's ID.",
            "format": "uuid",
            "type": "string"
          },
          "models": {
            "default": [],
            "description": "The models whose requests the policy applies to, by name. A name can use `*` as a wildcard. Empty applies the policy to every request.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "policy": {
            "description": "The policy to apply, by name.",
            "type": "string"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "An attachment with a priority applies before the others."
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the attachment last changed."
          }
        },
        "required": [
          "id",
          "policy",
          "models",
          "priority",
          "default",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
