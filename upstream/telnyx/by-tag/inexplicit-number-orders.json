          {
            "description": "The size of the page",
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "maximum": 250,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/InexplicitNumberOrderResponse"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "title": "List Inexplicit Number Orders Response",
                  "type": "object"
