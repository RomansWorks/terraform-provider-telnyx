    "/email/ip_pools/{id}/ips/{ip_id}": {
      "delete": {
        "description": "Remove the dedicated IP from the pool. The IP is kept but carries no mail until added to a pool again. Removing the last IP requires `force=true` and `drain=true`.",
        "operationId": "removeIpFromPool",
        "parameters": [
          {
            "description": "The IP pool identifier (UUID).",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The dedicated IP identifier (UUID).",
            "in": "path",
            "name": "ip_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Set together with `drain=true` to remove the last IP in the pool. Either flag alone has no effect.",
            "in": "query",
            "name": "force",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Set together with `force=true` to remove the last IP in the pool. Acknowledges that mail routed to the emptied pool is held until the pool has a sendable IP again.",
            "in": "query",
            "name": "drain",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "IP removed from the pool. No response body."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10001",
                      "detail": "The requested pool membership was not found",
                      "title": "Not Found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The pool or the dedicated IP was not found, or the IP is not in this pool."
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "40901",
                      "detail": "cannot remove the last IP from a pool without force: true and drain: true (in-flight messages need a routable source)",
