      "post": {
        "description": "Adds a REST API by its OpenAPI description. Each operation becomes a tool at `{gateway_url}/mcp`, named with the API's `name`, a hyphen, and the lowercased `operationId`. A description the gateway cannot fetch yields an API with no tools. The instance must be `ready`; otherwise the request answers `409`.",
        "operationId": "CreateAgentGatewayApi",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "bearer": {
                  "summary": "A bearer token",
                  "value": {
                    "auth": {
                      "type": "bearer_token",
                      "value": "example-orders-token"
                    },
                    "name": "orders_api",
                    "spec_url": "https://example.com/orders/openapi.json"
                  }
                },
                "public": {
                  "summary": "A public API",
                  "value": {
                    "base_url": "https://petstore3.swagger.io/api/v3",
                    "name": "petstore",
                    "open_to_every_key": true,
                    "spec_url": "https://petstore3.swagger.io/api/v3/openapi.json"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AgentGatewayApiCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "auth": {
                      "type": "none"
