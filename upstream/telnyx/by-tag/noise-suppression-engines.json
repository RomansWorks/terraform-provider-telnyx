  "paths": {
    "/noise_suppression_engines": {
      "get": {
        "description": "Returns all noise suppression engines available to the authenticated user. Engines gated behind a feature flag are included only when the flag is enabled for the user's account. Results are not paginated; the number of engines is expected to remain small.",
        "operationId": "listNoiseSuppressionEngines",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "default_attenuation_level": 0,
                      "label": "Denoiser",
                      "value": "denoiser"
                    },
                    {
                      "default_attenuation_level": 80,
                      "label": "DeepFilterNet",
                      "value": "deep_filter_net"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/NoiseSuppressionEnginesListResponse"
                }
              }
            },
            "description": "A list of noise suppression engines available to the authenticated user"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/noise-suppression-engines_ErrorResponse"
                }
              }
            },
            "description": "Unauthorized — the request did not carry valid Telnyx API credentials"
          }
        },
        "summary": "List available noise suppression engines",
        "tags": [
          "Noise Suppression Engines"
        ],
        "x-endpoint-cost": "light",
        "x-latency-category": "responsive"
