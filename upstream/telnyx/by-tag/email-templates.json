          "404": {
            "$ref": "#/components/responses/email_NotFoundResponse"
          }
        },
        "summary": "Get an email template",
        "tags": [
          "Email Templates"
        ]
      },
      "patch": {
        "description": "Updates one or more fields of the specified email template and returns the updated template.",
