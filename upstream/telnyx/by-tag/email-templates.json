        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "subject": "Welcome aboard, {{first_name}}!"
              },
              "schema": {
                "$ref": "#/components/schemas/UpdateEmailTemplateRequest"
              }
            }
          },
          "required": true
