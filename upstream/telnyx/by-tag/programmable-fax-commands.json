        "properties": {
          "client_state": {
            "description": "State received from a command.",
            "example": "aGF2ZSBhIG5pY2UgZGF5ID1d",
            "type": "string"
          },
          "connection_id": {
            "$ref": "#/components/schemas/ConnectionId"
