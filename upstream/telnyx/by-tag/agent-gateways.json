    "/agent_gateways/{instance_id}/models": {
      "get": {
        "description": "Lists the models the instance serves. Each has the name a request uses, the Telnyx Inference model behind it, and its price per million tokens.",
        "operationId": "ListAgentGatewayModels",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
