  "openapi": "3.1.0",
  "paths": {
    "/email_templates": {
      "get": {
        "description": "Lists templates sorted newest first by `created_at desc, id desc`. Optional filters match a case-insensitive literal name/subject query, stored body presence, and the `strict_variables` and `autoescape` settings. Filters intersect, remain scoped to the authenticated account, and apply before cursor pagination. Invalid filter names or values return 400.",
        "operationId": "ListEmailTemplates",
        "parameters": [
          {
            "$ref": "#/components/parameters/email_PageSize"
          },
          {
            "$ref": "#/components/parameters/PageCursor"
          },
          {
            "$ref": "#/components/parameters/TemplateQueryFilter"
          },
          {
            "$ref": "#/components/parameters/TemplateContentTypeFilter"
          },
          {
            "$ref": "#/components/parameters/TemplateStrictVariablesFilter"
          },
          {
            "$ref": "#/components/parameters/TemplateAutoescapeFilter"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "autoescape": false,
                      "created_at": "2024-01-23T18:10:02.574Z",
                      "html_body": "string",
                      "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "name": "string",
                      "record_type": "email_template",
                      "strict_variables": false,
                      "subject": "string",
                      "text_body": "string",
                      "updated_at": "2024-01-23T18:10:02.574Z",
                      "variable_schema": null,
                      "variables": [
                        "string"
                      ],
                      "variables_mode": "automatic"
                    }
                  ],
                  "meta": {
                    "page_cursor": "string",
                    "page_size": 1
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/EmailTemplateListResponse"
                }
              }
            },
            "description": "Paginated list of templates."
          },
          "400": {
            "$ref": "#/components/responses/email_BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/email_UnauthorizedResponse"
          }
        },
        "summary": "List email templates",
        "tags": [
          "Email Templates"
        ]
      },
      "post": {
        "description": "Creates a Liquid email template. Variables are auto-extracted when omitted.",
        "operationId": "CreateEmailTemplate",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "html_body": "\u003ch1\u003eHello {{ first_name }}\u003c/h1\u003e",
                "name": "Welcome Email",
                "subject": "Welcome, {{ first_name }}!",
                "text_body": "Hello {{ first_name }}"
              },
              "schema": {
                "$ref": "#/components/schemas/CreateEmailTemplateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailTemplateResponse"
                }
              }
            },
            "description": "Template created.",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10015",
                      "detail": "email is required",
                      "title": "Bad Request"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "Bad Request / Validation Failed (10015). Invalid, duplicate, empty, malformed, or overlong Idempotency-Key headers are rejected by Edge with HTTP 400 and error code 10015."
          },
          "401": {
            "$ref": "#/components/responses/email_UnauthorizedResponse"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflictResponse"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeResponse"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10015",
                      "detail": "subject can't be blank",
                      "source": {
                        "pointer": "/data/attributes/subject"
                      },
                      "title": "Validation Failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "Validation Failed (10015) or changeset validation error. Reusing an Idempotency-Key with a different request also returns 422 (10027)."
          },
          "503": {
            "$ref": "#/components/responses/email_ServiceUnavailableResponse"
          }
        },
        "summary": "Create an email template",
        "tags": [
          "Email Templates"
        ]
      }
    },
    "/email_templates/{id}": {
      "delete": {
        "description": "Deletes the account-owned template. The operation returns `204` with no body and prevents future sends or renders from using the deleted template ID.",
