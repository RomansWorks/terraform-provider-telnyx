{
  "components": {
    "schemas": {
      "AgentGateway": {
        "description": "An Agent Gateway instance on a WireGuard Interface.",
        "properties": {
          "created_at": {
            "description": "When the instance was created.",
            "format": "date-time",
            "type": "string"
          },
          "engine": {
            "const": "litellm",
            "description": "The gateway engine.",
            "type": "string"
          },
          "engine_version": {
            "description": "The engine version the instance runs.",
            "type": "string"
          },
          "gateway_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The base URL of the instance's API, `http://\u003caddress\u003e:4000`, where the address is the instance's peer address on the WireGuard Interface. Reachable only from hosts on the instance's *Network*, and every request to it carries a key from this API. `null` until the instance is `ready`."
          },
          "id": {
            "description": "Identifies the instance.",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A label for people; `null` when none was given."
          },
          "network_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The [*Network*](https://developers.telnyx.com/docs/network/overview) the WireGuard Interface belongs to."
          },
          "status": {
            "$ref": "#/components/schemas/AgentGatewayStatus"
          },
          "wireguard_interface_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The WireGuard Interface the instance joins as a peer."
          }
        },
        "required": [
          "id",
          "name",
          "engine",
          "engine_version",
          "status",
          "gateway_url",
          "wireguard_interface_id",
          "network_id",
          "created_at"
        ],
        "type": "object"
      },
      "AgentGatewayCreate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A label for people."
          },
          "wireguard_interface_id": {
            "description": "One of the account's WireGuard Interfaces. The instance joins it as a peer, and the interface's other peers reach the instance.",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "wireguard_interface_id"
        ],
        "type": "object"
      },
      "AgentGatewayListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AgentGateway"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "AgentGatewayModel": {
        "description": "A model an instance serves.",
        "properties": {
          "id": {
            "description": "The model's ID on the instance.",
            "format": "uuid",
            "type": "string"
          },
          "model": {
            "description": "The Telnyx Inference model behind it, such as `zai-org/GLM-5.3-Flash`.",
            "type": "string"
          },
          "name": {
            "description": "The name a request uses, such as `GLM-5.3-Flash`.",
            "type": "string"
          },
          "priced_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the price was last set."
          },
          "pricing": {
            "$ref": "#/components/schemas/AgentGatewayModelPricing"
          }
        },
        "required": [
          "id",
          "name",
          "model",
          "pricing",
          "priced_at"
        ],
        "type": "object"
      },
      "AgentGatewayModelListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AgentGatewayModel"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AgentGatewayModelPricing": {
        "description": "A model's price in USD per million tokens.",
        "properties": {
          "cached_input": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "USD per million cached input tokens."
          },
          "currency": {
            "description": "Always `USD`.",
            "type": "string"
          },
          "input": {
            "description": "USD per million input tokens.",
            "type": "number"
          },
          "output": {
            "description": "USD per million output tokens.",
            "type": "number"
          },
          "unit": {
            "description": "Always `1M_tokens`.",
            "type": "string"
          }
        },
        "required": [
          "input",
          "output",
          "cached_input",
          "currency",
          "unit"
        ],
        "type": "object"
      },
      "AgentGatewayResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AgentGateway"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AgentGatewayStatus": {
        "description": "Where the instance is in its lifecycle. `pending`: created and waiting to start. `provisioning`: starting. `ready`: running, with its `gateway_url` set. `failed`: did not start in time; delete it. `deleting`: being removed.",
        "enum": [
          "pending",
          "provisioning",
          "ready",
          "failed",
          "deleting"
        ],
        "type": "string"
      },
      "PageMeta": {
        "properties": {
          "page_number": {
            "description": "The page returned, counting from 1.",
            "type": "integer"
          },
          "page_size": {
            "description": "Results per page.",
            "type": "integer"
          },
          "total_pages": {
            "description": "Pages that can be requested; 0 when nothing matched.",
            "type": "integer"
          },
          "total_results": {
            "description": "Results across every page.",
            "type": "integer"
          }
        },
        "required": [
          "total_results",
          "page_number",
          "page_size",
          "total_pages"
        ],
        "type": "object"
      },
      "TelnyxError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "meta": {
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TelnyxErrors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/TelnyxError"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-gateway_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent_gateways": {
      "get": {
        "description": "Lists the account's Agent Gateway instances, newest first, one page at a time.",
        "operationId": "ListAgentGateways",
        "parameters": [
          {
            "description": "The page to return, counting from 1.",
            "in": "query",
            "name": "page[number]",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Results per page.",
            "in": "query",
            "name": "page[size]",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "created_at": "2026-10-21T19:32:48.377714Z",
                      "engine": "litellm",
                      "engine_version": "v1.105.1",
                      "gateway_url": "http://172.27.0.3:4000",
                      "id": "ecffdf4b-93ea-4a7b-8295-51dfd2077996",
                      "name": "support-gw",
                      "network_id": "7ade8c3c-95a7-447b-92f2-c829f760159c",
                      "status": "ready",
                      "wireguard_interface_id": "c788eb40-a4c0-4bf5-8f84-976027960f8e"
                    }
                  ],
                  "meta": {
                    "page_number": 1,
                    "page_size": 50,
                    "total_pages": 1,
                    "total_results": 1
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayListResponse"
                }
              }
            },
            "description": "One page of instances"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10033",
                      "detail": "Input should be greater than or equal to 1",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10033"
                      },
                      "source": {
                        "parameter": "page[size]"
                      },
                      "title": "Value outside of range"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid paging parameters"
          }
        },
        "summary": "List Agent Gateways",
        "tags": [
          "Agent Gateways"
        ]
      },
      "post": {
        "description": "Creates an Agent Gateway instance on one of the account's WireGuard Interfaces. The instance starts `pending`, moves to `provisioning`, and then to `ready` or `failed`. It joins the WireGuard Interface as a peer named `agw-\u003cinstance id\u003e`, and its `gateway_url` is set when it is `ready`.",
        "operationId": "CreateAgentGateway",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "instance": {
                  "summary": "An instance on a WireGuard Interface",
                  "value": {
                    "name": "support-gw",
                    "wireguard_interface_id": "c788eb40-a4c0-4bf5-8f84-976027960f8e"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AgentGatewayCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "created_at": "2026-10-21T19:32:48.377714Z",
                    "engine": "litellm",
                    "engine_version": "v1.105.1",
                    "gateway_url": null,
                    "id": "ecffdf4b-93ea-4a7b-8295-51dfd2077996",
                    "name": "support-gw",
                    "network_id": "7ade8c3c-95a7-447b-92f2-c829f760159c",
                    "status": "pending",
                    "wireguard_interface_id": "c788eb40-a4c0-4bf5-8f84-976027960f8e"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayResponse"
                }
              }
            },
            "description": "The instance, `pending`"
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10013",
                      "detail": "One of the associated fields does not exist.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10013"
                      },
                      "source": {
                        "pointer": "/wireguard_interface_id"
                      },
                      "title": "Missing association"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The WireGuard Interface does not exist or belongs to another account"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10004",
                      "detail": "Field required",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10004"
                      },
                      "source": {
                        "pointer": "/wireguard_interface_id"
                      },
                      "title": "Missing required parameter"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request body"
          }
        },
        "summary": "Create an Agent Gateway",
        "tags": [
          "Agent Gateways"
        ]
      }
    },
    "/agent_gateways/{instance_id}": {
      "delete": {
        "description": "Deletes an Agent Gateway instance in any status. The response shows it `deleting`; repeating the request answers the same until the instance is gone, and then `404`. The instance's engine and everything stored on it are removed.",
