{
  "components": {
    "schemas": {
      "AgentGatewayServerGrant": {
        "properties": {
          "id": {
            "description": "An MCP server's or API's `id` on the instance.",
            "format": "uuid",
            "type": "string"
          },
          "tools": {
            "description": "The tools the grant covers, by name without the server prefix. `[]` covers every tool the server exposes.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "AgentGatewayToolPermissions": {
        "properties": {
          "servers": {
            "description": "The servers granted, each with its tools. `[]` grants none.",
            "items": {
              "$ref": "#/components/schemas/AgentGatewayServerGrant"
            },
            "type": "array"
          }
        },
        "required": [
          "servers"
        ],
        "type": "object"
      },
      "AgentGatewayToolPermissionsResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AgentGatewayToolPermissions"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TelnyxError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
