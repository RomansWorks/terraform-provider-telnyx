      "ErrorObject": {
        "properties": {
          "code": {
            "description": "Telnyx error code. Send admission errors include account daily quota 10011 and sender-domain ramp code domain_graduation_limit_exceeded. Edge idempotency errors use 10027 or 10036. Fallback 404/500 responses from the framework may use string status codes ('404', '500') instead.",
            "enum": [
              "10001",
              "10006",
              "10007",
              "10011",
              "10015",
              "10016",
              "10019",
              "domain_graduation_limit_exceeded",
              "recipient_suppressed",
              "reputation_suspended",
              "404",
              "500",
              "10027",
              "10036"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable error detail. Changeset responses may return a structured object.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "meta": {
            "additionalProperties": true,
            "description": "Additional metadata. Present on 401 errors with a documentation URL.",
            "nullable": true,
            "type": "object"
          },
          "source": {
            "additionalProperties": true,
            "nullable": true,
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
