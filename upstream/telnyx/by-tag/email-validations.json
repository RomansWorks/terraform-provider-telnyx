{
  "components": {
    "headers": {
      "IdempotentReplayed": {
        "description": "Present with value `true` when Edge replayed a stored successful response for the supplied Idempotency-Key. Omitted for first-time requests and error responses.",
        "schema": {
          "enum": [
            true
          ],
          "example": true,
          "type": "boolean"
        }
      }
    },
    "parameters": {
      "BatchId": {
        "description": "Email validation batch UUID.",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "description": "Optional opaque, unquoted key for safely retrying the same logical request. Keys must contain 1 to 255 letters, numbers, hyphens, or underscores. Generate a unique UUID v4 for each operation and reuse it only when retrying that operation with the same request. Invalid headers—including duplicate, empty, malformed, or overlong values—return 400 with error code 10015. A request already in progress with the same key returns 409; reusing the key with a different request returns 422. Only successful responses are replayed, for up to 24 hours. Do not include sensitive data in the key.",
        "example": "8e03978e-40d5-43e8-bc93-6894a57f9326",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,255}$",
          "type": "string"
        }
      }
    },
    "responses": {
      "IdempotencyConflictResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10036",
                  "detail": "A request with this Idempotency-Key is already being processed.",
                  "source": {
                    "pointer": "/header/Idempotency-Key"
                  },
                  "title": "Resource is being processed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "A request with the same Idempotency-Key is still being processed (10036). Retry later with the same key and request."
      },
      "PayloadTooLargeResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10007",
                  "detail": "An unexpected error occured.",
                  "title": "Unexpected error"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Request body exceeds the 8,000,000-byte limit for this endpoint."
      },
      "email_InternalServerErrorResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10019",
                  "detail": "Failed to create batch validation",
                  "title": "Internal Server Error"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Internal server error (10019)."
      },
      "email_NotFoundResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10001",
                  "detail": "The requested resource was not found",
                  "title": "Not Found"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Resource not found (10001)."
      },
      "email_ServiceUnavailableResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10016",
                  "detail": "The email domain service is temporarily unavailable. Please try again later.",
                  "title": "Service Unavailable"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Service unavailable (10016), including an unavailable upstream dependency or unavailable Edge idempotency protection for a keyed request."
      },
      "email_UnauthorizedResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10006",
                  "detail": "Invalid API key",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10006"
                  },
                  "title": "Not authorized"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Not authorized (10006)."
      }
    },
    "schemas": {
      "CreateEmailValidationBatchRequest": {
        "properties": {
          "emails": {
            "items": {
              "description": "Email address to validate. Any string is accepted; validation results indicate whether the address is valid. Blank strings are discarded and counted in duplicates_removed; if all entries are blank, returns 400.",
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "webhook_url": {
            "description": "URL for batch completion webhook. Empty string is treated as omitted. SSRF-protected; private/reserved IPs and internal hostnames are rejected.",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "emails"
        ],
        "type": "object"
      },
      "CreateEmailValidationRequest": {
        "properties": {
          "email": {
            "description": "Email address to validate. Any non-empty string is accepted; invalid syntax returns valid=false rather than a request error.",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "EmailValidation": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/EmailValidationChecks"
          },
          "did_you_mean": {
            "description": "Suggested correction for typo. Omitted when nil.",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "record_type": {
            "enum": [
              "email_validation"
            ],
            "type": "string"
          },
          "risk_score": {
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "record_type",
          "email",
          "valid",
          "risk_score",
          "checks"
        ],
        "type": "object"
      },
      "EmailValidationBatch": {
        "description": "Shape returned by the create endpoint. Includes duplicates_removed.",
        "properties": {
          "duplicates_removed": {
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "record_type": {
            "enum": [
              "email_validation_batch"
            ],
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EmailValidationBatchStatus"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          },
          "webhook_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "record_type",
          "id",
          "status",
          "total",
          "duplicates_removed"
        ],
        "type": "object"
      },
      "EmailValidationBatchDetail": {
        "allOf": [
          {
            "properties": {
              "completed_at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "type": "string"
              },
              "record_type": {
                "enum": [
                  "email_validation_batch"
                ],
                "type": "string"
              },
              "results": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/EmailValidationResult"
                },
                "description": "Map keyed by original email address. Present only when the batch is completed.",
                "type": "object"
              },
              "status": {
                "$ref": "#/components/schemas/EmailValidationBatchStatus"
              },
              "total": {
                "minimum": 0,
                "type": "integer"
              },
              "webhook_url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "record_type",
              "id",
              "status",
              "total"
            ],
            "type": "object"
          }
        ],
        "description": "Shape returned by the GET endpoint. Does not include duplicates_removed."
      },
      "EmailValidationBatchDetailResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmailValidationBatchDetail"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EmailValidationBatchResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmailValidationBatch"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EmailValidationBatchStatus": {
        "enum": [
          "pending",
          "processing",
          "completed",
          "failed"
        ],
        "type": "string"
      },
      "EmailValidationCheck": {
        "properties": {
          "details": {
            "description": "Human-readable check detail. Omitted when nil.",
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "required": [
          "pass"
        ],
        "type": "object"
      },
      "EmailValidationChecks": {
        "properties": {
          "disposable": {
            "$ref": "#/components/schemas/EmailValidationCheck"
          },
          "mx": {
            "$ref": "#/components/schemas/EmailValidationCheck"
          },
          "role_based": {
            "$ref": "#/components/schemas/EmailValidationCheck"
          },
          "syntax": {
            "$ref": "#/components/schemas/EmailValidationCheck"
          },
          "typo": {
            "$ref": "#/components/schemas/EmailValidationTypoCheck"
          }
        },
        "required": [
          "syntax",
          "mx",
          "disposable",
          "role_based",
          "typo"
        ],
        "type": "object"
      },
      "EmailValidationResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EmailValidation"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "EmailValidationResult": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/EmailValidationChecks"
          },
          "did_you_mean": {
            "description": "Suggested correction for typo. Omitted when nil.",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "risk_score": {
            "format": "float",
            "minimum": 0,
            "type": "number"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "valid",
          "risk_score",
          "checks"
        ],
        "type": "object"
      },
      "EmailValidationTypoCheck": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EmailValidationCheck"
          },
          {
            "properties": {
              "suggestion": {
                "description": "Suggested correction for common typos. Omitted when nil.",
                "type": "string"
              }
            },
            "type": "object"
          }
        ]
      },
      "ErrorObject": {
        "properties": {
          "code": {
            "description": "Telnyx error code. Send admission errors include account daily quota 10011 and sender-domain ramp code domain_graduation_limit_exceeded. Edge idempotency errors use 10027 or 10036. Fallback 404/500 responses from the framework may use string status codes ('404', '500') instead.",
            "enum": [
              "10001",
              "10006",
              "10007",
              "10011",
              "10015",
              "10016",
              "10019",
              "domain_graduation_limit_exceeded",
              "recipient_suppressed",
              "reputation_suspended",
              "404",
              "500",
              "10027",
              "10036"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable error detail. Changeset responses may return a structured object.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "meta": {
            "additionalProperties": true,
            "description": "Additional metadata. Present on 401 errors with a documentation URL.",
            "nullable": true,
            "type": "object"
          },
          "source": {
            "additionalProperties": true,
            "nullable": true,
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "SuppressedRecipient": {
        "properties": {
          "override_allowed": {
            "description": "Whether an authorized send may override this suppression.",
            "type": "boolean"
          },
          "reason": {
            "description": "Suppression reason returned by the recipient suppression service.",
            "type": "string"
          },
          "scope": {
            "description": "Scope at which the suppression applies.",
            "type": "string"
          },
          "to": {
            "description": "Suppressed recipient email address.",
            "format": "email",
            "type": "string"
          }
        },
        "required": [
          "to",
          "reason",
          "scope",
          "override_allowed"
        ],
        "type": "object"
      },
      "email_ErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorObject"
            },
            "type": "array"
          },
          "suppressed": {
            "description": "Present when every recipient is suppressed, so the request is rejected and no message is created.",
            "items": {
              "$ref": "#/components/schemas/SuppressedRecipient"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/email_validations": {
      "post": {
        "description": "Validates a single email address and returns deliverability checks.",
        "operationId": "CreateEmailValidation",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "email": "user@example.com"
              },
              "schema": {
                "$ref": "#/components/schemas/CreateEmailValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailValidationResponse"
                }
              }
            },
            "description": "Email validation result.",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10015",
                      "detail": "email is required",
                      "title": "Bad Request"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "Bad Request / Validation Failed (10015). Invalid, duplicate, empty, malformed, or overlong Idempotency-Key headers are rejected by Edge with HTTP 400 and error code 10015."
          },
          "401": {
            "$ref": "#/components/responses/email_UnauthorizedResponse"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflictResponse"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeResponse"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10027",
                      "detail": "The server understood the syntax of the request but was unable to process the instructions.",
                      "title": "Unprocessable Entity"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "The Idempotency-Key was already used for a different request (10027)."
          },
          "503": {
            "$ref": "#/components/responses/email_ServiceUnavailableResponse"
          }
        },
        "summary": "Validate a single email address",
        "tags": [
          "Email Validations"
        ]
      }
    },
    "/email_validations/batch": {
      "post": {
        "description": "Creates an asynchronous batch validation job for up to 1,000 email addresses.",
        "operationId": "CreateEmailValidationBatch",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "emails": [
                  "user@example.com",
                  "admin@example.org"
                ],
                "webhook_url": "https://example.com/webhooks/email-validation"
              },
              "schema": {
                "$ref": "#/components/schemas/CreateEmailValidationBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailValidationBatchResponse"
                }
              }
            },
            "description": "Batch validation job accepted. Poll GET /email_validations/batch/{id} with the returned batch id to retrieve results.",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "invalidEmails": {
                    "value": {
                      "errors": [
                        {
                          "code": "10015",
                          "detail": "emails is required and must be an array",
                          "title": "Bad Request"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid email list, or batch size exceeded. Invalid, duplicate, empty, malformed, or overlong Idempotency-Key headers are rejected by Edge with HTTP 400 and error code 10015."
          },
          "401": {
            "$ref": "#/components/responses/email_UnauthorizedResponse"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflictResponse"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeResponse"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10015",
                      "detail": "webhook_url must be an HTTP or HTTPS URL",
                      "source": {
                        "pointer": "/data/attributes/webhook_url"
                      },
                      "title": "Validation Failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/email_ErrorResponse"
                }
              }
            },
            "description": "Changeset validation error (e.g. invalid webhook_url). Reusing an Idempotency-Key with a different request also returns 422 (10027)."
          },
          "500": {
            "$ref": "#/components/responses/email_InternalServerErrorResponse"
          },
          "503": {
            "$ref": "#/components/responses/email_ServiceUnavailableResponse"
          }
        },
        "summary": "Create a batch email validation job",
        "tags": [
          "Email Validations"
        ]
      }
    },
    "/email_validations/batch/{id}": {
      "get": {
        "description": "Retrieves the current status and, once completed, validation results for a batch job.",
        "operationId": "GetEmailValidationBatch",
        "parameters": [
          {
            "$ref": "#/components/parameters/BatchId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "completed_at": "2024-01-23T18:10:02.574Z",
                    "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "record_type": "email_validation_batch",
                    "status": "pending",
                    "total": 0,
                    "webhook_url": "https://example.com"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/EmailValidationBatchDetailResponse"
                }
              }
            },
            "description": "Batch validation job status."
          },
          "401": {
            "$ref": "#/components/responses/email_UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/email_NotFoundResponse"
          }
        },
