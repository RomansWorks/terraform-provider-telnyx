    "/room_sessions/{room_session_id}/participants": {
      "get": {
        "description": "Returns a paginated list of participants for the specified room session. Filter participants by join, update, or leave date and by participant context.",
        "operationId": "RetrieveListRoomParticipants",
        "parameters": [
          {
            "description": "The unique identifier of a room session.",
            "in": "path",
            "name": "room_session_id",
            "required": true,
