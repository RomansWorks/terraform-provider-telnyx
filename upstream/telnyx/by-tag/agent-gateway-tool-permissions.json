  "openapi": "3.1.0",
  "paths": {
    "/agent_gateways/{instance_id}/keys/{key_id}/tool_permissions": {
      "get": {
        "description": "Returns the MCP servers and APIs the key may use, and the tools within each. `servers: []` means none. The instance must be `ready`; otherwise the request answers `409`.",
        "operationId": "GetAgentGatewayKeyToolPermissions",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The key's `id`, a 64-character hash the instance stores in place of the key.",
            "example": "f739ad190d29e2a5e658c3a486111953e6c18d746fd04374962ab150aae17757",
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "servers": [
                      {
                        "id": "88d5a97b-4080-4855-8bac-a39811b1dc24",
                        "tools": [
                          "get_order"
                        ]
                      }
                    ]
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayToolPermissionsResponse"
                }
              }
            },
            "description": "The grant"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10005"
                      },
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "99901",
                      "detail": "The instance is not ready; its engine is not running.",
                      "title": "Instance not ready"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The instance is not `ready`"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "99903",
                      "detail": "The instance's engine did not answer; try again shortly.",
                      "title": "Engine unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The instance's engine did not answer"
          }
        },
        "summary": "Retrieve a key's tool permissions",
        "tags": [
          "Agent Gateway Tool Permissions"
        ]
      },
      "put": {
        "description": "Replaces the grant whole and returns it. Every server must be one of the instance's MCP servers or APIs, named once. A key reaches the servers granted to it or to its team, and the servers open to every key; when both grant, only the servers in both. The instance must be `ready`; otherwise the request answers `409`.",
        "operationId": "SetAgentGatewayKeyToolPermissions",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The key's `id`, a 64-character hash the instance stores in place of the key.",
            "example": "f739ad190d29e2a5e658c3a486111953e6c18d746fd04374962ab150aae17757",
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "one_tool": {
                  "summary": "One tool of one server",
                  "value": {
                    "servers": [
                      {
                        "id": "88d5a97b-4080-4855-8bac-a39811b1dc24",
                        "tools": [
                          "get_order"
