              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TelnyxErrors": {
        "properties": {
