{
  "components": {
    "responses": {
      "ValidationErrorResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10015",
                  "detail": "subject can't be blank",
                  "source": {
                    "pointer": "/data/attributes/subject"
                  },
                  "title": "Validation Failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Validation Failed (10015) or changeset validation error."
      },
      "email_NotFoundResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10001",
                  "detail": "The requested resource was not found",
                  "title": "Not Found"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Resource not found (10001)."
      },
      "email_UnauthorizedResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10006",
                  "detail": "Invalid API key",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10006"
                  },
                  "title": "Not authorized"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "Not authorized (10006)."
      }
    },
    "schemas": {
      "ErrorObject": {
        "properties": {
          "code": {
            "description": "Telnyx error code. Send admission errors include account daily quota 10011 and sender-domain ramp code domain_graduation_limit_exceeded. Edge idempotency errors use 10027 or 10036. Fallback 404/500 responses from the framework may use string status codes ('404', '500') instead.",
            "enum": [
              "10001",
              "10006",
              "10007",
              "10011",
              "10015",
              "10016",
              "10019",
              "domain_graduation_limit_exceeded",
              "recipient_suppressed",
              "reputation_suspended",
              "404",
              "500",
              "10027",
              "10036"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable error detail. Changeset responses may return a structured object.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "meta": {
            "additionalProperties": true,
            "description": "Additional metadata. Present on 401 errors with a documentation URL.",
            "nullable": true,
            "type": "object"
          },
          "source": {
            "additionalProperties": true,
            "nullable": true,
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "InboundEmailAddress": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "InboundThread": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "inbox_id": {
            "format": "uuid",
            "type": "string"
          },
          "labels": {
            "description": "Mutable thread labels used for agent workflow state. Independent of the labels on the thread's messages, and distinct from the send-time `tags` on outbound messages.",
            "items": {
              "maxLength": 255,
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "last_message_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_message_id": {
            "format": "uuid",
            "type": "string"
          },
          "message_count": {
            "description": "Total inbound and outbound messages in the thread.",
            "minimum": 1,
            "type": "integer"
          },
          "preview": {
            "maxLength": 200,
            "nullable": true,
            "type": "string"
          },
          "record_type": {
            "enum": [
              "email_thread"
            ],
            "type": "string"
          },
          "subject": {
            "nullable": true,
            "type": "string"
          },
          "unread_count": {
            "description": "Unread inbound messages; outbound messages never increment this count.",
            "minimum": 0,
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "record_type",
          "inbox_id",
          "subject",
          "preview",
          "message_count",
          "unread_count",
          "last_message_id",
          "last_message_at",
          "created_at",
          "updated_at",
          "labels"
        ],
        "type": "object"
      },
      "InboundThreadDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/InboundThread"
          },
          {
            "properties": {
              "messages": {
                "items": {
                  "$ref": "#/components/schemas/ThreadMessage"
                },
                "type": "array"
              }
            },
            "required": [
              "messages"
            ],
            "type": "object"
          }
        ]
      },
      "InboundThreadListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/InboundThread"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/email_PaginationMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "SuppressedRecipient": {
        "properties": {
          "override_allowed": {
            "description": "Whether an authorized send may override this suppression.",
            "type": "boolean"
          },
          "reason": {
            "description": "Suppression reason returned by the recipient suppression service.",
            "type": "string"
          },
          "scope": {
            "description": "Scope at which the suppression applies.",
            "type": "string"
          },
          "to": {
            "description": "Suppressed recipient email address.",
            "format": "email",
            "type": "string"
          }
        },
        "required": [
          "to",
          "reason",
          "scope",
          "override_allowed"
        ],
        "type": "object"
      },
      "ThreadMessage": {
        "properties": {
          "attachments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "bcc": {
            "items": {
              "$ref": "#/components/schemas/InboundEmailAddress"
            },
            "type": "array"
          },
          "cc": {
            "items": {
              "$ref": "#/components/schemas/InboundEmailAddress"
            },
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound"
            ],
            "type": "string"
          },
          "from": {
            "$ref": "#/components/schemas/InboundEmailAddress"
          },
          "has_quoted_text": {
            "description": "Whether conservative plain-text extraction detected a quoted tail. False does not prove that the source contains no quoted content.",
            "type": "boolean"
          },
          "headers": {
            "additionalProperties": true,
            "type": "object"
          },
          "html_body_url": {
            "description": "URL for an offloaded HTML body. Null means the body is not offloaded to a URL; an inline HTML body may still exist but is not returned on list reads. Reply extraction uses only the plain-text body during ingest.",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "in_reply_to": {
            "nullable": true,
            "type": "string"
          },
          "inbox_id": {
            "format": "uuid",
            "type": "string"
          },
          "inline_files": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "labels": {
            "description": "Mutable message labels used for agent workflow state (for example `spam`, `needs_review`, `processed`). Distinct from the immutable send-time `tags` on outbound messages: labels are never propagated to Email Detail Records or Mission Control reporting. Always empty for outbound messages. Labels on a message are independent of the labels on its thread.",
            "items": {
              "maxLength": 255,
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "message_id": {
            "description": "RFC Message-ID header. Null is possible for legacy outbound messages.",
            "nullable": true,
            "type": "string"
          },
          "read_at": {
            "description": "Time the inbound message was marked read. Null means unread.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "received_at": {
            "description": "Receipt time for inbound messages; null for outbound messages.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "record_type": {
            "enum": [
              "email_message"
            ],
            "type": "string"
          },
          "references": {
            "description": "Ordered RFC Message-ID values from the References header.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reply_text": {
            "description": "Conservatively extracted new-reply content persisted from the plain-text body during ingest. Null means no plain-text extraction input was available or extraction was skipped or failed; HTML bodies are not parsed.",
            "nullable": true,
            "type": "string"
          },
          "reply_to": {
            "items": {
              "$ref": "#/components/schemas/InboundEmailAddress"
            },
            "type": "array"
          },
          "sent_at": {
            "description": "Creation/send-acceptance time for outbound messages; null for inbound messages.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "description": "Received for inbound messages; the current send status for outbound messages.",
            "type": "string"
          },
          "subject": {
            "nullable": true,
            "type": "string"
          },
          "text_body_url": {
            "description": "URL for an offloaded plain-text body. Null means the body is not offloaded to a URL; an inline plain-text body may still exist but is not returned on list reads. `reply_text` and `has_quoted_text` are persisted during ingest before any body offload.",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "thread_id": {
            "format": "uuid",
            "type": "string"
          },
          "to": {
            "items": {
              "$ref": "#/components/schemas/InboundEmailAddress"
            },
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "record_type",
          "direction",
          "status",
          "inbox_id",
          "thread_id",
          "message_id",
          "in_reply_to",
          "references",
          "from",
          "to",
          "cc",
          "bcc",
          "reply_to",
          "subject",
          "text_body_url",
          "html_body_url",
          "reply_text",
          "has_quoted_text",
          "headers",
          "inline_files",
          "attachments",
          "labels",
          "read_at",
          "received_at",
          "sent_at",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "email_ErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorObject"
            },
            "type": "array"
          },
          "suppressed": {
            "description": "Present when every recipient is suppressed, so the request is rejected and no message is created.",
            "items": {
              "$ref": "#/components/schemas/SuppressedRecipient"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "email_PaginationMeta": {
        "properties": {
          "page_cursor": {
            "description": "Cursor for the next page, when more results are available.",
            "type": "string"
          },
          "page_size": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "page_size"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
