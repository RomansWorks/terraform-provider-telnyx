{
  "components": {
    "headers": {
      "IdempotentReplayed": {
        "description": "Present with value `true` when Edge replayed a stored successful response for the supplied Idempotency-Key. Omitted for first-time requests and error responses.",
        "schema": {
          "enum": [
            true
          ],
          "example": true,
          "type": "boolean"
        }
      }
    },
    "parameters": {
      "telephony-credentials_IdempotencyKey": {
        "description": "Unique key for safely retrying the same logical request. Generate a UUID v4 for each operation and reuse it only when retrying that operation with the same request body. Valid characters: A-Z, a-z, 0-9, -, and _. Length: 1-255 characters. Do not include sensitive data in the key.",
        "example": "8e03978e-40d5-43e8-bc93-6894a57f9326",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]{1,255}$",
          "type": "string"
        }
      }
    },
    "responses": {
      "IdempotencyConflictResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10036",
                  "detail": "A request with this Idempotency-Key is already being processed.",
                  "source": {
                    "pointer": "/header/Idempotency-Key"
                  },
                  "title": "Resource is being processed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/email_ErrorResponse"
            }
          }
        },
        "description": "A request with the same Idempotency-Key is still being processed (10036). Retry later with the same key and request."
      }
    },
    "schemas": {
      "ErrorObject": {
        "properties": {
          "code": {
            "description": "Telnyx error code. Send admission errors include account daily quota 10011 and sender-domain ramp code domain_graduation_limit_exceeded. Edge idempotency errors use 10027 or 10036. Fallback 404/500 responses from the framework may use string status codes ('404', '500') instead.",
            "enum": [
              "10001",
              "10006",
              "10007",
              "10011",
              "10015",
              "10016",
              "10019",
              "domain_graduation_limit_exceeded",
              "recipient_suppressed",
              "reputation_suspended",
              "404",
              "500",
              "10027",
              "10036"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable error detail. Changeset responses may return a structured object.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "meta": {
            "additionalProperties": true,
            "description": "Additional metadata. Present on 401 errors with a documentation URL.",
            "nullable": true,
            "type": "object"
          },
          "source": {
            "additionalProperties": true,
            "nullable": true,
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "SuppressedRecipient": {
        "properties": {
          "override_allowed": {
            "description": "Whether an authorized send may override this suppression.",
            "type": "boolean"
          },
          "reason": {
            "description": "Suppression reason returned by the recipient suppression service.",
            "type": "string"
          },
          "scope": {
            "description": "Scope at which the suppression applies.",
            "type": "string"
          },
          "to": {
            "description": "Suppressed recipient email address.",
            "format": "email",
            "type": "string"
          }
        },
        "required": [
          "to",
          "reason",
          "scope",
          "override_allowed"
        ],
        "type": "object"
      },
      "TokenMaterial": {
        "description": "What a server needs to mint login tokens for the credential itself, with no request per token (`TelephonyCredential#to_jwt` in telnyx-ruby 3.1.0 or later). As sensitive as `sip_password`: keep it on the server.",
        "properties": {
          "kid": {
            "description": "Identifies the Telnyx signing key the `signing_secret` was derived with. Goes in the token header.",
            "example": "v1",
            "type": "string"
          },
          "signing_secret": {
            "description": "The HMAC-SHA256 key the token is signed with, base64url without padding.",
            "example": "cCL985ACi7wpbe_2xh1VDF3NabPJ90u1wCKmJCPNpxw",
            "type": "string"
          },
          "tel_token": {
            "description": "Opaque value Telnyx uses to resolve the credential. Carried in the token's `tel_token` claim as is.",
            "example": "rj_ZkkZUOZMxZOfOmLpEUB3siU7u6RjZFeM9s-gb_xCR56WFKFAJiMyF2T6CBRmlh_Sy0i_lfyT9AI8sEif8MTIIszyzSl_aDnG48aO50yaHGuRSYbUbSYm9WIiQ0g==",
            "type": "string"
          }
        },
        "title": "Token Material",
        "type": "object"
      },
      "email_ErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorObject"
            },
            "type": "array"
          },
          "suppressed": {
            "description": "Present when every recipient is suppressed, so the request is rejected and no message is created.",
            "items": {
              "$ref": "#/components/schemas/SuppressedRecipient"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "telephony-credentials_ErrorObject": {
        "properties": {
          "code": {
            "description": "Telnyx error code. Edge idempotency errors use 10027 or 10036. Fallback 404/500 responses from the framework may use string status codes ('404', '500') instead.",
            "enum": [
              "10015",
              "10016",
              "10027",
              "10036",
              "404",
              "500"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "properties": {
              "pointer": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title"
        ],
        "type": "object"
      },
      "telephony-credentials_ErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/telephony-credentials_ErrorObject"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/telephony_credentials/{id}/token": {
      "post": {
        "description": "Create an Access Token (JWT) for the credential.",
        "operationId": "CreateTelephonyCredentialToken",
        "parameters": [
          {
            "description": "Identifies the resource.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/telephony-credentials_IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "text/plain": {
                "schema": {
                  "example": "eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9..gNEwzTow5MLLPLQENytca7pUN79PmPj6FyqZWW06ZeEmesxYpwKh0xRtA0TzLh6CDYIRHrI8seofOO0YFGDhpQ",
                  "type": "string"
                }
              }
            },
            "description": "JWT",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/telephony-credentials_ErrorResponse"
                }
              }
            },
            "description": "Bad Request / Validation Failed (10015). Invalid, duplicate, empty, malformed, or overlong Idempotency-Key headers are rejected by Edge with HTTP 400 and error code 10015."
          },
          "404": {
            "description": "Resource not Found"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflictResponse"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/telephony-credentials_ErrorResponse"
                }
              }
            },
            "description": "Validation failed. Reusing an Idempotency-Key with a different request also returns 422 (10027)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/telephony-credentials_ErrorResponse"
                }
              }
            },
            "description": "Service unavailable (10016), including unavailable Edge idempotency protection for a keyed request."
          }
        },
        "summary": "Create an Access Token.",
        "tags": [
          "Access Tokens"
        ]
      }
    },
    "/telephony_credentials/{id}/token_material": {
      "get": {
        "description": "Returns the material a server needs to mint login tokens for the credential locally, with no request per token: `kid`, `tel_token` and `signing_secret`. The same material is in the response of `POST /telephony_credentials`. Treat it like the SIP password.",
        "operationId": "RetrieveTelephonyCredentialTokenMaterial",
        "parameters": [
          {
            "description": "Identifies the resource.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TokenMaterial"
                    }
                  },
                  "title": "Token Material Response",
                  "type": "object"
                }
              }
            },
            "description": "Token material for the credential"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/telephony-credentials_ErrorResponse"
                }
              }
            },
            "description": "The credential is expired"
          }
        },
        "summary": "Retrieve token material.",
        "tags": [
          "Access Tokens"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
