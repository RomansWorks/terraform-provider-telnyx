                "$ref": "#/components/schemas/AgentGatewayAwsSigV4Auth"
              }
            ]
          },
          "forwarded_headers": {
            "description": "Headers copied from the agent's request, by name.",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "name": {
            "description": "A name for the server, unique on the instance across MCP servers and APIs, regardless of case. Letters, digits, `_`, and `.`. The gateway prefixes the server's tools with it and a hyphen.",
            "pattern": "^[A-Za-z0-9_.]{1,100}$",
            "type": "string"
          },
          "open_to_every_key": {
            "default": false,
            "description": "`true` lets every key on the instance use the server, granted or not.",
            "type": "boolean"
          },
          "static_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers sent on every request.",
            "type": "object"
          },
          "tools": {
            "description": "The tools the server exposes to every key, by name. `[]` exposes every tool.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "transport": {
            "default": "http",
            "description": "`http` for Streamable HTTP, or `sse` for Server-Sent Events.",
            "enum": [
              "http",
              "sse"
            ],
            "type": "string"
          },
          "url": {
            "description": "The server's MCP endpoint, `http` or `https`.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AgentGatewayNoAuth": {
        "description": "The gateway sends no credential.",
        "properties": {
          "type": {
            "const": "none",
            "type": "string"
          }
        },
        "title": "No authentication",
        "type": "object"
      },
      "AgentGatewayOAuthClientCredentials": {
        "description": "The gateway gets its own access token with the `client_credentials` grant and sends it as a bearer token on every request, renewing it before it expires. The client ID and secret are write-only.",
        "properties": {
          "audience": {
            "description": "The token's audience, sent in the token request.",
            "type": [
              "string",
              "null"
            ]
          },
          "client_id": {
            "type": "string",
            "writeOnly": true
          },
          "client_secret": {
            "type": "string",
            "writeOnly": true
          },
          "credentials_in": {
            "default": "body",
            "description": "Whether the client ID and secret go in the token request's body or as HTTP Basic authentication.",
            "enum": [
              "body",
              "basic"
            ],
            "type": "string"
          },
          "resource": {
            "description": "The resource the token is for, sent in the token request.",
            "type": [
              "string",
              "null"
            ]
          },
          "scopes": {
            "description": "The scopes to request.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "token_url": {
            "description": "The OAuth provider's token endpoint.",
            "type": "string"
          },
          "type": {
            "const": "oauth_client_credentials",
            "type": "string"
          }
        },
        "required": [
          "type",
          "token_url",
          "client_id",
          "client_secret"
        ],
        "title": "OAuth client credentials",
        "type": "object"
      },
      "AgentGatewayPassthroughAuth": {
        "description": "The gateway forwards the agent's own `Authorization` header to the server unchanged.",
        "properties": {
          "type": {
            "const": "passthrough",
            "type": "string"
          }
        },
        "title": "Token passthrough",
        "type": "object"
      },
      "AgentGatewayShownAuth": {
        "description": "The server's outbound authentication method. Credentials are never returned.",
        "properties": {
          "type": {
            "description": "The method's `type`.",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "AgentGatewayStaticAuth": {
        "description": "A static credential the gateway sends on every request. Write-only: responses show its `type` only.",
        "properties": {
          "header": {
            "description": "A header name that replaces `X-API-Key` or `Authorization`.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "How the credential is sent: `api_key` as `X-API-Key: \u003cvalue\u003e`, `bearer_token` as `Authorization: Bearer \u003cvalue\u003e`, `basic` as `Authorization: Basic \u003cbase64 of value\u003e` with `value` in the form `user:password`, `token` as `Authorization: token \u003cvalue\u003e`, and `authorization` as `Authorization: \u003cvalue\u003e`.",
            "enum": [
              "api_key",
              "bearer_token",
              "basic",
              "token",
              "authorization"
            ],
            "type": "string"
          },
          "value": {
            "description": "The credential.",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "type",
          "value"
        ],
        "title": "API key",
        "type": "object"
      },
      "TelnyxError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "meta": {
            "properties": {
