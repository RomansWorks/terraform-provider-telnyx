                "type": "string"
              },
              "cloud_provider_region": {
                "description": "The region where your Virtual Private Cloud hosts are located.\u003cbr /\u003e\u003cbr /\u003eThe available regions can be found using the /virtual_cross_connect_regions endpoint.",
