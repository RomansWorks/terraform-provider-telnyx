  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/mcp_servers": {
      "get": {
        "description": "Returns a paginated list of the MCP servers configured on your account, with optional filtering by type or URL.",
        "operationId": "list_mcp_servers",
        "parameters": [
          {
            "description": "Filter results by type.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "title": "Type",
              "type": "string"
            }
          },
          {
            "description": "Filter results by url.",
            "in": "query",
            "name": "url",
            "required": false,
            "schema": {
              "title": "Url",
              "type": "string"
            }
          },
          {
            "description": "Number of items to return per page.",
            "in": "query",
            "name": "page[size]",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page[Size]",
              "type": "integer"
            }
          },
          {
            "description": "Page number to retrieve (1-based).",
            "in": "query",
            "name": "page[number]",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page[Number]",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [
                  {
                    "created_at": "2024-01-23T18:10:02.574Z",
                    "id": "Id",
                    "name": "Name",
                    "type": "Type",
                    "url": "Url"
                  }
                ],
                "schema": {
                  "$ref": "#/components/schemas/MCPServersListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List MCP Servers",
        "tags": [
          "MCP Servers"
        ]
      },
      "post": {
        "description": "Creates a new MCP server configuration on your account and returns the created server.",
        "operationId": "create_mcp_server",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "Name",
                "type": "Type",
                "url": "Url"
              },
              "schema": {
                "$ref": "#/components/schemas/CreateMCPServerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "created_at": "2024-01-23T18:10:02.574Z",
                  "id": "Id",
                  "name": "Name",
                  "type": "Type",
                  "url": "Url"
                },
                "schema": {
                  "$ref": "#/components/schemas/MCPServer"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inference-embedding_ErrorResponse"
                }
              }
            },
            "description": "Bad Request / Validation Failed (10015). Invalid, duplicate, empty, malformed, or overlong Idempotency-Key headers are rejected by Edge with HTTP 400 and error code 10015."
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflictResponse"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inference-embedding_ErrorResponse"
                }
              }
            },
            "description": "Payload Too Large. A request sent with an Idempotency-Key whose body exceeds the endpoint's Edge replay-protection limit (256 KB) is rejected before it reaches the service. Requests sent without the header are not subject to this limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    },
                    {
                      "$ref": "#/components/schemas/inference-embedding_ErrorResponse"
                    }
                  ]
                }
              }
            },
            "description": "Validation Error. Reusing an Idempotency-Key with a different request body also returns 422 with error code 10027."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inference-embedding_ErrorResponse"
                }
              }
            },
            "description": "Service unavailable (10016), including unavailable Edge idempotency protection for a keyed request."
          }
        },
        "summary": "Create MCP Server",
        "tags": [
          "MCP Servers"
        ]
      }
    },
    "/ai/mcp_servers/{mcp_server_id}": {
      "delete": {
        "description": "Permanently deletes the specified MCP server configuration from your account.",
        "operationId": "delete_mcp_server",
        "parameters": [
          {
            "description": "Unique identifier of the mcp server.",
            "in": "path",
            "name": "mcp_server_id",
            "required": true,
            "schema": {
              "title": "Mcp Server Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "MCP server deleted successfully. No content is returned."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inference-embedding_ErrorResponse"
                }
              }
            },
            "description": "Bad Request (10015). The MCP server cannot be deleted because it is still in use by an active assistant. A server counts as in use when it is referenced by an active assistant's live configuration or by any of its retained version snapshots — so deletion can be refused even when the assistant's current configuration (`mcp_servers`) no longer lists the server. The `detail` names the blocking assistant(s) and their IDs. Remove the server from the assistant's configuration and delete any retained assistant versions that still reference it (see DELETE /ai/assistants/{assistant_id}/versions/{version_id}), then retry."
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "string"
                      ],
                      "msg": "Message",
                      "type": "Error Type"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete MCP Server",
        "tags": [
          "MCP Servers"
        ]
      },
      "get": {
        "description": "Retrieve details for a specific MCP server.",
        "operationId": "get_mcp_server",
        "parameters": [
          {
            "description": "Unique identifier of the mcp server.",
            "in": "path",
            "name": "mcp_server_id",
            "required": true,
            "schema": {
              "title": "Mcp Server Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "created_at": "2024-01-23T18:10:02.574Z",
                  "id": "Id",
                  "name": "Name",
                  "type": "Type",
                  "url": "Url"
                },
                "schema": {
                  "$ref": "#/components/schemas/MCPServer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get MCP Server",
        "tags": [
          "MCP Servers"
        ]
      },
      "put": {
        "description": "Updates the specified MCP server's configuration and returns the updated server.",
        "operationId": "update_mcp_server",
        "parameters": [
          {
            "description": "Unique identifier of the mcp server.",
            "in": "path",
            "name": "mcp_server_id",
            "required": true,
            "schema": {
              "title": "Mcp Server Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "created_at": "2024-01-23T18:10:02.574Z",
                "id": "Id",
                "name": "Name",
                "type": "Type",
                "url": "Url"
              },
              "schema": {
                "$ref": "#/components/schemas/UpdateMCPServerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "created_at": "2024-01-23T18:10:02.574Z",
                  "id": "Id",
                  "name": "Name",
                  "type": "Type",
                  "url": "Url"
                },
                "schema": {
                  "$ref": "#/components/schemas/MCPServer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update MCP Server",
        "tags": [
          "MCP Servers"
        ]
      }
    }
  },
