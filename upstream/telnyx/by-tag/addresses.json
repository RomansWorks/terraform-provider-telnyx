    "/addresses/actions/validate": {
      "post": {
        "description": "Validates an address for emergency services.",
        "operationId": "ValidateAddress",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateAddressRequest"
              }
            }
          },
          "description": "Parameters that can be defined during address validation",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/ValidateAddressResult"
                        },
                        {
                          "properties": {
                            "result": {
                              "enum": [
                                "valid"
                              ],
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      ]
                    }
                  },
                  "title": "Validate address action response",
                  "type": "object"
                }
              }
            },
            "description": "The address passed validation. The validation result is `valid`."
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "errors_only": {
                    "description": "Address rejected before validation produces a result; data is omitted.",
                    "summary": "Validation error without a result",
                    "value": {
                      "errors": [
                        {
                          "code": "20200",
                          "detail": "The street address must contain a house number or the extended address must have a house name",
                          "meta": {
                            "url": "https://developers.telnyx.com/docs/overview/errors/20200"
                          },
                          "title": "Invalid address"
                        }
                      ]
                    }
                  },
                  "invalid_result": {
                    "description": "Completed invalid validation with suggested address fields and the generic invalid-address error.",
                    "summary": "Invalid result with errors",
                    "value": {
                      "data": {
                        "record_type": "address_validation",
                        "result": "invalid",
                        "suggested": {
                          "administrative_area": "TX",
                          "borough": "",
                          "country_code": "US",
                          "extended_address": "",
                          "latitude": null,
                          "locality": "FULSHEAR",
                          "longitude": null,
                          "neighborhood": "",
                          "postal_code": "77441",
                          "street_address": "5419 CEDAR ELM LN"
                        }
                      },
                      "errors": [
                        {
                          "code": "20200",
                          "detail": "Invalid address",
                          "meta": {
                            "url": "https://developers.telnyx.com/docs/overview/errors/20200"
                          },
                          "title": "Invalid address"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Errors"
                    },
                    {
                      "properties": {
                        "data": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/ValidateAddressResult"
                            },
                            {
                              "properties": {
                                "result": {
                                  "enum": [
                                    "invalid"
                                  ],
                                  "example": "invalid",
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            }
                          ],
                          "description": "Present when a validation result is available; omitted for errors that do not produce a validation result."
                        }
                      },
                      "type": "object"
                    }
                  ],
                  "required": [
                    "errors"
                  ],
                  "title": "Validate address failure response"
                }
              }
            },
            "description": "Address validation failed. A completed validation with an invalid result returns `data.result: invalid`, with normalized or suggested address fields in `data.suggested` when available, and a top-level `errors` array. Other validation errors can return only `errors`, without `data`. Check `errors` before accessing the optional validation result."
          }
        },
        "summary": "Validate an address",
        "tags": [
          "Addresses"
        ]
      }
