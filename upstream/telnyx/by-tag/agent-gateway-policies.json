  "openapi": "3.1.0",
  "paths": {
    "/agent_gateways/{instance_id}/policies": {
      "get": {
        "description": "Lists the instance's policies, each in its current version.",
        "operationId": "ListAgentGatewayPolicies",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "base": null,
                      "created_at": "2026-11-02T12:58:53.995000Z",
                      "description": "Mask personal data",
                      "guardrails": {
                        "add": [
                          "mask-pii"
                        ],
                        "remove": []
                      },
                      "model": null,
                      "name": "baseline",
                      "pipeline": null,
                      "updated_at": "2026-11-02T12:58:53.995000Z"
                    },
                    {
                      "base": "baseline",
                      "created_at": "2026-11-02T12:58:54.285000Z",
                      "description": null,
                      "guardrails": {
                        "add": [
                          "no-forbidden"
                        ],
                        "remove": []
                      },
                      "model": "GLM-5.3.*",
                      "name": "strict",
                      "pipeline": null,
                      "updated_at": "2026-11-02T12:58:54.285000Z"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayPolicyListResponse"
                }
              }
            },
            "description": "The instance's policies"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10005"
                      },
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "List policies",
        "tags": [
          "Agent Gateway Policies"
        ]
      },
      "post": {
        "description": "Creates a named set of guardrails. It applies from the next request on, to the requests that name it in `policies` and to those its [attachments](https://developers.telnyx.com/api-reference/agent-gateway-policy-attachments/attach-a-policy) match.",
        "operationId": "CreateAgentGatewayPolicy",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "base": {
                  "summary": "A base policy",
                  "value": {
                    "description": "Mask personal data",
                    "guardrails": {
                      "add": [
                        "mask-pii"
                      ]
                    },
                    "name": "baseline"
                  }
                },
                "inherit": {
                  "summary": "A policy that builds on it",
                  "value": {
                    "base": "baseline",
                    "guardrails": {
                      "add": [
                        "no-forbidden"
                      ]
                    },
                    "model": "GLM-5.3-Flash",
                    "name": "strict"
                  }
                },
                "pipeline": {
                  "summary": "A pipeline",
                  "value": {
                    "name": "piped",
                    "pipeline": {
                      "hook": "before_request",
                      "steps": [
                        {
                          "guardrail": "mask-pii",
                          "on_fail": "block",
                          "on_pass": "next"
                        },
                        {
                          "guardrail": "no-forbidden",
                          "message": "Not allowed.",
                          "on_fail": "respond"
                        }
                      ]
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AgentGatewayPolicyCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "base": null,
                    "created_at": "2026-11-02T12:58:53.995000Z",
                    "description": "Mask personal data",
                    "guardrails": {
                      "add": [
                        "mask-pii"
                      ],
                      "remove": []
                    },
                    "model": null,
                    "name": "baseline",
                    "pipeline": null,
                    "updated_at": "2026-11-02T12:58:53.995000Z"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayPolicyResponse"
                }
              }
            },
            "description": "The created policy"
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10013",
                      "detail": "One of the associated fields does not exist.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10013"
                      },
                      "source": {
                        "pointer": "/base"
                      },
                      "title": "Missing association"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "A name the instance already uses, or a base or guardrail it does not have"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10005"
                      },
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10027",
                      "detail": "String should match pattern '^[A-Za-z0-9_.-]{1,100}$'",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10027"
                      },
                      "source": {
                        "pointer": "/name"
                      },
                      "title": "Unprocessable Entity"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "An invalid name or pipeline"
          }
        },
        "summary": "Create a policy",
        "tags": [
          "Agent Gateway Policies"
        ]
      }
    },
    "/agent_gateways/{instance_id}/policies/{name}": {
      "delete": {
        "description": "Deletes a policy and every version of it, and returns it as it was. A policy that an attachment names, or that another policy builds on, cannot be deleted.",
        "operationId": "DeleteAgentGatewayPolicy",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "The policy's `name`.",
            "example": "strict",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
