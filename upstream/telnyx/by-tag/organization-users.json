{
  "components": {
    "parameters": {
      "FilterOrganizationUserEmail": {
        "description": "Filter by email address (partial match)",
        "in": "query",
        "name": "filter[email]",
        "schema": {
          "type": "string"
        }
      },
      "FilterOrganizationUserStatus": {
        "description": "Filter by user status",
        "in": "query",
        "name": "filter[user_status]",
