          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failed."
          }
        },
        "summary": "Remove a dedicated IP from a pool",
        "tags": [
          "IP Pools"
        ]
      }
