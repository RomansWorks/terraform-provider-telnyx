      "post": {
        "description": "Adds a check the instance runs on model and tool requests. It runs on every request when `always_on`, and otherwise on the requests that name it in `guardrails`. The instance must be `ready`; otherwise the request answers `409`.",
        "operationId": "CreateAgentGatewayGuardrail",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "code": {
                  "summary": "Custom code",
                  "value": {
                    "modes": [
                      "before_request"
                    ],
                    "name": "no-forbidden",
                    "settings": {
                      "code": "def apply_guardrail(inputs, request_data, input_type):\n    for text in inputs[\"texts\"]:\n        if \"forbidden\" in text.lower():\n            return block(\"The word forbidden is not allowed\")\n    return allow()\n"
                    },
                    "type": "custom_code"
                  }
                },
                "mask": {
                  "summary": "Mask personal data",
                  "value": {
                    "modes": [
                      "before_request"
                    ],
                    "name": "mask-pii",
                    "settings": {
                      "patterns": [
                        {
                          "action": "mask",
                          "name": "us_ssn"
                        },
                        {
                          "action": "mask",
                          "name": "email"
                        }
                      ]
                    },
                    "type": "content_filter"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AgentGatewayGuardrailCreate"
              }
            }
          },
          "required": true
        },
