{
  "components": {
    "responses": {
      "ProviderTimeout": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Provider request timed out"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "The upstream search provider timed out."
      },
      "web-search_BadRequest": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "details": {},
                "message": "Validation error"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "Invalid request — validation error or invalid parameters."
      },
      "web-search_InternalServerError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Internal server error"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "Internal server error."
      },
      "web-search_ProviderError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Provider request failed"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "The upstream search provider returned an error."
      },
      "web-search_Unauthorized": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10009",
                  "detail": "Could not find any usable credentials in the request.",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                  },
                  "title": "Authentication failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/web-search_GatewayError"
            }
          }
        },
        "description": "Unauthorized — missing or invalid API key.\n\nThe API Gateway returns this response before the request reaches the backend service. The error format follows the standard Telnyx JSON:API error envelope with `errors[]`, not the backend-level `WebSearchError` shape."
      }
    },
    "schemas": {
      "WebSearchError": {
        "properties": {
          "error": {
            "properties": {
              "details": {
                "additionalProperties": true,
                "description": "Additional error details (e.g. validation field errors).",
                "type": "object"
              },
              "message": {
                "description": "Human-readable error message.",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "WebSearchRequest": {
        "properties": {
          "count": {
            "description": "Number of results to return (1-100).",
            "example": 10,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "country": {
            "description": "Two-letter country code (ISO 3166-1 alpha-2) to bias results.",
            "example": "US",
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "exclude_domains": {
            "description": "Exclude results from these domains (bare hostnames, e.g. `pinterest.com`).",
            "example": [
              "pinterest.com"
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "freshness": {
            "description": "Time-based filter for results. Common values: `day`, `week`, `month`, `year`.",
            "example": "week",
            "maxLength": 20,
            "type": "string"
          },
          "include_domains": {
            "description": "Restrict results to these domains (bare hostnames, e.g. `arxiv.org`).",
            "example": [
              "arxiv.org",
              "github.com"
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "livecrawl": {
            "description": "When true, the provider crawls pages in real-time for fresh content. The boolean is translated to the provider's internal enum internally; callers always pass `true` or `false`.",
            "example": false,
            "type": "boolean"
          },
          "query": {
            "description": "The search query text.",
            "example": "latest AI agent frameworks",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "safesearch": {
            "description": "Safe search filter level.",
            "enum": [
              "off",
              "moderate",
              "strict"
            ],
            "example": "moderate",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "WebSearchResponse": {
        "properties": {
          "results": {
            "properties": {
              "news": {
                "description": "News search results. Present only when the query surfaces news results.",
                "items": {
                  "$ref": "#/components/schemas/WebSearchResult"
                },
                "type": "array"
              },
              "web": {
                "description": "Web search results.",
                "items": {
                  "$ref": "#/components/schemas/WebSearchResult"
                },
                "type": "array"
              }
            },
            "required": [
              "web"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "WebSearchResult": {
        "properties": {
          "description": {
            "description": "Short description or excerpt.",
            "type": "string"
          },
          "favicon_url": {
            "description": "Favicon URL (if available).",
            "format": "uri",
            "type": "string"
          },
          "snippets": {
            "description": "Relevant text snippets from the page.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "thumbnail_url": {
            "description": "Thumbnail image URL (if available).",
            "format": "uri",
            "type": "string"
          },
          "title": {
            "description": "Result title.",
            "type": "string"
          },
          "url": {
            "description": "Result URL.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "description",
          "snippets"
        ],
        "type": "object"
      },
      "web-search_GatewayError": {
        "description": "Standard Telnyx JSON:API error envelope returned by the API Gateway for authentication failures (401).",
        "properties": {
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "description": "Telnyx error code.",
                  "type": "string"
                },
                "detail": {
                  "description": "Human-readable error detail.",
                  "type": "string"
                },
                "meta": {
                  "properties": {
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "source": {
                  "properties": {
                    "pointer": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "title": {
                  "description": "Error title.",
                  "type": "string"
                }
              },
              "required": [
                "code",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/web_search": {
      "post": {
        "description": "Performs a real-time web search and returns structured, LLM-ready JSON results with titles, URLs, descriptions, and snippets. Supports filtering by domain, country, safe search, freshness, and live crawl.\n\n**Note:** `include_domains` and `exclude_domains` cannot be used in the same request. Use one or the other.",
        "operationId": "CreateWebSearch",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "count": 10,
                "country": "US",
                "freshness": "week",
                "include_domains": [
                  "arxiv.org",
                  "github.com"
                ],
                "livecrawl": false,
                "query": "latest AI agent frameworks",
                "safesearch": "moderate"
              },
              "schema": {
                "$ref": "#/components/schemas/WebSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "results": {
                      "news": [],
                      "web": [
                        {
                          "description": "A comprehensive guide to the latest AI agent frameworks...",
                          "favicon_url": "https://cdn.telnyx.com/favicon?domain=example.com\u0026size=128",
                          "snippets": [
                            "LangGraph is a framework for building stateful, multi-actor agents..."
                          ],
                          "thumbnail_url": "https://example.com/thumb.jpg",
                          "title": "Top AI Agent Frameworks in 2026",
                          "url": "https://example.com/article"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WebSearchResponse"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful search response."
          },
          "400": {
            "$ref": "#/components/responses/web-search_BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/web-search_Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/web-search_InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/web-search_ProviderError"
          },
          "504": {
            "$ref": "#/components/responses/ProviderTimeout"
          }
        },
        "summary": "Web search",
        "tags": [
          "Web Search"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
