  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/ingest": {
      "post": {
        "description": "Store a session. Facts are extracted from whatever you send — the body is taken as any JSON value and stored whole, so a framework's own transcript shape works unchanged. `messages` of `role`/`content` is the conventional shape, not a requirement. An empty object or a null body is refused. Carry a `session_id` to name the session: re-ingesting the same one replaces what it held. Omit it and a session is opened and returned. Extraction runs asynchronously — poll the returned operation.",
        "operationId": "IngestSession",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "title": "Namespace",
              "type": "string"
            }
          },
          {
            "description": "Names the session. Re-ingesting the same session replaces what it held and keeps its `source_id`. Omit it to have one derived from the content and returned. No whitespace, control characters, or any of / \\ # ? %.",
            "in": "query",
            "name": "session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Names the session. Re-ingesting the same session replaces what it held and keeps its `source_id`. Omit it to have one derived from the content and returned. No whitespace, control characters, or any of / \\ # ? %.",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "new_session": {
                  "summary": "A new session, opened for you",
                  "value": {
                    "messages": [
                      {
                        "content": "I prefer email.",
                        "role": "user"
                      }
                    ]
                  }
                },
                "session": {
                  "summary": "A session you name",
                  "value": {
                    "messages": [
                      {
                        "content": "Invoices go to 220 W Chicago Ave now.",
                        "role": "user"
                      },
                      {
                        "content": "Got it.",
                        "role": "assistant"
                      }
                    ]
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/IngestPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "operation_id": "op_01HZY4M7Q9",
                    "profile_id": "caller:+13128675309",
                    "session_id": "conv_8901",
                    "source_id": "b1e6c0a2-4f3d-4a2e-9c7b-8e1f2a3b4c5d"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "Could not find any usable credentials in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "source": {
                        "pointer": "/"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "namespace_not_found",
                      "detail": "no such namespace"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The namespace does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "empty_payload",
                      "detail": "payload must carry something to remember"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "upstream_error",
                      "detail": "the memory dataplane is unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Upstream error"
          }
        },
        "summary": "Ingest a session's messages into a profile",
        "tags": [
          "Memory"
        ]
      }
    },
    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/recall": {
      "post": {
        "description": "Ranked memories for a question. Matching runs over the profile's memories and returns them in rank order with a relevance `score`; the score is null where the deployment's reranker is a passthrough, in which case order is the only signal. No model runs in this path — recall returns facts, it does not compose an answer.",
        "operationId": "RecallMemories",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "title": "Namespace",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "query": "where do invoices go?",
                "top_k": 5
              },
              "schema": {
                "$ref": "#/components/schemas/RecallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "id": "mem_01HZY4",
                      "recorded_at": "2026-08-26T21:14:11Z",
                      "score": 0.82,
                      "text": "Invoices go to 220 W Chicago Ave."
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/RecallResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "Could not find any usable credentials in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "source": {
                        "pointer": "/"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "namespace_not_found",
                      "detail": "no such namespace"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The namespace does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "invalid_request",
                      "detail": "body.query: String should have at least 1 character"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "upstream_error",
                      "detail": "the memory dataplane is unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Upstream error"
          }
        },
        "summary": "Recall a profile's memories, ranked",
        "tags": [
          "Memory"
        ]
      }
    },
    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/remember": {
      "post": {
        "description": "For a fact the agent has already distilled: `text` is stored as given, with nothing extracted from it. Send a transcript to `ingest` instead. Remembering the same text again writes the same memory rather than a second copy of it, so a retry is safe. The write runs asynchronously -- poll the returned operation.",
        "operationId": "RememberFact",
        "parameters": [
          {
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "title": "Profile Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "title": "Namespace",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "text": "Prefers window seats and flies out of ORD"
              },
              "schema": {
                "$ref": "#/components/schemas/RememberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "operation_id": "op_01HZY4M7Q9",
                    "profile_id": "caller:+13128675309",
                    "source_id": "9af23d17-2b6c-4d8e-a1f0-3c4b5d6e7f80"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RememberResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "Could not find any usable credentials in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "source": {
                        "pointer": "/"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "namespace_not_found",
                      "detail": "no such namespace"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The namespace does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "invalid_request",
                      "detail": "body.text: String should have at least 1 character"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Invalid request"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "upstream_error",
                      "detail": "the memory dataplane is unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Upstream error"
          }
        },
        "summary": "Remember one fact, stored as written",
        "tags": [
          "Memory"
