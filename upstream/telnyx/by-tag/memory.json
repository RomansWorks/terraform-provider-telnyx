{
  "components": {
    "schemas": {
      "AcceptedIngest": {
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "source_id": {
            "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "profile_id",
          "session_id",
          "source_id"
        ],
        "title": "AcceptedIngest",
        "type": "object"
      },
      "AcceptedMemory": {
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "source_id": {
            "description": "Identifies one source within its profile: an ingested session, or one remembered fact. Returned by `ingest` and `remember` when the write is accepted. Re-ingesting a session keeps its source id.",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "profile_id",
          "source_id"
        ],
        "title": "AcceptedMemory",
        "type": "object"
      },
      "IngestPayload": {
        "anyOf": [
          {
            "additionalProperties": true,
            "title": "Ingest Payload Object",
            "type": "object"
          },
          {
            "title": "Ingest Payload Value",
            "type": [
              "array",
              "string",
              "number",
              "boolean"
            ]
          }
        ],
        "description": "The session's messages, in whatever shape your framework produces. Any JSON value but null is accepted and stored whole, as long as it holds something to remember: a body with no content anywhere in it -- `{}`, `[]`, `\"\"`, `{\"messages\": []}` -- is a 422.",
        "title": "Payload"
      },
      "IngestResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AcceptedIngest"
          }
        },
        "required": [
          "data"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "PreviewSummaryRequest": {
        "description": "A candidate note to preview against one profile. The field is optional; omitting it, or sending null/empty/whitespace, previews the neutral default.",
        "properties": {
          "instructions": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The candidate note to try. `null`, empty, or whitespace-only previews the neutral default -- the summary a profile returns to when instructions are cleared. Capped at 2000 characters, the same cap `PATCH /settings` applies on save; a longer note is refused with `422` before anything is generated.",
            "title": "Instructions"
          }
        },
        "title": "PreviewSummaryRequest",
        "type": "object"
      },
      "PreviewSummaryResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PreviewedSummary"
          }
        },
        "required": [
          "data"
        ],
        "title": "PreviewSummaryResponse",
        "type": "object"
      },
      "PreviewedSummary": {
        "properties": {
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The summary this profile would carry under the candidate note. Null when nothing was generated -- the same signal `GET /summary` uses for a profile with no card yet.",
            "title": "Text"
          }
        },
        "required": [
          "profile_id",
          "text"
        ],
        "title": "PreviewedSummary",
        "type": "object"
      },
      "ProfileSummary": {
        "properties": {
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the summary was last generated. Null while none is ready.",
            "title": "Generated At"
          },
          "is_stale": {
            "description": "Whether newer memories have arrived since the summary was generated. The summary is regenerated in the background, so a true here is ordinary and the summary is still usable.",
            "title": "Is Stale",
            "type": "boolean"
          },
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The precomputed summary, ready to place in an assistant's context at the start of a session.",
            "title": "Text"
          }
        },
        "required": [
          "profile_id",
          "is_stale"
        ],
        "title": "ProfileSummary",
        "type": "object"
      },
      "RecallRequest": {
        "properties": {
          "query": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          }
        },
        "required": [
          "query"
        ],
        "title": "RecallRequest",
        "type": "object"
      },
      "RecallResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/RecalledMemory"
            },
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "title": "RecallResponse",
        "type": "object"
      },
      "RecalledMemory": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "recorded_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded At"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Relevance, 0-1. Null where the deployment's reranker is a passthrough; results are in rank order either way.",
            "title": "Score"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "RecalledMemory",
        "type": "object"
      },
      "RememberRequest": {
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "RememberRequest",
        "type": "object"
      },
      "RememberResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AcceptedMemory"
          }
        },
        "required": [
          "data"
        ],
        "title": "RememberResponse",
        "type": "object"
      },
      "SummaryResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProfileSummary"
          }
        },
        "required": [
          "data"
        ],
        "title": "SummaryResponse",
        "type": "object"
      },
      "TelnyxError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "meta": {
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "source": {
            "properties": {
              "pointer": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TelnyxErrors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/TelnyxError"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
