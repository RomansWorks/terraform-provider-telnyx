            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "Telephony Data": {
            "description": "Technical telephony and call control information",
            "example": [
              "route",
              "connection_id",
              "hangup_code",
              "pdd",
              "tags",
              "sip_call_id",
              "mos"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
