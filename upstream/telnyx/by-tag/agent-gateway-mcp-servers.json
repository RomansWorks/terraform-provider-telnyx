  "openapi": "3.1.0",
  "paths": {
    "/agent_gateways/{instance_id}/mcp_servers": {
      "get": {
        "description": "Lists the MCP servers the instance serves at `{gateway_url}/mcp`, without their credentials. The instance must be `ready`; otherwise the request answers `409`.",
        "operationId": "ListAgentGatewayMcpServers",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "auth": {
                        "type": "api_key"
                      },
                      "created_at": "2026-10-28T16:50:43.184000Z",
                      "forwarded_headers": [
                        "X-Request-Id"
                      ],
                      "id": "88d5a97b-4080-4855-8bac-a39811b1dc24",
                      "name": "orders",
                      "open_to_every_key": false,
                      "static_headers": {
                        "X-Env": "prod"
                      },
                      "tools": [],
                      "transport": "http",
                      "updated_at": "2026-10-28T16:50:43.184000Z",
                      "url": "http://10.40.3.7:9000/mcp"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayMcpServerListResponse"
                }
              }
            },
            "description": "The instance's MCP servers"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10005"
                      },
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "99901",
                      "detail": "The instance is not ready; its engine is not running.",
                      "title": "Instance not ready"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The instance is not `ready`"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "99903",
                      "detail": "The instance's engine did not answer; try again shortly.",
                      "title": "Engine unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The instance's engine did not answer"
          }
        },
        "summary": "List MCP servers",
        "tags": [
          "Agent Gateway MCP Servers"
        ]
      },
      "post": {
        "description": "Adds an MCP server. The instance serves its tools at `{gateway_url}/mcp`, each named with the server's `name` and a hyphen, to the keys granted the server and, with `open_to_every_key`, to every key. The instance must be `ready`; otherwise the request answers `409`.",
        "operationId": "CreateAgentGatewayMcpServer",
        "parameters": [
          {
            "description": "The Agent Gateway's `id`.",
            "example": "32ce035d-3165-4031-b1a7-a7c0c259590a",
            "in": "path",
            "name": "instance_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "api_key": {
                  "summary": "An API key",
                  "value": {
                    "auth": {
                      "type": "api_key",
                      "value": "example-orders-key"
                    },
                    "forwarded_headers": [
                      "X-Request-Id"
                    ],
                    "name": "orders",
                    "static_headers": {
                      "X-Env": "prod"
                    },
                    "url": "http://10.40.3.7:9000/mcp"
                  }
                },
                "aws": {
                  "summary": "AWS Signature Version 4",
                  "value": {
                    "auth": {
                      "region": "us-east-1",
                      "type": "aws_sigv4"
                    },
                    "name": "agentcore",
                    "url": "https://example.bedrock-agentcore.us-east-1.amazonaws.com/mcp"
                  }
                },
                "oauth": {
                  "summary": "OAuth client credentials",
                  "value": {
                    "auth": {
                      "client_id": "example-client",
                      "client_secret": "example-client-secret",
                      "scopes": [
                        "crm.read"
                      ],
                      "token_url": "https://auth.example.com/oauth/token",
                      "type": "oauth_client_credentials"
                    },
                    "name": "crm",
                    "url": "https://crm.example.com/mcp"
                  }
                },
                "passthrough": {
                  "summary": "Token passthrough",
                  "value": {
                    "auth": {
                      "type": "passthrough"
                    },
                    "name": "github",
                    "url": "https://api.githubcopilot.com/mcp/"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AgentGatewayMcpServerCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "auth": {
                      "type": "api_key"
                    },
                    "created_at": "2026-10-28T16:50:43.184000Z",
                    "forwarded_headers": [
                      "X-Request-Id"
                    ],
                    "id": "88d5a97b-4080-4855-8bac-a39811b1dc24",
                    "name": "orders",
                    "open_to_every_key": false,
                    "static_headers": {
                      "X-Env": "prod"
                    },
                    "tools": [],
                    "transport": "http",
                    "updated_at": "2026-10-28T16:50:43.184000Z",
                    "url": "http://10.40.3.7:9000/mcp"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayMcpServerResponse"
                }
              }
            },
            "description": "The added MCP server"
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
