        },
        "type": "object"
      },
      "WirelessRate": {
        "properties": {
          "amount": {
            "description": "Rate from which cost is calculated",
            "example": "0.1",
            "type": "string"
          },
          "currency": {
            "description": "Currency of the rate and cost",
            "enum": [
              "AUD",
              "CAD",
              "EUR",
              "GBP",
              "USD"
            ],
            "example": "USD",
            "type": "string"
          }
        },
