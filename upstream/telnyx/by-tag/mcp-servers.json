      },
      "inference-embedding_ErrorObject": {
        "properties": {
          "code": {
            "description": "Telnyx error code. Edge idempotency errors use 10015, 10027, or 10036; idempotency protection outages use 10016; replay-cap 413s surface 10007. Fallback 404/500 responses from the framework may use string status codes ('404', '500') instead.",
            "enum": [
              "10007",
              "10015",
              "10016",
              "10027",
              "10036",
              "404",
              "500"
            ],
            "type": "string"
