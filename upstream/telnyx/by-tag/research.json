{
  "components": {
    "responses": {
      "ProviderTimeout": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Provider request timed out"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "The upstream search provider timed out."
      },
      "web-search_BadRequest": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "details": {},
                "message": "Validation error"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "Invalid request — validation error or invalid parameters."
      },
      "web-search_InternalServerError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Internal server error"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "Internal server error."
      },
      "web-search_NotFound": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Task not found"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "Research task not found. Returned for unknown, malformed, expired, or already-purged task IDs."
      },
      "web-search_ProviderError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "message": "Provider request failed"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/WebSearchError"
            }
          }
        },
        "description": "The upstream search provider returned an error."
      },
      "web-search_Unauthorized": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10009",
                  "detail": "Could not find any usable credentials in the request.",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                  },
                  "title": "Authentication failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/web-search_GatewayError"
            }
          }
        },
        "description": "Unauthorized — missing or invalid API key.\n\nThe API Gateway returns this response before the request reaches the backend service. The error format follows the standard Telnyx JSON:API error envelope with `errors[]`, not the backend-level `WebSearchError` shape."
      }
    },
    "schemas": {
      "ResearchCitation": {
        "properties": {
          "snippet": {
            "description": "Relevant excerpt from the source (if available).",
            "type": "string"
          },
          "title": {
            "description": "Title of the source page.",
            "type": "string"
          },
          "url": {
            "description": "Source URL.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title"
        ],
        "type": "object"
      },
      "ResearchRequest": {
        "properties": {
          "background": {
            "description": "When `true`, the research runs asynchronously. The response returns a `task_id` immediately instead of waiting for the result. Poll `GET /web_search/research/{task_id}` to check status.",
            "example": false,
            "type": "boolean"
          },
          "max_sources": {
            "description": "Maximum number of sources to use.",
            "example": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "The research question or topic.",
            "example": "Compare the performance of RAG vs fine-tuning for domain-specific QA",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "research_effort": {
            "description": "Research depth level. `lite` is fastest, `deep` is most thorough.",
            "enum": [
              "lite",
              "standard",
              "deep"
            ],
            "example": "standard",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "ResearchResponseAsync": {
        "description": "Asynchronous research response (when `background` is true).",
        "properties": {
          "status": {
            "description": "Current status of the research task.",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ],
            "example": "pending",
            "type": "string"
          },
          "task_id": {
            "description": "Unique identifier for the research task. Use this to poll the status.",
            "example": "bf3026a5-dd57-44dd-b922-200041be3a4b",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "status"
        ],
        "type": "object"
      },
      "ResearchResponseSync": {
        "description": "Synchronous research response (when `background` is false or unset).",
        "properties": {
          "answer": {
            "description": "The synthesized research answer.",
            "example": "RAG and fine-tuning serve different purposes...",
            "type": "string"
          },
          "citations": {
            "description": "Sources cited in the answer.",
            "items": {
              "$ref": "#/components/schemas/ResearchCitation"
            },
            "type": "array"
          }
        },
        "required": [
          "answer"
        ],
        "type": "object"
      },
      "ResearchTaskStatus": {
        "properties": {
          "answer": {
            "description": "The synthesized research answer (present when status is `completed`).",
            "type": "string"
          },
          "citations": {
            "description": "Sources cited in the answer (present when status is `completed`).",
            "items": {
              "$ref": "#/components/schemas/ResearchCitation"
            },
            "type": "array"
          },
          "error": {
            "description": "Always present in poll responses; `null` unless the task failed.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "Current status of the research task.",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ],
            "type": "string"
          },
          "task_id": {
            "description": "The research task identifier.",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "status"
        ],
        "type": "object"
      },
      "WebSearchError": {
        "properties": {
          "error": {
            "properties": {
              "details": {
                "additionalProperties": true,
                "description": "Additional error details (e.g. validation field errors).",
                "type": "object"
              },
              "message": {
                "description": "Human-readable error message.",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "web-search_GatewayError": {
        "description": "Standard Telnyx JSON:API error envelope returned by the API Gateway for authentication failures (401).",
        "properties": {
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "description": "Telnyx error code.",
                  "type": "string"
                },
                "detail": {
                  "description": "Human-readable error detail.",
                  "type": "string"
                },
                "meta": {
                  "properties": {
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "source": {
                  "properties": {
                    "pointer": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "title": {
                  "description": "Error title.",
                  "type": "string"
                }
              },
              "required": [
                "code",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/web_search/research": {
      "post": {
        "description": "Starts a deep research task that runs multiple searches, reads sources, and synthesizes an answer with citations.\n\n## Synchronous mode (default)\n\nWhen `background` is `false` or omitted, the request blocks until the research completes and returns the answer with citations. This can take up to 120 seconds depending on `research_effort`.\n\n## Asynchronous mode\n\nWhen `background` is `true`, the request returns immediately with a `task_id` and `status: pending`. Poll `GET /web_search/research/{task_id}` to check when the research completes and retrieve the answer.",
        "operationId": "CreateWebSearchResearch",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "background": false,
                "max_sources": 20,
                "query": "Compare the performance of RAG vs fine-tuning for domain-specific QA",
                "research_effort": "standard"
              },
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "async": {
                    "summary": "Asynchronous response (background=true)",
                    "value": {
                      "data": {
                        "status": "pending",
                        "task_id": "bf3026a5-dd57-44dd-b922-200041be3a4b"
                      }
                    }
                  },
                  "sync": {
                    "summary": "Synchronous response (background=false)",
                    "value": {
                      "data": {
                        "answer": "RAG and fine-tuning serve different purposes...",
                        "citations": [
                          {
                            "snippet": "We show that RAG models produce more factually grounded responses...",
                            "title": "Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks",
                            "url": "https://arxiv.org/abs/2401.15884"
                          }
                        ]
                      }
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ResearchResponseSync"
                        },
                        {
                          "$ref": "#/components/schemas/ResearchResponseAsync"
                        }
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Research response. Shape depends on `background`:\n\n- **Synchronous** (`background` false/unset): returns `answer` + `citations`.\n- **Asynchronous** (`background` true): returns `task_id` + `status`."
          },
          "400": {
            "$ref": "#/components/responses/web-search_BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/web-search_Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/web-search_InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/web-search_ProviderError"
          },
          "504": {
            "$ref": "#/components/responses/ProviderTimeout"
          }
        },
        "summary": "Start research task",
        "tags": [
          "Research"
        ]
      }
    },
    "/web_search/research/{task_id}": {
      "get": {
        "description": "Polls the status of a previously started asynchronous research task. When the status is `completed`, the response includes the answer and citations. When the status is `failed`, the response includes an error message.",
        "operationId": "GetWebSearchResearchStatus",
        "parameters": [
          {
            "description": "The research task ID returned by `POST /web_search/research` with `background: true`.",
            "example": "bf3026a5-dd57-44dd-b922-200041be3a4b",
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "completed": {
                    "summary": "Task completed",
                    "value": {
                      "data": {
                        "answer": "RAG and fine-tuning serve different purposes...",
                        "citations": [
                          {
                            "title": "Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks",
                            "url": "https://arxiv.org/abs/2401.15884"
                          }
                        ],
                        "status": "completed",
                        "task_id": "bf3026a5-dd57-44dd-b922-200041be3a4b"
                      }
                    }
                  },
                  "failed": {
                    "summary": "Task failed",
                    "value": {
                      "data": {
                        "error": "Provider request failed",
                        "status": "failed",
                        "task_id": "bf3026a5-dd57-44dd-b922-200041be3a4b"
                      }
                    }
                  },
                  "running": {
                    "summary": "Task still running",
                    "value": {
                      "data": {
                        "status": "running",
                        "task_id": "bf3026a5-dd57-44dd-b922-200041be3a4b"
                      }
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ResearchTaskStatus"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Research task status."
          },
          "401": {
            "$ref": "#/components/responses/web-search_Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/web-search_NotFound"
          },
          "500": {
            "$ref": "#/components/responses/web-search_InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/web-search_ProviderError"
          }
        },
        "summary": "Get research task status",
        "tags": [
          "Research"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
