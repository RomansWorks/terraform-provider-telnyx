        "type": "boolean"
      },
      "T38Enabled": {
        "default": true,
        "description": "The flag to disable the T.38 protocol.",
        "type": "boolean"
      },
      "To": {
        "description": "The phone number, in E.164 format, the fax will be sent to or SIP URI",
        "example": "+13127367276",
        "type": "string"
      }
