    "/email_blocks/export": {
      "get": {
        "description": "Streams the account's suppressions as a chunked CSV (server-side\ncursor; never materialized). Content-type `text/csv`, header\n`Content-Disposition: attachment; filename=\"email_blocks_export.csv\"`.\n\nFilters (`filter[reason]`, `filter[domain_id]`,\n`filter[created_after]`, `filter[created_before]`) are the only\nparams that affect output. `sort` and `page[*]` are **parsed**\n(bad values still produce `400`) but **ignored** — rows stream\n`ORDER BY created_at ASC, id ASC` with no pagination.\n\nCSV columns: `id,to,from,reason,source,scope,status,domain_id,\ncreated_at,updated_at,expires_at,group_id,bounce_category,dsn_code,\nmeta` (15 columns). The first 12 columns are the stable native\nsignature; `bounce_category`, `dsn_code`, and `meta` are optional\nbackup fields (empty when unset). The CSV carries the `group_id`\ncolumn so group-scoped suppressions' group link survives the\nexport (empty for account-scope rows).\n",
        "operationId": "exportEmailBlocks",
        "parameters": [
          {
            "$ref": "#/components/parameters/SortEmailBlocks"
          },
          {
            "$ref": "#/components/parameters/BlocksPageNumber"
          },
          {
            "$ref": "#/components/parameters/BlocksPageSize"
          },
          {
            "$ref": "#/components/parameters/FilterReason"
          },
          {
            "$ref": "#/components/parameters/FilterDomainId"
          },
          {
            "$ref": "#/components/parameters/FilterCreatedAfter"
          },
          {
            "$ref": "#/components/parameters/FilterCreatedBefore"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "example": "string",
                "schema": {
                  "description": "CSV with header row `id,to,from,reason,source,scope,status,domain_id,created_at,updated_at,expires_at,group_id,bounce_category,dsn_code,meta`.",
                  "type": "string"
                }
              }
            },
            "description": "CSV stream."
          },
          "400": {
            "$ref": "#/components/responses/ValidationErrorQuery"
          },
          "401": {
            "$ref": "#/components/responses/email_Unauthorized"
          },
          "406": {
            "$ref": "#/components/responses/FrameworkError"
          }
        },
        "summary": "Export suppressions as CSV",
        "tags": [
          "Email Suppressions"
        ]
      }
    },
    "/email_blocks/{id}": {
      "delete": {
        "description": "Soft-deletes (status → `removed`; tombstone retained). A `removed`\naudit event is appended unless the block was already `removed`\n(idempotent — returns the existing row with `200` and no new event).\nMutates `updated_at`.\n",
        "operationId": "deleteEmailBlock",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
