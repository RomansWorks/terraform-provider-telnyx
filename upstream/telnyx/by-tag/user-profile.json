{
  "components": {
    "schemas": {
      "UpdateUserProfileRequest": {
        "description": "Profile fields to update. Omitted fields retain their current values.",
        "example": {
          "first_name": "Alex",
          "last_name": "Taylor",
          "ui_theme": 1
        },
        "properties": {
          "address_1": {
            "description": "First line of the profile address.",
            "example": "123 Example Street",
            "type": [
              "string",
              "null"
            ]
          },
          "address_2": {
            "description": "Second line of the profile address.",
            "example": "Suite 100",
            "type": [
              "string",
              "null"
            ]
          },
          "business_name": {
            "description": "Business name associated with the profile.",
            "example": "Example Company",
            "maxLength": 255,
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "description": "City in the profile address.",
            "example": "Chicago",
            "type": [
              "string",
              "null"
            ]
          },
          "company_size": {
            "description": "Company size reported by the user.",
