{
  "components": {
    "parameters": {
      "PageConsolidated": {
        "description": "Consolidated page parameter (deepObject style). Originally: page[number], page[size]",
        "explode": true,
        "in": "query",
        "name": "page",
        "schema": {
          "properties": {
            "number": {
              "default": 1,
              "description": "The page number to load",
              "minimum": 1,
              "type": "integer"
            },
            "size": {
              "default": 20,
              "description": "The size of the page",
              "maximum": 250,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "style": "deepObject"
      },
      "WhatsappHostedSignupId": {
        "description": "Hosted signup ID returned when the hosted signup was created",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "WhatsappSignupSessionId": {
        "description": "Signup session ID",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "WhatsappHostedSignupListResponse": {
        "content": {
          "application/json": {
            "example": {
              "data": [
                {
                  "app_id": "123456789012345",
                  "created_at": "2026-07-08T12:00:00Z",
                  "expires_at": "2026-07-09T12:00:00Z",
                  "id": "0192345a-7b8c-7d9e-0f12-3456789abcde",
                  "jwt": "eyJhbGciOiJSUzI1NiIs...",
                  "record_type": "whatsapp_jwt",
                  "url": "https://acct.fyi?token=eyJhbGciOiJSUzI1NiIs..."
                }
              ],
              "meta": {
                "page_number": 1,
                "page_size": 20,
                "total_pages": 1,
                "total_results": 1
              }
            },
            "schema": {
              "properties": {
                "data": {
                  "items": {
                    "$ref": "#/components/schemas/WhatsappHostedSignup"
                  },
                  "type": "array"
                },
                "meta": {
                  "$ref": "#/components/schemas/messaging_PaginationMeta"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "Successful response with a list of WhatsApp hosted signups"
      },
      "WhatsappHostedSignupResponse": {
        "content": {
          "application/json": {
            "example": {
              "data": {
                "app_id": "123456789012345",
                "created_at": "2026-07-08T12:00:00Z",
                "expires_at": "2026-07-09T12:00:00Z",
                "id": "0192345a-7b8c-7d9e-0f12-3456789abcde",
                "jwt": "eyJhbGciOiJSUzI1NiIs...",
                "record_type": "whatsapp_jwt",
                "url": "https://acct.fyi?token=eyJhbGciOiJSUzI1NiIs..."
              }
            },
            "schema": {
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/WhatsappHostedSignup"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "Successful response with a WhatsApp hosted signup"
      },
      "WhatsappSignupSessionListResponse": {
        "content": {
          "application/json": {
            "example": {
              "data": [
                {
                  "created_at": "2026-10-01T09:58:25Z",
                  "customer_id": "acme-corp-42",
                  "errors": [
                    "[ShareCreditLine] Bad status received: Invalid parameter Credit Allocation Not Allowed During Month-End Close: This WhatsApp Business Account cannot be moved onto a credit line while the monthly billing close is running. Please try again once the close has completed, usually within the first few days of the month."
                  ],
                  "record_type": "whatsapp_session_id",
                  "session_id": "019f4253-e09a-7622-bc6f-625378711d78",
                  "state": "SHARE_CREDIT_LINE",
                  "status": "FAILURE",
                  "updated_at": "2026-10-01T09:58:27Z",
                  "user_id": "00000000-0000-4000-8000-000000000000",
                  "waba_id": "123456789012345"
                }
              ],
              "meta": {
                "page_number": 1,
                "page_size": 20,
                "total_pages": 1,
                "total_results": 1
              }
            },
            "schema": {
              "properties": {
                "data": {
                  "items": {
                    "$ref": "#/components/schemas/WhatsappSignupSession"
                  },
                  "type": "array"
                },
                "meta": {
                  "$ref": "#/components/schemas/messaging_PaginationMeta"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "Successful response with a list of WhatsApp signup sessions"
      },
      "WhatsappSignupSessionResponse": {
        "content": {
          "application/json": {
            "example": {
              "data": {
                "created_at": "2026-10-01T09:58:25Z",
                "customer_id": "acme-corp-42",
                "errors": [
                  "[ShareCreditLine] Bad status received: Invalid parameter Credit Allocation Not Allowed During Month-End Close: This WhatsApp Business Account cannot be moved onto a credit line while the monthly billing close is running. Please try again once the close has completed, usually within the first few days of the month."
                ],
                "record_type": "whatsapp_session_id",
                "session_id": "019f4253-e09a-7622-bc6f-625378711d78",
                "state": "SHARE_CREDIT_LINE",
                "status": "FAILURE",
                "updated_at": "2026-10-01T09:58:27Z",
                "user_id": "00000000-0000-4000-8000-000000000000",
                "waba_id": "123456789012345"
              }
            },
            "schema": {
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/WhatsappSignupSession"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "Successful response with a WhatsApp signup session"
      },
      "management_messaging_GenericErrorResponse": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "string",
                  "detail": "string",
                  "source": {
                    "parameter": "string",
                    "pointer": "/data/attributes/phone_number"
                  },
                  "title": "string"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/messaging_Errors"
            }
          }
        },
        "description": "Unexpected error"
      }
    },
    "schemas": {
      "WhatsappHostedSignup": {
        "properties": {
          "app_id": {
            "description": "Meta App ID the hosted signup onboards customers into",
            "example": "123456789012345",
            "type": "string"
          },
          "created_at": {
            "example": "2026-07-08T12:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "description": "When the onboarding URL stops working",
            "example": "2026-07-09T12:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Hosted signup ID",
            "example": "0192345a-7b8c-7d9e-0f12-3456789abcde",
            "type": "string"
          },
          "jwt": {
            "description": "Signed token embedded in `url`",
            "example": "eyJhbGciOiJSUzI1NiIs...",
            "type": "string"
          },
          "record_type": {
            "enum": [
              "whatsapp_jwt"
            ],
            "example": "whatsapp_jwt",
            "type": "string"
          },
          "solution_id": {
            "description": "Meta Partner Solution ID linked to the app. Returned only when creating a hosted signup.",
            "example": "987654321098765",
            "type": "string"
          },
          "url": {
            "description": "Hosted onboarding URL to share with the end customer",
            "example": "https://acct.fyi?token=eyJhbGciOiJSUzI1NiIs...",
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "WhatsappHostedSignupCreateRequest": {
        "properties": {
          "app_id": {
            "description": "Meta App ID linked to the Telnyx account or its manager account. The app must be enabled.",
            "example": "123456789012345",
            "type": "string"
          },
          "expires_at": {
            "description": "When the onboarding URL expires, in RFC 3339 format. Must be in the future and at most 3 days ahead. Defaults to 24 hours after creation.",
            "example": "2026-07-09T12:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "signup_type": {
            "default": "standard",
            "description": "Onboarding flow the hosted page launches. Use `coexistence` for a number that remains active in the WhatsApp Business app.",
            "enum": [
              "standard",
              "coexistence"
            ],
            "example": "coexistence",
            "type": "string"
          }
        },
        "required": [
          "app_id"
        ],
        "type": "object"
      },
      "WhatsappSignupSession": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "customer_id": {
            "description": "Tech provider customer reference submitted with the signup",
            "type": "string"
          },
          "errors": {
            "description": "Errors recorded during provisioning",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "record_type": {
            "enum": [
              "whatsapp_session_id"
            ],
            "type": "string"
          },
          "session_id": {
            "description": "Signup session ID",
            "type": "string"
          },
          "state": {
            "description": "Current provisioning step, or the step that failed. `REGISTER_PHONE_NUMBER` is skipped for coexistence signups.",
            "enum": [
              "SUBSCRIBE_WEBHOOKS",
              "ASSIGNED_USERS",
              "SHARE_CREDIT_LINE",
              "REGISTER_PHONE_NUMBER",
              "ADD_WABA_TO_DB",
              "ADD_PHONE_NUMBERS_TO_DB",
              "COMPLETE"
            ],
            "type": "string"
          },
          "status": {
            "description": "`INCOMPLETE` waits for the Meta signup code, `PENDING` is in progress, `SUCCESS` finished provisioning, and `FAILURE` stopped at `state`.",
            "enum": [
              "INCOMPLETE",
              "PENDING",
              "SUCCESS",
              "FAILURE"
            ],
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "user_id": {
            "description": "Telnyx user ID that owns the signup session",
            "type": "string"
          },
          "waba_id": {
            "description": "Meta WhatsApp Business Account ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "messaging_Error": {
        "properties": {
          "code": {
            "type": "string",
            "x-format": "integer"
          },
          "detail": {
            "type": "string"
          },
          "meta": {
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "description": "Indicates which query parameter caused the error.",
                "type": "string"
              },
              "pointer": {
                "description": "JSON pointer (RFC6901) to the offending entity.",
                "format": "json-pointer",
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title"
        ]
      },
      "messaging_Errors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/messaging_Error"
            },
            "type": "array"
          }
        }
      },
      "messaging_PaginationMeta": {
        "properties": {
          "page_number": {
            "example": 2,
            "type": "integer"
          },
          "page_size": {
            "example": 25,
            "type": "integer"
          },
          "total_pages": {
            "example": 3,
            "type": "integer"
          },
          "total_results": {
            "example": 55,
            "type": "integer"
          }
        },
        "required": [
          "total_pages",
          "total_results",
          "page_size",
          "page_number"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/whatsapp/hosted_signups": {
      "get": {
        "description": "List hosted signups created by the account, newest first. Expired hosted signups are included.",
        "operationId": "ListWhatsappHostedSignups",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageConsolidated"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/WhatsappHostedSignupListResponse",
            "description": "Whatsapp hosted signups list"
          },
          "4XX": {
            "$ref": "#/components/responses/management_messaging_GenericErrorResponse"
          }
        },
        "summary": "List Whatsapp hosted signups",
        "tags": [
          "Whatsapp Signup"
        ],
        "x-latency-category": "responsive"
      },
      "post": {
        "description": "Create a time-limited onboarding URL on the Telnyx-hosted Embedded Signup page for a Tech Provider's end customer. Set `signup_type` to `coexistence` to launch Meta's WhatsApp Business app coexistence flow instead of standard Cloud API onboarding.",
        "operationId": "CreateWhatsappHostedSignup",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "app_id": "123456789012345",
                "signup_type": "coexistence"
              },
              "schema": {
                "$ref": "#/components/schemas/WhatsappHostedSignupCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "app_id": "123456789012345",
                    "created_at": "2026-07-08T12:00:00Z",
                    "expires_at": "2026-07-09T12:00:00Z",
                    "id": "0192345a-7b8c-7d9e-0f12-3456789abcde",
                    "jwt": "eyJhbGciOiJSUzI1NiIs...",
                    "record_type": "whatsapp_jwt",
                    "solution_id": "987654321098765",
                    "url": "https://acct.fyi?token=eyJhbGciOiJSUzI1NiIs..."
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WhatsappHostedSignup"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Hosted signup created"
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10015",
                      "detail": "expires_at must be at most 3 days in the future",
                      "title": "Bad request"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/messaging_Errors"
                }
              }
            },
            "description": "Invalid request"
          },
          "4XX": {
            "$ref": "#/components/responses/management_messaging_GenericErrorResponse"
          }
        },
        "summary": "Create a Whatsapp hosted signup",
        "tags": [
          "Whatsapp Signup"
        ],
        "x-latency-category": "responsive"
      }
    },
    "/whatsapp/hosted_signups/{id}": {
      "get": {
        "description": "Retrieve a hosted signup and its onboarding URL.",
        "operationId": "GetWhatsappHostedSignup",
        "parameters": [
          {
            "$ref": "#/components/parameters/WhatsappHostedSignupId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/WhatsappHostedSignupResponse",
            "description": "Whatsapp hosted signup"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found",
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/messaging_Errors"
                }
              }
            },
            "description": "Hosted signup not found"
          },
          "4XX": {
            "$ref": "#/components/responses/management_messaging_GenericErrorResponse"
          }
        },
        "summary": "Get a Whatsapp hosted signup",
        "tags": [
          "Whatsapp Signup"
        ],
        "x-latency-category": "responsive"
      }
    },
    "/whatsapp/signup": {
      "get": {
        "description": "List finished WhatsApp Embedded Signup sessions, with status `SUCCESS` or `FAILURE`, newest first. Use the `errors` of a failed session to see why provisioning stopped.",
        "operationId": "ListWhatsappSignupSessions",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageConsolidated"
          },
          {
            "description": "Filter by Meta WABA ID",
            "in": "query",
            "name": "filter[waba_id]",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by the tech provider customer reference",
            "in": "query",
            "name": "filter[customer_id]",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Return sessions created at or after this time (RFC 3339)",
            "in": "query",
            "name": "filter[created_at][gte]",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Return sessions created at or before this time (RFC 3339)",
            "in": "query",
            "name": "filter[created_at][lte]",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/WhatsappSignupSessionListResponse",
            "description": "Whatsapp signup sessions list"
          },
          "4XX": {
            "$ref": "#/components/responses/management_messaging_GenericErrorResponse"
          }
        },
        "summary": "List Whatsapp signup sessions",
        "tags": [
          "Whatsapp Signup"
        ],
        "x-latency-category": "responsive"
      }
    },
    "/whatsapp/signup/{id}/status": {
      "get": {
        "description": "Retrieve the current state and status of a WhatsApp Embedded Signup session.",
        "operationId": "GetWhatsappSignupSessionStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/WhatsappSignupSessionId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/WhatsappSignupSessionResponse",
            "description": "Whatsapp signup session"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found",
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/messaging_Errors"
                }
              }
            },
            "description": "Signup session not found"
          },
          "4XX": {
            "$ref": "#/components/responses/management_messaging_GenericErrorResponse"
          }
        },
        "summary": "Get Whatsapp signup session status",
        "tags": [
          "Whatsapp Signup"
        ],
        "x-latency-category": "responsive"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
