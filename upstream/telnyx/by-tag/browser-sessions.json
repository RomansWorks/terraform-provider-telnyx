{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "validation_error",
                "message": "invalid request: policy.allowed_domains must have at least 1 item(s)",
                "retryable": false
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Invalid request — validation error or invalid parameters."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "not_found",
                "message": "session not found",
                "retryable": false
              }
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Session or artifact not found."
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10009",
                  "detail": "Could not find any usable credentials in the request.",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                  },
                  "source": {
                    "pointer": "/"
                  },
                  "title": "Authentication failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        },
        "description": "Unauthorized — missing or invalid API key."
      }
    },
    "schemas": {
      "CreateSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "description": "Scoped to the organization. The same key and identical normalized policy, limits, and metadata replay the existing session (HTTP 201); a different request returns 409 idempotency_conflict. Replays do not restart terminal sessions.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "idle_timeout_s": {
                "default": 300,
                "description": "Idle timeout in seconds. Must not exceed lifetime_s.",
                "minimum": 30,
                "type": "integer"
              },
              "lifetime_s": {
                "default": 900,
                "description": "Max session duration in seconds (60-1800).",
                "maximum": 1800,
                "minimum": 60,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "metadata": {
            "additionalProperties": true,
            "description": "Arbitrary key-value metadata.",
            "type": "object"
          },
          "policy": {
            "additionalProperties": false,
            "properties": {
              "allowed_domains": {
                "description": "Domain patterns the browser can navigate to. Exact match (example.com) or wildcard (*.example.com). IP literals not allowed.",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "allowed_domains"
            ],
            "type": "object"
          }
        },
        "required": [
          "policy"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GatewayError": {
        "properties": {
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "meta": {
                  "properties": {
                    "url": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "source": {
                  "properties": {
                    "pointer": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "title"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "Session": {
        "properties": {
          "closed_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "example": "bsess_3b108e10-906a-486e-9132-196726ba7979",
            "type": "string"
          },
          "last_activity_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "limits": {
            "properties": {
              "idle_timeout_s": {
                "type": "integer"
              },
              "lifetime_s": {
                "type": "integer"
              }
            },
            "required": [
              "lifetime_s",
              "idle_timeout_s"
            ],
            "type": "object"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object"
          },
          "policy": {
            "properties": {
              "allowed_domains": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "allowed_domains"
            ],
            "type": "object"
          },
          "ready_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "provisioning",
              "ready",
              "closing",
              "closed",
              "failed",
              "expired"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "failure_reason",
          "policy",
          "limits",
          "metadata",
          "created_at",
          "ready_at",
          "last_activity_at",
          "expires_at",
          "closed_at"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/browser_sessions": {
      "get": {
        "description": "Lists sessions for the authenticated org. Optional status filter.",
        "operationId": "ListBrowserSessions",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "provisioning",
                "ready",
                "closing",
                "closed",
                "failed",
                "expired"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "List of sessions"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "summary": "List browser sessions",
        "tags": [
          "Browser Sessions"
        ]
      },
      "post": {
        "description": "Creates an isolated browser session with network access restricted to the domains you allow.",
        "operationId": "CreateBrowserSession",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "policy": {
                  "allowed_domains": [
                    "example.com"
                  ]
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Session created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "idempotency_conflict",
                    "message": "idempotency key reused with a different request",
                    "retryable": false
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Idempotency key reused with a different normalized create request."
          },
          "429": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "quota_exceeded",
                    "message": "organization concurrent-session limit reached",
                    "retryable": true
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Concurrent-session quota exceeded for the organization. Close unneeded active sessions or wait for capacity before retrying."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "failed to provision browser session",
                    "retryable": true
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The session could not be created."
          }
        },
        "summary": "Create browser session",
        "tags": [
          "Browser Sessions"
        ]
      }
    },
    "/browser_sessions/{id}": {
      "delete": {
        "description": "Closes a ready session and releases its resources. An already closed, failed, or expired session is returned unchanged; a provisioning session returns 409 session_not_ready.",
        "operationId": "CloseBrowserSession",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Session after close, or its unchanged terminal state."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "session_not_ready",
                    "message": "session is still provisioning",
                    "retryable": true
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Session is still provisioning. Poll its state before retrying the close."
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "execution_lost",
                    "message": "Request could not be completed reliably",
                    "retryable": true
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request could not be completed reliably. Retrieve action and session state before retrying; a mutation may already have taken effect. Do not blindly repeat it with a new idempotency key or session."
          }
        },
        "summary": "Close browser session",
        "tags": [
          "Browser Sessions"
        ]
      },
      "get": {
        "description": "Returns the current status of a browser session.",
        "operationId": "GetBrowserSession",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Session details"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "summary": "Get browser session",
        "tags": [
          "Browser Sessions"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
