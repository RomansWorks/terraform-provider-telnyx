      "TailscaleSubnetRouter": {
        "properties": {
          "advertised_routes": {
            "description": "IPv4 subnets of the Network that the router advertises to the tailnet. Each entry is a canonical CIDR that the Network routes. Default, loopback, link-local, multicast, and Tailscale (`100.64.0.0/10`) ranges are rejected. So are ranges that overlap the router's own, `172.27.254.0/24` and `198.18.0.0/20`.",
            "example": [
              "172.27.0.0/24"
            ],
            "items": {
              "example": "172.27.0.0/24",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "created_at": {
            "description": "ISO 8601 formatted date-time indicating when the resource was created.",
            "example": "2026-10-13T15:04:05.123456Z",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "customer_address": {
            "description": "The router's address on the Network, from `172.27.254.0/24`. Tailnet traffic enters the Network from this address.",
            "example": "172.27.254.1",
            "readOnly": true,
            "type": "string"
          },
          "device_id": {
            "description": "The router's node id on the tailnet. Set once the router has enrolled.",
            "example": "n5c6f0a7e1CNTRL",
            "readOnly": true,
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Identifies the resource.",
            "example": "5c6f0a7e-6c7b-4d7f-9f2e-3b1e4e9a8c21",
            "format": "uuid",
            "readOnly": true,
            "type": "string"
          },
          "name": {
            "description": "A user specified name for the router.",
            "example": "tailnet-ashburn",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "network_id": {
            "description": "The id of the Network the router is attached to.",
            "example": "0de011ae-ee53-4df4-ba96-754728eb5aad",
            "format": "uuid",
            "type": "string"
          },
          "record_type": {
            "description": "Identifies the type of the resource.",
            "example": "tailscale_subnet_router",
            "readOnly": true,
            "type": "string"
          },
          "region_code": {
            "description": "The code of the region the router is created in. `GET /network_coverage` lists the regions whose `available_services` include `tailscale_subnet_router`.",
            "example": "ashburn-va",
            "type": "string"
          },
          "status": {
            "description": "`provisioning`: Telnyx is creating the router or applying a change. `provisioned`: the router is on the tailnet and advertises its routes; the tailnet still approves them. `failed`: enrollment did not complete, and `PATCH` retries it. `deleting`: the router is being removed.",
            "enum": [
              "provisioning",
              "provisioned",
              "failed",
              "deleting"
            ],
            "example": "provisioned",
            "readOnly": true,
            "type": "string"
          },
          "tailnet_name": {
            "description": "The name of the tailnet the router is enrolled in. Set once the router has enrolled.",
            "example": "acme.example",
            "readOnly": true,
            "type": [
              "string",
              "null"
            ]
          },
          "tailscale_ips": {
            "description": "The router's addresses on the tailnet. Empty until the router has enrolled.",
            "example": [
              "100.101.2.30",
              "fd7a:115c:a1e0::2a"
            ],
            "items": {
              "type": "string"
            },
            "readOnly": true,
            "type": "array"
          },
          "updated_at": {
            "description": "ISO 8601 formatted date-time indicating when the resource was updated.",
            "example": "2026-10-13T15:09:41.654321Z",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          }
        },
        "title": "TailscaleSubnetRouter",
        "type": "object"
      },
      "TailscaleSubnetRouterCreate": {
        "additionalProperties": false,
        "properties": {
          "advertised_routes": {
            "description": "IPv4 subnets of the Network that the router advertises to the tailnet. Each entry is a canonical CIDR that the Network routes. Default, loopback, link-local, multicast, and Tailscale (`100.64.0.0/10`) ranges are rejected. So are ranges that overlap the router's own, `172.27.254.0/24` and `198.18.0.0/20`.",
            "example": [
              "172.27.0.0/24"
            ],
            "items": {
              "example": "172.27.0.0/24",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "auth_key": {
            "description": "A Tailscale auth key that enrolls the router in the user's tailnet: reusable, pre-approved, tagged, and not ephemeral. Telnyx stores it encrypted until enrollment succeeds, then discards it. It is never returned.",
            "example": "tskey-auth-k1AbCdEfGh2IjKlMnOpQrStUv",
            "format": "password",
            "pattern": "^tskey-auth-[A-Za-z0-9_-]{10,250}$",
            "type": "string",
            "writeOnly": true
          },
          "name": {
            "description": "A user specified name for the router.",
            "example": "tailnet-ashburn",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "network_id": {
            "description": "The id of the Network to attach the router to.",
            "example": "0de011ae-ee53-4df4-ba96-754728eb5aad",
            "format": "uuid",
            "type": "string"
          },
          "region_code": {
            "description": "The code of the region to create the router in. `GET /network_coverage` lists the regions whose `available_services` include `tailscale_subnet_router`.",
            "example": "ashburn-va",
            "type": "string"
          }
        },
        "required": [
          "name",
          "network_id",
          "region_code",
          "advertised_routes",
          "auth_key"
        ],
        "title": "TailscaleSubnetRouterCreate",
        "type": "object"
      },
      "TailscaleSubnetRouterUpdate": {
        "additionalProperties": false,
        "description": "Every field is optional. A change queues a new provisioning run and returns the router with `status` `provisioning`. An empty object retries a `failed` router.",
        "properties": {
          "advertised_routes": {
            "description": "IPv4 subnets of the Network that the router advertises to the tailnet. Each entry is a canonical CIDR that the Network routes. Default, loopback, link-local, multicast, and Tailscale (`100.64.0.0/10`) ranges are rejected. So are ranges that overlap the router's own, `172.27.254.0/24` and `198.18.0.0/20`.",
            "example": [
              "172.27.0.0/24"
            ],
            "items": {
              "example": "172.27.0.0/24",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "auth_key": {
            "description": "A replacement Tailscale auth key. Accepted only while the router has never enrolled, for example after a `failed` enrollment. Never returned.",
            "example": "tskey-auth-k1AbCdEfGh2IjKlMnOpQrStUv",
            "format": "password",
            "pattern": "^tskey-auth-[A-Za-z0-9_-]{10,250}$",
            "type": "string",
            "writeOnly": true
          },
          "name": {
            "description": "A user specified name for the router.",
            "example": "tailnet-ashburn",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "title": "TailscaleSubnetRouterUpdate",
        "type": "object"
      }
    },
