  "openapi": "3.1.0",
  "paths": {
    "/v2/whatsapp/business_accounts": {
      "get": {
        "description": "Returns WhatsApp Business Accounts linked to the authenticated Telnyx account.",
        "operationId": "ListWabas",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageConsolidated"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/messaging_WabasListResponse",
            "description": "List of Whatsapp Business Accounts"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "List Whatsapp Business Accounts",
        "tags": [
          "Whatsapp Business Accounts"
        ]
      }
    },
    "/v2/whatsapp/business_accounts/{id}": {
      "delete": {
        "description": "Unlinks and deletes the specified WhatsApp Business Account resource from Telnyx.",
        "operationId": "deleteWaba",
        "parameters": [
          {
            "$ref": "#/components/parameters/WabaId"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "Delete a Whatsapp Business Account",
        "tags": [
          "Whatsapp Business Accounts"
        ]
      },
      "get": {
        "description": "Returns the configuration and status of the specified WhatsApp Business Account.",
        "operationId": "GetSingleWaba",
        "parameters": [
          {
            "$ref": "#/components/parameters/WabaId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/WabaSingleResponse",
            "description": "Whatsapp Business Account details"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "Get a single Whatsapp Business Account",
        "tags": [
          "Whatsapp Business Accounts"
        ]
      }
    },
    "/v2/whatsapp/business_accounts/{id}/phone_numbers": {
      "get": {
        "description": "Returns phone numbers registered under the specified WhatsApp Business Account.",
        "operationId": "ListWabaPhones",
        "parameters": [
          {
            "$ref": "#/components/parameters/WabaId"
          },
          {
            "$ref": "#/components/parameters/PageConsolidated"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/messaging_WhatsappPhonesListResponse",
            "description": "List of phone numbers"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "List phone numbers for a WABA",
        "tags": [
          "Whatsapp Business Accounts"
        ]
      }
    },
    "/v2/whatsapp/business_accounts/{id}/settings": {
      "get": {
        "description": "Returns account-level settings for the specified WhatsApp Business Account.",
        "operationId": "GetWabaSettings",
        "parameters": [
          {
            "$ref": "#/components/parameters/WabaId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/WabaSettingsResponse",
            "description": "WABA settings"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "Get WABA settings",
        "tags": [
          "Whatsapp Business Accounts"
        ]
      },
      "patch": {
        "description": "Updates the supplied account-level settings for the specified WhatsApp Business Account.",
        "operationId": "PatchWabaSettings",
        "parameters": [
          {
            "$ref": "#/components/parameters/WabaId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchWabaSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/WabaSettingsResponse",
            "description": "Updated settings"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "Update WABA settings",
        "tags": [
          "Whatsapp Business Accounts"
        ]
      }
    },
    "/v2/whatsapp/user_data": {
      "get": {
        "description": "Returns the WhatsApp user-data settings associated with the authenticated Telnyx account.",
        "operationId": "GetWhatsappUserData",
        "responses": {
          "200": {
            "$ref": "#/components/responses/WhatsappUserDataResponse",
            "description": "Whatsapp user data"
          },
          "4XX": {
            "$ref": "#/components/responses/messaging_GenericErrorResponse_0b38e7044b"
          }
        },
        "summary": "Fetch Whatsapp user data",
