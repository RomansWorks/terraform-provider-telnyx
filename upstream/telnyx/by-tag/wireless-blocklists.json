  "openapi": "3.1.0",
  "paths": {
    "/wireless_blocklist_values": {
      "get": {
        "description": "Retrieve all wireless blocklist values for a given blocklist type. The request returns `422` when `type` is missing or invalid.",
        "operationId": "WirelessBlocklistsGetAll",
        "parameters": [
          {
            "description": "The Wireless Blocklist type for which to list possible values (e.g., `country`, `mcc`, `plmn`).",
            "in": "query",
            "name": "type",
            "required": true,
            "schema": {
              "enum": [
                "country",
                "mcc",
                "plmn"
              ],
              "example": "country",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "country": {
                    "summary": "Country values",
                    "value": {
                      "data": [
                        {
                          "country_code": "US"
                        }
                      ]
                    }
                  },
                  "mcc": {
                    "summary": "MCC values",
                    "value": {
                      "data": [
                        {
                          "mcc": "310"
                        }
                      ]
                    }
                  },
                  "plmn": {
                    "summary": "PLMN values",
                    "value": {
                      "data": [
                        {
                          "plmn": "310260"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "items": {
                            "$ref": "#/components/schemas/wireless_Country"
                          },
                          "title": "Country",
                          "type": "array"
                        },
                        {
                          "items": {
                            "$ref": "#/components/schemas/wireless_MCC"
                          },
                          "title": "MCC",
                          "type": "array"
                        },
                        {
                          "items": {
                            "$ref": "#/components/schemas/wireless_PLMN"
                          },
                          "title": "PLMN",
                          "type": "array"
                        }
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "A list of possible wireless blocklist values"
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "invalidType": {
                    "summary": "Invalid type",
                    "value": {
                      "code": "10027",
                      "detail": "Type must be one of: country, mcc, plmn",
                      "meta": {
                        "url": "https://developers.telnyx.com/api/errors/10027"
                      },
                      "source": {
                        "pointer": "/type"
                      },
                      "title": "Invalid filter type"
                    }
                  },
                  "missingType": {
                    "summary": "Missing type",
                    "value": {
                      "code": "10027",
                      "detail": "The 'type' query parameter is required. Must be one of: country, mcc, plmn",
                      "meta": {
                        "url": "https://developers.telnyx.com/api/errors/10027"
                      },
                      "source": {
                        "pointer": "/type"
                      },
                      "title": "Missing required parameter"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/wireless_Error_c5290d5308"
                }
              }
            },
            "description": "Missing or invalid blocklist type"
          },
          "default": {
            "$ref": "#/components/responses/wireless_GenericErrorResponse_c5290d5308"
          }
        },
        "summary": "Get all possible wireless blocklist values",
        "tags": [
          "Wireless Blocklists"
        ]
      }
    },
    "/wireless_blocklists": {
      "get": {
        "description": "Get all Wireless Blocklists belonging to the user.",
        "operationId": "GetWirelessBlocklistsGateways",
        "parameters": [
          {
            "$ref": "#/components/parameters/wireless_PageNumber_c5290d5308"
          },
          {
            "$ref": "#/components/parameters/wireless_PageSize_c5290d5308"
          },
          {
            "description": "The name of the Wireless Blocklist.",
            "example": "my private gateway",
            "in": "query",
            "name": "filter[name]",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "When the Private Wireless Gateway was last updated.",
            "example": "country",
            "in": "query",
            "name": "filter[type]",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/wireless_WirelessBlocklist"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized"
          },
          "default": {
            "$ref": "#/components/responses/wireless_GenericErrorResponse_c5290d5308"
          }
        },
        "summary": "Get all Wireless Blocklists",
        "tags": [
          "Wireless Blocklists"
        ]
      },
      "post": {
        "description": "Create a Wireless Blocklist to prevent SIMs from connecting to certain networks.",
        "operationId": "CreateWirelessBlocklist",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "description": "The name of the Wireless Blocklist.",
                    "example": "My Wireless Blocklist",
                    "type": "string"
                  },
                  "type": {
                    "description": "The type of wireless blocklist.",
                    "enum": [
                      "country",
                      "mcc",
                      "plmn"
                    ],
                    "example": "country",
                    "type": "string"
                  },
                  "values": {
                    "description": "Values to block. The values here depend on the `type` of Wireless Blocklist.",
                    "example": [
                      "CA",
                      "US"
                    ],
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/CountryCode"
                        },
                        {
                          "$ref": "#/components/schemas/MobileCountryCode"
                        },
                        {
                          "$ref": "#/components/schemas/PLMNCode"
                        }
                      ]
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "name",
                  "type",
                  "values"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "data": {
                      "created_at": "2018-02-02T22:25:27.521Z",
                      "id": "6a09cdc3-8948-47f0-aa62-74ac943d6c58",
                      "name": "North American Wireless Blocklist",
                      "type": "country",
                      "updated_at": "2018-02-02T22:25:27.521Z",
                      "values": [
                        "CA",
                        "MX",
                        "US"
                      ]
                    }
                  },
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/wireless_WirelessBlocklist"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Wireless Blocklist created"
          },
          "422": {
            "$ref": "#/components/responses/wireless_UnprocessableEntity_c5290d5308"
          },
          "default": {
            "$ref": "#/components/responses/wireless_GenericErrorResponse_c5290d5308"
          }
        },
        "summary": "Create a Wireless Blocklist",
        "tags": [
          "Wireless Blocklists"
        ]
      }
    },
    "/wireless_blocklists/{id}": {
      "delete": {
        "description": "Permanently deletes the specified wireless blocklist from your account. The request returns `422` when the wireless blocklist is assigned to a SIM Card Group.",
        "operationId": "DeleteWirelessBlocklist",
        "parameters": [
          {
            "$ref": "#/components/parameters/WirelessBlocklistId"
          }
        ],
        "responses": {
          "204": {
            "description": "Wireless Blocklist deleted"
          },
          "404": {
            "$ref": "#/components/responses/ResourceNotFound"
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "wirelessBlocklistAssigned": {
                    "summary": "Wireless Blocklist is still assigned",
                    "value": {
                      "code": "10027",
                      "detail": "This wireless blocklist is associated with one or more SIM Cards or SIM Card Groups. Remove any association(s) before deleting.",
                      "meta": {
                        "url": "https://developers.telnyx.com/api/errors/10027"
                      },
                      "source": {
                        "pointer": "/wireless_blocklist"
                      },
                      "title": "Cannot delete wireless blocklist"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/wireless_Error_c5290d5308"
                }
              }
            },
            "description": "Wireless Blocklist is still assigned"
          },
          "default": {
            "$ref": "#/components/responses/wireless_GenericErrorResponse_c5290d5308"
          }
        },
        "summary": "Delete a Wireless Blocklist",
        "tags": [
          "Wireless Blocklists"
        ]
      },
      "get": {
        "description": "Retrieve information about a Wireless Blocklist.",
        "operationId": "GetWirelessBlocklist",
        "parameters": [
          {
            "$ref": "#/components/parameters/WirelessBlocklistId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/wireless_WirelessBlocklist"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "$ref": "#/components/responses/ResourceNotFound"
          },
          "default": {
            "$ref": "#/components/responses/wireless_GenericErrorResponse_c5290d5308"
          }
        },
        "summary": "Get a Wireless Blocklist",
        "tags": [
          "Wireless Blocklists"
        ]
      },
      "patch": {
        "description": "Updates the specified wireless blocklist. The update is processed asynchronously, so the request is accepted and completes in the background.",
        "operationId": "UpdateWirelessBlocklist",
        "parameters": [
          {
            "$ref": "#/components/parameters/WirelessBlocklistId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "description": "The name of the Wireless Blocklist.",
                    "example": "My Wireless Blocklist",
                    "type": "string"
                  },
                  "values": {
                    "description": "Values to block. The values here depend on the `type` of Wireless Blocklist.",
                    "example": [
                      "CA",
                      "US"
                    ],
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/CountryCode"
                        },
                        {
                          "$ref": "#/components/schemas/MobileCountryCode"
                        },
                        {
                          "$ref": "#/components/schemas/PLMNCode"
                        }
                      ]
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/wireless_WirelessBlocklist"
                    }
                  },
                  "type": "object"
                }
