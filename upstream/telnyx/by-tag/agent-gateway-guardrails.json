            "minItems": 1,
            "type": "array"
          },
          "name": {
            "description": "A name, unique on the instance. A request names it in its `guardrails` field.",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "type": "string"
          },
          "settings": {
            "description": "The type's settings. `content_filter`: `patterns` (prebuilt patterns by `name`, such as `us_ssn` or `email`), `regexes` (each a `name`, which tags masked matches, and a `pattern`), `keywords` (each a `keyword`), and `categories` (each a `name`), each entry with an `action` of `block` or `mask`. `tool_permission`: `rules` (`id`, `tool_name`, `tool_type`, `decision`, `argument_patterns`), a `default` decision, and `on_denied` (`block` or `rewrite`). `model_judge`: a `model` on the instance and weighted `criteria` (`name`, `description`, `weight`, the weights summing to 100). `custom_code`: `code` defining `apply_guardrail(inputs, request_data, input_type)`. `lakera`: `api_key`, `project_id`, `api_base`. `presidio`: `analyzer_url`, `anonymizer_url`, `entities` (entity name to `block` or `mask`), `language`. `bedrock`: `guardrail_id`, `version`, `region`, and `access_key_id` with `secret_access_key`, or `role_name`. `azure_content_safety`: `api_key`, `endpoint`, `severity` (0 to 7). Provider secrets are write-only.",
            "type": "object"
          },
          "type": {
            "description": "The kind of check. It cannot change after create.",
            "enum": [
              "content_filter",
              "tool_permission",
              "model_judge",
              "custom_code",
              "lakera",
              "presidio",
              "bedrock",
              "azure_content_safety"
            ],
            "type": "string"
          }
        },
        "required": [
