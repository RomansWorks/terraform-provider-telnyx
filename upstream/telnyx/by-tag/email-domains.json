  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/email_domains": {
      "get": {
        "description": "Shared (`type: shared`) Telnyx-managed domains are included/readable for every account, in addition to the account's own custom domains.",
        "operationId": "listEmailDomains",
        "parameters": [
          {
            "$ref": "#/components/parameters/email_PageNumber"
          },
          {
            "$ref": "#/components/parameters/DomainsPageSize"
          },
          {
            "$ref": "#/components/parameters/PageAfter"
          },
          {
            "$ref": "#/components/parameters/PageBefore"
          },
          {
            "description": "Field to sort by. Prefix with `-` for descending order.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "created_at",
                "-created_at",
                "domain",
                "-domain",
                "updated_at",
                "-updated_at"
              ],
              "type": "string"
            }
          },
          {
            "description": "Filter domains by verification status: pending, verifying, verified, failed, degraded, or suspended.",
            "in": "query",
            "name": "filter[status]",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/EmailDomainStatus"
            }
          },
          {
            "description": "Partial match on domain name (case-insensitive)",
            "example": "example.com",
            "in": "query",
            "name": "filter[domain]",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by profile UUID",
            "in": "query",
            "name": "filter[profile_id]",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Filter domains by type: custom, shared, or shared_inbound.",
            "in": "query",
            "name": "filter[type]",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/EmailDomainType"
            }
          },
          {
            "description": "Filter domains by whether they can currently be used to send email.",
            "in": "query",
            "name": "filter[usable_for_sending]",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Filter domains by whether they can currently receive inbound email.",
            "in": "query",
            "name": "filter[usable_for_inbound]",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainListResponse"
                }
              }
            },
            "description": "A paginated list of email domains"
          },
          "400": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "List email domains",
        "tags": [
          "Email Domains"
        ]
      },
      "post": {
        "description": "Registers a domain for email sending and optional inbound delivery. The response includes the domain configuration and current verification state.",
        "operationId": "createEmailDomain",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "domain": "example.com",
                "inbound_enabled": true,
                "tracking": {
                  "click_tracking": true,
                  "open_tracking": true,
                  "unsubscribe_tracking": false
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CreateEmailDomainRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainResponse"
                }
              }
            },
            "description": "Email domain created"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Create an email domain",
        "tags": [
          "Email Domains"
        ]
      }
    },
    "/email_domains/{domain_id}/rotate_dkim": {
      "post": {
        "description": "Generates a new DKIM key for the domain, activates it, and retires the previous key. The response includes the updated DKIM DNS records the customer must publish. Selectors are fixed, so rotation replaces the TXT value at the existing `\u003cselector\u003e._domainkey.\u003cdomain\u003e` host rather than adding a second record — `old_selector_retained` is false and the new TXT value must be published promptly, since signing switches to the new key immediately and the old TXT value will no longer match. The previous key is retired to a `retiring` state (retained, not revoked) so it can be revoked after the DNS propagation grace period.\n",
        "operationId": "rotateEmailDomainDKIMKey",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainDomainId"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "dkim": {
                      "activated_at": "2026-09-11T12:00:00Z",
                      "algorithm": "rsa-sha256",
                      "id": "123e4567-e89b-12d3-a456-42661417400a",
                      "key_length": 2048,
                      "selector": "telnyx1",
                      "status": "active",
                      "version": 2
                    },
                    "dns_records": [
                      {
                        "actual_value": null,
                        "host": "telnyx1._domainkey.example.com",
                        "id": "123e4567-e89b-12d3-a456-42661417400b",
                        "priority": null,
                        "purpose": "dkim",
                        "record_type": "TXT",
                        "required": true,
                        "status": "pending",
                        "value": "v=DKIM1; k=rsa; p=MIIBIjANBgkqh..."
                      }
                    ],
                    "domain": "example.com",
                    "domain_id": "123e4567-e89b-12d3-a456-426614174002",
                    "old_selector_retained": false,
                    "previous_dkim_key": {
                      "id": "123e4567-e89b-12d3-a456-426614174009",
                      "selector": "telnyx1",
                      "status": "retiring",
                      "version": 1
                    },
                    "record_type": "email_domain_dkim_rotation"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainDKIMRotationResponse"
                }
              }
            },
            "description": "DKIM key rotated"
          },
          "403": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10008",
                      "detail": "Shared email domains are managed by Telnyx and cannot have their DKIM keys rotated by this account",
                      "title": "Forbidden"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/DomainsErrorResponse"
                }
              }
            },
            "description": "Forbidden — shared email domains are managed by Telnyx and cannot have their DKIM keys rotated by this account.\n"
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "40901",
                      "detail": "DKIM rotation conflicted with a concurrent operation on this domain. Safe to retry.",
                      "title": "Conflict"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/DomainsErrorResponse"
                }
              }
            },
            "description": "DKIM rotation conflicted with a concurrent operation on this domain. Safe to retry."
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Rotate the DKIM key for an email domain",
        "tags": [
          "Email Domains"
        ]
      }
    },
    "/email_domains/{id}": {
      "delete": {
        "description": "Deletes an email domain configuration. Verified domains require `force=true`, and shared domains are read-only for non-owner accounts.",
        "operationId": "deleteEmailDomain",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainId"
          },
          {
            "description": "Required as true when deleting verified domains",
            "in": "query",
            "name": "force",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainResponse"
                }
              }
            },
            "description": "Email domain deleted"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainsErrorResponse"
                }
              }
            },
            "description": "Forbidden — shared domains are read-only for non-owner accounts (error code 10008)."
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Delete an email domain",
        "tags": [
          "Email Domains"
        ]
      },
      "get": {
        "description": "Shared (`type: shared`) Telnyx-managed domains are included/readable for every account, in addition to the account's own custom domains.",
        "operationId": "getEmailDomain",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainResponse"
                }
              }
            },
            "description": "Email domain details"
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Retrieve an email domain",
        "tags": [
          "Email Domains"
        ]
      },
      "patch": {
        "description": "Updates mutable settings for an existing email domain, including inbound delivery and tracking configuration. Shared domains are read-only for non-owner accounts.",
        "operationId": "updateEmailDomain",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "inbound_enabled": true,
                "tracking": {
                  "open_tracking": false
                }
              },
              "schema": {
                "$ref": "#/components/schemas/UpdateEmailDomainRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainResponse"
                }
              }
            },
            "description": "Email domain updated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainsErrorResponse"
                }
              }
            },
            "description": "Forbidden — shared domains are read-only for non-owner accounts (error code 10008)."
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Update an email domain",
        "tags": [
          "Email Domains"
        ]
      }
    },
    "/email_domains/{id}/health": {
      "get": {
        "description": "Returns a summary of domain health including verification status and usability.",
        "operationId": "getEmailDomainHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/EmailDomainId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "checked_at": "2026-05-31T12:00:00Z",
                    "id": "6a09cdc3-8948-47f0-aa62-74ac943d6c58",
                    "record_type": "email_domain_health",
                    "status": "verified",
                    "usable_for_inbound": false,
                    "usable_for_sending": true,
                    "verification": {
                      "dkim": "verified",
                      "dmarc": "missing_optional",
                      "mx": "not_required",
                      "ownership": "verified",
                      "spf": "verified"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/EmailDomainHealthResponse"
                }
              }
            },
            "description": "Domain health summary"
          },
          "404": {
            "$ref": "#/components/responses/email_NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Get domain health summary",
        "tags": [
          "Email Domains"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
