{
  "components": {
    "parameters": {
      "CallId": {
        "description": "Call identifier used to retrieve reports owned by the authenticated user.",
        "in": "path",
        "name": "call_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "VoiceSdkCallReportSort": {
        "description": "Set the order of the results by creation date. `asc` and `created_at` sort oldest reports first; `desc` and `-created_at` sort newest reports first. If not given, results are sorted by creation date in descending order.",
        "in": "query",
        "name": "sort",
        "required": false,
        "schema": {
          "default": "desc",
          "enum": [
            "asc",
            "desc",
            "created_at",
            "-created_at"
          ],
          "example": "-created_at",
          "type": "string"
        }
      },
      "voice-sdk-debug_PageConsolidated": {
        "description": "Consolidated page parameter (deepObject style).",
        "explode": true,
        "in": "query",
        "name": "page",
        "required": false,
        "schema": {
          "properties": {
            "number": {
              "default": 1,
              "example": 1,
              "minimum": 1,
              "type": "integer"
            },
            "size": {
              "default": 20,
              "description": "Number of reports per page. Maximum 100.",
              "example": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "style": "deepObject"
      }
    },
    "schemas": {
      "VoiceSdkCallReport": {
        "additionalProperties": true,
        "description": "A raw call report stats JSON payload. The schema is intentionally permissive because Voice SDK clients can add fields over time.",
        "properties": {
          "call_id": {
            "description": "Unique call identifier.",
            "format": "uuid",
            "type": "string"
          },
          "call_report_id": {
            "description": "User-scoped storage grouping identifier derived from the authenticated user. This is not a unique per-call report identifier and may be shared by multiple calls for the same user.",
            "type": "string"
          },
          "created_at": {
            "description": "Creation timestamp when present.",
            "format": "date-time",
            "type": "string"
          },
          "flushReason": {
            "additionalProperties": true,
            "description": "Reason the SDK flushed this stats report segment, for example an intermediate socket-close flush.",
            "type": "object"
          },
          "logs": {
            "$ref": "#/components/schemas/VoiceSdkCallReportLogs"
          },
          "organization_id": {
            "description": "Organization associated with the stored call report when provided by the Voice SDK reporting path.",
            "format": "uuid",
            "type": "string"
          },
          "segment": {
            "description": "Zero-based stats segment index when the SDK sends segmented or intermediate reports.",
            "type": "integer"
          },
          "stats": {
            "$ref": "#/components/schemas/VoiceSdkCallReportStats"
          },
          "stored_at": {
            "description": "Time when the call report was stored.",
            "format": "date-time",
            "type": "string"
          },
          "summary": {
            "additionalProperties": true,
            "description": "High-level call metadata.",
            "type": "object"
          },
          "telnyx_leg_id": {
            "description": "Telnyx call leg identifier for correlating the report with call-control, SIP, and media troubleshooting data.",
            "type": "string"
          },
          "telnyx_session_id": {
            "description": "Telnyx RTC session identifier for correlating the report with Voice SDK signaling and media-session logs.",
            "type": "string"
          },
          "user_agent": {
            "description": "Voice SDK user agent string reported by the client. This is the preferred SDK/platform/version dimension when present.",
            "type": "string"
          },
          "user_id": {
            "description": "Authenticated user that owns the call report.",
            "format": "uuid",
            "type": "string"
          },
          "version": {
            "description": "Legacy SDK version value when the client reports one separately from the user agent.",
            "type": "string"
          },
          "voice_sdk_id": {
            "description": "Voice SDK instance identifier.",
            "type": "string"
          },
          "voice_sdk_id_decoded": {
            "additionalProperties": true,
            "description": "Decoded Voice SDK identifier metadata emitted by voice-sdk-proxy when available.",
            "type": "object"
          },
          "voice_sdk_session_id": {
            "description": "Voice SDK session correlation identifier used to group stats segments for the same SDK session.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "VoiceSdkCallReportListResponse": {
        "description": "Paginated raw Voice SDK call report stats payloads as stored by voice-sdk-debug.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/VoiceSdkCallReport"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/voice-sdk-debug_PaginationMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "VoiceSdkCallReportLogEntry": {
        "additionalProperties": true,
        "description": "A raw Voice SDK log entry. Additional SDK-specific fields may be present.",
        "properties": {
          "context": {
            "additionalProperties": true,
            "description": "Raw structured context attached to the log entry.",
            "type": "object"
          },
          "level": {
            "description": "Log level emitted by the SDK.",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "type": "string"
          },
          "message": {
            "description": "Log message.",
            "type": "string"
          },
          "timestamp": {
            "description": "Time when the log entry was emitted.",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "VoiceSdkCallReportLogs": {
        "description": "Raw logs payload emitted by the Voice SDK and stored without normalization. Live responses commonly return an array of log entries, but object-shaped log payloads are also allowed for compatibility.",
        "oneOf": [
          {
            "description": "Raw log entries emitted by the Voice SDK.",
            "items": {
              "$ref": "#/components/schemas/VoiceSdkCallReportLogEntry"
            },
            "type": "array"
          },
          {
            "additionalProperties": true,
            "description": "Raw logs object emitted by the Voice SDK when logs are grouped under an entries field.",
            "properties": {
              "entries": {
                "description": "Raw log entries when the SDK groups logs under an entries field.",
                "items": {
                  "$ref": "#/components/schemas/VoiceSdkCallReportLogEntry"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        ]
      },
      "VoiceSdkCallReportStats": {
        "description": "Raw stats payload emitted by the Voice SDK and stored without normalization. The exact shape can vary by SDK platform and version. Live responses commonly return an array of interval snapshots, but object-shaped stats payloads are also allowed for compatibility.",
        "oneOf": [
          {
            "description": "Raw interval stats snapshots emitted by the Voice SDK.",
            "items": {
              "additionalProperties": true,
              "description": "Raw stats snapshot. It may include WebRTC RTCStatsReport-style entries and audio, connection, ICE, or transport metrics.",
              "type": "object"
            },
            "type": "array"
          },
          {
            "additionalProperties": true,
            "description": "Raw stats object emitted by the Voice SDK.",
            "properties": {
              "audio": {
                "additionalProperties": true,
                "description": "Raw audio stats such as inbound/outbound packet, byte, jitter, packet-loss, bitrate, and audio-level metrics.",
                "type": "object"
              },
              "connection": {
                "additionalProperties": true,
                "description": "Raw connection stats such as round-trip time, packets, and bytes sent or received.",
                "type": "object"
              },
              "ice": {
                "additionalProperties": true,
                "description": "Raw ICE candidate-pair information, including selected pair, local/remote candidates, state, and nomination data when provided by the SDK.",
                "type": "object"
              },
              "transport": {
                "additionalProperties": true,
                "description": "Raw transport stats such as ICE state, DTLS state, SRTP cipher, TLS version, and selected-candidate-pair changes.",
                "type": "object"
              }
            },
            "type": "object"
          }
        ]
      },
      "VoiceSdkCallReportV2Error": {
        "additionalProperties": true,
        "description": "Standard Telnyx API v2 error object.",
        "properties": {
          "code": {
            "description": "Telnyx error code.",
            "example": "10015",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable details about the error.",
            "example": "Missing required query parameter: call_id.",
            "type": "string"
          },
          "meta": {
            "additionalProperties": true,
            "description": "Additional error metadata.",
            "properties": {
              "url": {
                "description": "Link to error documentation.",
                "example": "https://developers.telnyx.com/docs/overview/errors/10015",
                "format": "uri",
                "type": "string"
              }
            },
            "type": "object"
          },
          "source": {
            "additionalProperties": true,
            "description": "Reference to the request field that caused the error.",
            "properties": {
              "parameter": {
                "description": "Query parameter that caused the error.",
                "example": "call_id",
                "type": "string"
              },
              "pointer": {
                "description": "JSON pointer to the request body field that caused the error.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "description": "Short, human-readable error title.",
            "example": "Bad Request",
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      },
      "VoiceSdkCallReportV2ErrorResponse": {
        "additionalProperties": true,
        "description": "Standard Telnyx API v2 error response envelope.",
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/VoiceSdkCallReportV2Error"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "VoiceSdkCallReportsResponse": {
        "description": "Raw Voice SDK call report stats payloads as stored by voice-sdk-debug.",
        "items": {
          "$ref": "#/components/schemas/VoiceSdkCallReport"
        },
        "type": "array"
      },
      "voice-sdk-debug_PaginationMeta": {
        "properties": {
          "page_number": {
            "example": 1,
            "type": "integer"
          },
          "page_size": {
            "example": 20,
            "type": "integer"
          },
          "total_pages": {
            "example": 1,
            "type": "integer"
          },
          "total_results": {
            "example": 1,
            "type": "integer"
          }
        },
        "title": "Pagination Meta",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/voice_sdk_call_reports": {
