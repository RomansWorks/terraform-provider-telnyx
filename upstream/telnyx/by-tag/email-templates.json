          "404": {
            "$ref": "#/components/responses/email_NotFoundResponse"
          },
          "422": {
            "$ref": "#/components/responses/ValidationErrorResponse"
          }
        },
        "summary": "Delete an email template",
        "tags": [
          "Email Templates"
        ]
      },
