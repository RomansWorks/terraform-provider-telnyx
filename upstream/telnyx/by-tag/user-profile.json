            "type": "string"
          },
          "country": {
            "description": "Country code in the profile address.",
            "example": "US",
            "type": [
              "string",
              "null"
            ]
          },
          "data_locality": {
            "description": "Data locality: USA (United States), DEU (Germany), AUS (Australia), UAE (United Arab Emirates), or CAN (Canada). A change is permitted only if data locality has not previously been changed. A successful change sets data_locality_updated_at and initializes data_locality_migration_status to not_started.",
            "enum": [
              "USA",
              "DEU",
              "AUS",
              "UAE",
              "CAN"
            ],
            "example": "DEU",
            "type": "string"
          },
          "default_managed_account_allow_custom_pricing": {
            "description": "Default custom-pricing setting for managed accounts.",
            "example": false,
            "type": "boolean"
          },
          "default_managed_account_inherit_emergency_terms_of_service": {
            "description": "Default emergency terms-of-service inheritance setting for managed accounts, where supported.",
            "example": false,
            "type": "boolean"
          },
          "default_managed_account_rollup_billing": {
            "description": "Default rollup-billing setting for managed accounts.",
            "example": false,
            "type": "boolean"
          },
          "default_notify_manager_account": {
            "description": "Default setting for notifying the manager account.",
            "example": true,
            "type": "boolean"
          },
          "default_numbers_external_pin": {
            "description": "Default alphanumeric external PIN for phone numbers.",
            "example": "1234",
            "maxLength": 16,
            "minLength": 4,
            "type": "string"
          },
          "first_name": {
            "description": "The user's first name.",
            "example": "Alex",
            "maxLength": 100,
            "type": [
              "string",
              "null"
            ]
          },
          "got_free_number_at_signup": {
