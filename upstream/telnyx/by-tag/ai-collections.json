{
  "components": {
    "parameters": {
      "PageNumber": {
        "description": "Page number to return (1-based). Defaults to 1.",
        "in": "query",
        "name": "page[number]",
        "required": false,
        "schema": {
          "default": 1,
          "example": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "Slug": {
        "description": "The collection's slug (unique within your organization).",
        "in": "path",
        "name": "slug",
        "required": true,
        "schema": {
          "example": "support-transcripts",
          "type": "string"
        }
      },
      "SourceId": {
        "description": "The identifier of the source to remove.",
        "in": "path",
        "name": "sourceId",
        "required": true,
        "schema": {
          "example": "42",
          "type": "string"
        }
      },
      "Uuid": {
        "description": "The collection's unique identifier.",
        "in": "path",
        "name": "uuid",
        "required": true,
        "schema": {
          "example": "6a09ccbd-8f9b-4c3a-9b0e-2f1d3c4b5a6e",
          "format": "uuid",
          "type": "string"
        }
      },
      "collections_PageSize": {
        "description": "Number of results per page. Defaults to 20.",
        "in": "query",
        "name": "page[size]",
        "required": false,
        "schema": {
          "default": 20,
          "example": 20,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "Conflict": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "collection_slug_taken",
                  "detail": "A collection with slug 'support-transcripts' already exists for this account.",
                  "meta": {
                    "pointer": "/slug"
                  },
                  "title": "Collection slug already in use"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/Errors"
            }
          }
        },
        "description": "The request conflicts with existing state (e.g. duplicate slug or duplicate source)."
      },
      "collections_BadRequest": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10015",
                  "detail": "The request failed because it was not well-formed.",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10015"
                  },
                  "title": "Bad Request"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/Errors"
            }
          }
        },
        "description": "The request was malformed or failed validation."
      },
      "collections_NotFound": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "collection_not_found",
                  "detail": "No collection with uuid 'b3b1c8a2-9f4e-4d2a-9c1e-2f7a6d5b4c3a' exists for this account.",
                  "title": "Collection not found"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/Errors"
            }
          }
        },
        "description": "The requested resource does not exist."
      },
      "collections_Unauthorized": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "10009",
                  "detail": "The required authentication headers were either invalid or not included in the request.",
                  "meta": {
                    "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                  },
                  "title": "Authentication failed"
                }
              ]
            },
            "schema": {
              "$ref": "#/components/schemas/Errors"
            }
          }
        },
        "description": "Missing or invalid authentication."
      }
    },
    "schemas": {
      "Collection": {
        "properties": {
          "created_at": {
            "example": "2026-08-04T12:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "example": "All customer support voice transcripts.",
            "type": "string"
          },
          "name": {
            "example": "Support Transcripts",
            "type": "string"
          },
          "record_type": {
            "description": "Identifies the record type. Always `ai_collection`.",
            "example": "ai_collection",
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/RetrievalSettingsWrapper"
          },
          "slug": {
            "example": "support-transcripts",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/collections_Source"
            },
            "type": "array"
          },
          "status": {
            "example": "ready",
            "type": "string"
          },
          "updated_at": {
            "example": "2026-08-04T12:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "uuid": {
            "example": "6a09ccbd-8f9b-4c3a-9b0e-2f1d3c4b5a6e",
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CollectionDocumentRecord": {
        "properties": {
          "chunk_index": {
            "type": "integer"
          },
          "chunk_total": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "ingested_at": {
            "format": "date-time",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object"
          },
          "organization_id": {
            "type": "string"
          },
          "record_created_at": {
            "format": "date-time",
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "record_type": {
            "description": "The source record kind this chunk came from (e.g. `voice`, `meeting_bot`, `message`).",
            "example": "voice",
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "score": {
            "description": "Relevance score (higher = more relevant) for ranked search. `0.0` for plain catalog listings (when `query` is omitted).",
            "format": "float",
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CollectionEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Collection"
          }
        },
        "type": "object"
      },
      "CollectionListEnvelope": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Collection"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "type": "object"
      },
      "CollectionSearchMeta": {
        "properties": {
          "collection_slug": {
            "example": "support-transcripts",
            "type": "string"
          },
          "page_number": {
            "example": 1,
            "type": "integer"
          },
          "page_size": {
            "example": 20,
            "type": "integer"
          },
          "retrieval_type": {
            "example": "vector",
            "type": "string"
          },
          "searched_sources": {
            "example": [
              "voice",
              "message"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "top_k": {
            "example": 5,
            "type": "integer"
          },
          "total_pages": {
            "example": 3,
            "type": "integer"
          },
          "total_results": {
            "example": 42,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "CollectionSearchResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/CollectionDocumentRecord"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/CollectionSearchMeta"
          }
        },
        "type": "object"
      },
      "CreateCollectionRequest": {
        "properties": {
          "description": {
            "description": "Optional description.",
            "example": "All customer support voice transcripts.",
            "type": "string"
          },
          "name": {
            "description": "Human-readable collection name.",
            "example": "Support Transcripts",
            "type": "string"
          },
          "settings": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RetrievalSettingsWrapper"
              }
            ],
            "description": "Optional retrieval settings."
          },
          "slug": {
            "description": "Optional slug (unique per organization). Derived from `name` when omitted.",
            "example": "support-transcripts",
            "type": "string"
          },
          "sources": {
            "description": "Optional sources to attach at creation time.",
            "items": {
              "$ref": "#/components/schemas/SourceRequest"
            },
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Error": {
        "example": {
          "code": "20207",
          "description": "The street address provided is invalid.",
          "source": {
            "pointer": "/street_address"
          },
          "title": "Invalid street address"
        },
        "properties": {
          "code": {
            "type": "string",
            "x-format": "int64"
          },
          "description": {
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation of the error.",
            "type": "string"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "description": "Indicates which query parameter caused the error.",
                "type": "string"
              },
              "pointer": {
                "description": "JSON pointer (RFC6901) to the offending entity.",
                "format": "json-pointer",
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title"
        ],
        "type": "object"
      },
      "Errors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Error"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ListMeta": {
        "properties": {
          "page_number": {
            "example": 1,
            "type": "integer"
          },
          "page_size": {
            "example": 20,
            "type": "integer"
          },
          "total_pages": {
            "example": 3,
            "type": "integer"
          },
          "total_results": {
            "example": 42,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ReplaceSourcesRequest": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRequest"
            },
            "type": "array"
          }
        },
        "required": [
          "sources"
        ],
        "type": "object"
      },
      "RetrievalSettings": {
        "description": "How documents are retrieved when searching the collection.",
        "properties": {
          "retrieval_type": {
            "default": "vector",
            "description": "Retrieval strategy. `vector` runs semantic similarity search; `hybrid` combines vector similarity with keyword matching; `keyword` runs lexical (BM25) matching. `keyword` is not accepted yet: setting it returns 422 `unsupported_retrieval_type`. A collection set to `hybrid` is accepted here but cannot be searched until hybrid execution ships.",
            "enum": [
              "vector",
              "hybrid"
            ],
            "example": "vector",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "description": "Number of top results to retrieve (1–50).",
            "example": 5,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "RetrievalSettingsWrapper": {
        "properties": {
          "record_type": {
            "description": "Identifies the record type. Always `ai_collection_settings`.",
            "example": "ai_collection_settings",
            "readOnly": true,
            "type": "string"
          },
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalSettings"
          }
        },
        "type": "object"
      },
      "SettingsEnvelope": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RetrievalSettingsWrapper"
          }
        },
        "type": "object"
      },
      "SettingsRequest": {
        "properties": {
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalSettings"
          }
        },
        "type": "object"
      },
      "SourceEnvelope": {
        "description": "Envelope containing a single collection source.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/collections_Source"
          }
        },
        "type": "object"
      },
      "SourceListEnvelope": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/collections_Source"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "SourceReconcileEnvelope": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/collections_Source"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/SourceReconcileMeta"
          }
        },
        "type": "object"
      },
      "SourceReconcileMeta": {
        "description": "Reports which source IDs were added, retained, and removed by a replace operation.",
        "properties": {
          "added": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "retained": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "SourceRequest": {
        "allOf": [
          {
            "if": {
              "properties": {
                "source_type": {
                  "const": "bucket"
                }
              },
              "required": [
                "source_type"
              ]
            },
            "then": {
              "properties": {
                "bucket_id": {
                  "type": "string"
                }
              },
              "required": [
                "bucket_id"
              ]
            }
          }
        ],
        "properties": {
          "bucket_id": {
            "description": "The Telnyx Storage bucket name. Required when `source_type` is `bucket`; ignored otherwise.",
            "example": "policy-docs",
            "type": "string"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          }
        },
        "required": [
          "source_type"
        ],
        "type": "object"
      },
      "SourceType": {
        "description": "The type of Telnyx data attached as a source. `bucket` requires an additional `bucket_id`. Only `voice` is searchable today; `meeting_bot`, `message`, and `bucket` attach but are not yet searchable (Coming soon).",
        "enum": [
          "voice",
          "meeting_bot",
          "message",
          "bucket"
        ],
        "example": "voice",
        "type": "string"
      },
      "UpdateCollectionRequest": {
        "description": "Metadata-only update. Provide either or both fields.",
        "properties": {
          "description": {
            "example": "Updated description.",
            "type": "string"
          },
          "name": {
            "example": "Support Transcripts (2026)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "collections_Source": {
        "properties": {
          "bucket_id": {
            "description": "The Telnyx Storage bucket name. Present only for `bucket` sources.",
            "example": "policy-docs",
            "type": "string"
          },
          "collection_id": {
            "example": "6a09ccbd-8f9b-4c3a-9b0e-2f1d3c4b5a6e",
            "format": "uuid",
            "type": "string"
          },
          "id": {
            "example": "source_8vkvtcksnawvbnxq48yv2l06wx",
            "type": "string"
          },
          "record_type": {
            "description": "Identifies the record type. Always `ai_collection_source`.",
            "example": "ai_collection_source",
            "type": "string"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "status": {
            "example": "ready",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/collections": {
      "get": {
        "description": "Returns a paginated list of collections in your organization.",
        "operationId": "ListCollections",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/collections_PageSize"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionListEnvelope"
                }
              }
            },
            "description": "A paginated list of collections."
          },
          "401": {
            "$ref": "#/components/responses/collections_Unauthorized"
          }
        },
        "summary": "List collections",
        "tags": [
          "AI Collections"
        ]
      },
      "post": {
        "description": "Creates a new collection scoped to your organization. Optionally attach sources and retrieval settings at creation time. If `slug` is omitted, one is derived from `name` and must be unique within your organization.",
        "operationId": "CreateCollection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "Collection created."
          },
          "400": {
            "$ref": "#/components/responses/collections_BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/collections_Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "invalid_source_configuration",
                      "detail": "The bucket_id field is required when source_type is bucket.",
                      "meta": {
                        "pointer": "/sources/0/bucket_id"
                      },
                      "title": "Invalid source configuration"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Validation error -- a `bucket` source without a `bucket_id` (`invalid_source_configuration`), an unknown `source_type` (`invalid_source_type`), an unsupported `retrieval_type` (`unsupported_retrieval_type`), or `top_k` out of range 1-50 (`invalid_top_k`)."
          }
        },
        "summary": "Create a collection",
        "tags": [
          "AI Collections"
        ]
      }
    },
    "/ai/collections/slug/{slug}": {
      "get": {
        "description": "Fetches a single collection by its `slug`.",
        "operationId": "GetCollectionBySlug",
        "parameters": [
          {
            "$ref": "#/components/parameters/Slug"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionEnvelope"
                }
              }
            },
            "description": "The collection."
          },
          "401": {
            "$ref": "#/components/responses/collections_Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/collections_NotFound"
          }
        },
        "summary": "Get a collection by slug",
        "tags": [
          "AI Collections"
        ]
      }
    },
    "/ai/collections/{uuid}": {
      "delete": {
        "description": "Soft-deletes a collection. Its `slug` is freed and may be reused by a new collection.",
