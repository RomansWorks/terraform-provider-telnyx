    "/ai/memory/namespaces/{namespace}/profiles/{profile_id}/summary/preview": {
      "post": {
        "description": "Try a candidate note on one profile and see how that profile's summary would read under it, without saving the note and without touching the stored summary. Composes the same source query the apply path (`PATCH /ai/memory/namespaces/{namespace}/settings`) would use, so a preview cannot drift from what saving the note would produce. Reads the candidate alone -- the namespace's current instructions and the profile's stored summary are neither read nor replaced. Bounded at 120 seconds: the summary is generated on the spot rather than read from a stored one. Nothing about the request is stored.",
        "operationId": "PreviewSummaryInstructions",
        "parameters": [
          {
            "description": "The namespace. `default` exists for every organization.",
            "in": "path",
            "name": "namespace",
            "required": true,
            "schema": {
              "description": "The namespace. `default` exists for every organization.",
              "type": "string"
            }
          },
          {
            "description": "The profile: your identifier for the user, caller or agent this memory is about.",
            "in": "path",
            "name": "profile_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "instructions": "Lead with billing status. Prefer plain language over jargon."
              },
              "schema": {
                "$ref": "#/components/schemas/PreviewSummaryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "profile_id": "user-42",
                    "text": "## Profile Summary\n\n- Billing: current, autopay on.\n- Prefers Slack over email."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/PreviewSummaryResponse"
                }
              }
            },
            "description": "The summary this profile would carry under the candidate note. `data.text` is `null` when nothing was generated -- the same signal `GET /summary` uses for a profile with no card yet."
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
