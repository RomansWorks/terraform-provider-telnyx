                "schema": {
                  "$ref": "#/components/schemas/VoiceSdkCallReportV2ErrorResponse"
                }
              }
            },
            "description": "Bad request — invalid pagination or sort parameter."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceSdkCallReportV2ErrorResponse"
                }
              }
            },
            "description": "Authentication failed."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceSdkCallReportV2ErrorResponse"
                }
              }
            },
