            "description": "Report not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "summary": "Delete a V2 legacy usage MDR report request",
        "tags": [
          "MDR Usage Reports"
        ],
        "x-latency-category": "responsive"
