          },
          "404": {
            "$ref": "#/components/responses/email_NotFoundResponse"
          },
          "422": {
            "$ref": "#/components/responses/TemplateRenderFailedResponse"
          }
        },
        "summary": "Render an email template",
        "tags": [
          "Email Templates"
        ]
