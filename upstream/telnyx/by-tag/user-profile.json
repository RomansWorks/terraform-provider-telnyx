            "maxLength": 100,
            "type": [
              "string",
              "null"
            ]
          },
          "low_balance_notification_frequency": {
            "description": "Low-balance notification frequency. Organization sub-users cannot set a non-null frequency. The resulting profile must have both a threshold and frequency, or neither.",
            "enum": [
              2,
              4,
              12,
              24,
              null
