          "400": {
            "$ref": "#/components/responses/numbers_BadRequestResponse_73c9788e53"
          },
          "401": {
            "$ref": "#/components/responses/numbers_UnauthorizedResponse_73c9788e53"
          },
          "404": {
            "$ref": "#/components/responses/numbers_NotFoundResponse_73c9788e53"
