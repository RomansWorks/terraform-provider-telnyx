  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/addresses": {
      "get": {
        "description": "Returns a paginated list of the addresses on your account, with support for filtering and sorting.",
        "operationId": "FindAddresses",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageConsolidated"
          },
          {
            "$ref": "#/components/parameters/FilterConsolidated"
          },
          {
            "$ref": "#/components/parameters/SortAddress"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Address"
                      },
                      "type": "array"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        },
        "summary": "List all addresses",
        "tags": [
          "Addresses"
        ],
        "x-endpoint-cost": "medium"
      },
      "post": {
        "description": "Creates a new address on your account from the provided details, for use with services that require a physical address such as emergency calling and regulatory compliance.\n\nBy default, the new record is validated for emergency use at creation time. If the address fails validation, no record is created and the request is rejected with a 422 response; the `errors` array includes a suggested value for each offending field when one is available.\n\nSet `validate_address` to `false` to skip validation at creation, for example when the address was already validated with the Validate an address action. The record is then created without emergency validation: if it is not valid it will not be able to be used for emergency services (such as a phone number's emergency address), and because address records cannot be updated, a new record has to be created to correct it.",
        "operationId": "CreateAddress",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressCreate"
              }
            }
          },
          "description": "Parameters that can be defined during address creation",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Address"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Successful response. `validate_address` on the returned record indicates whether it was validated for emergency use at creation: created with the default `true`, the record passed emergency validation; created with `false`, validation was skipped during this creation request, and the address may have been validated separately. This flag is not a current validity status; emergency use still requires a valid address."
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        },
