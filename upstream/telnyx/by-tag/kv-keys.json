{
  "components": {
    "schemas": {
      "Error": {
        "example": {
          "code": "20207",
          "description": "The street address provided is invalid.",
          "source": {
            "pointer": "/street_address"
          },
          "title": "Invalid street address"
        },
        "properties": {
          "code": {
            "type": "string",
            "x-format": "int64"
          },
          "description": {
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation of the error.",
            "type": "string"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "description": "Indicates which query parameter caused the error.",
                "type": "string"
              },
              "pointer": {
                "description": "JSON pointer (RFC6901) to the offending entity.",
                "format": "json-pointer",
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "title"
        ],
        "type": "object"
      },
      "ErrorMeta": {
        "properties": {
          "url": {
            "example": "https://docs.telnyx.com/api/errors/10005",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorSource": {
        "properties": {
          "parameter": {
            "example": "id",
            "type": "string"
          },
          "pointer": {
            "example": "/id",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Errors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/Error"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "GenericErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/edge-compute_Error"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "KvKey": {
        "properties": {
          "key": {
            "example": "user/123",
            "type": "string"
          },
          "size_bytes": {
            "description": "Size of the stored value in bytes.",
            "example": 21,
            "type": "integer"
          },
          "updated_at": {
            "example": "2026-06-18T14:48:17Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "KvKeyListResponseWrapper": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/KvKey"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/KvListMeta"
          },
          "record_type": {
            "example": "storage_kv_key",
            "type": "string"
          }
        },
        "type": "object"
      },
      "KvListMeta": {
        "properties": {
          "cursor": {
            "description": "Opaque cursor for the next page; pass it back as the `cursor` query parameter. Omitted when there are no further results.",
            "type": "string"
          },
          "has_more": {
            "description": "Whether more results are available on a following page.",
            "example": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "edge-compute_Error": {
        "properties": {
          "code": {
            "example": "10005",
            "type": "string"
          },
          "detail": {
            "example": "The requested function does not exist or you don't have access to it",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/ErrorMeta"
          },
          "source": {
            "$ref": "#/components/schemas/ErrorSource"
          },
          "title": {
            "example": "Function not found",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-memory_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "branded-calling_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "collections_bearerAuth": {
        "description": "Telnyx API key. Collections and results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "number-reputation_bearerAuth": {
        "description": "Telnyx API key. Generate one at https://portal.telnyx.com/#/app/api-keys.",
        "scheme": "bearer",
        "type": "http"
      },
      "oauthClientAuth": {
        "description": "OAuth 2.0 authentication for Telnyx API and MCP integrations",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.telnyx.com/v2/oauth/authorize",
            "refreshUrl": "https://api.telnyx.com/v2/oauth/token",
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "admin": "Administrative access to Telnyx resources"
            },
            "tokenUrl": "https://api.telnyx.com/v2/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "outbound-voice-profiles_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "pay-connectors_bearerAuth": {
        "description": "Telnyx API key, not the processor bearer token.",
        "scheme": "bearer",
        "type": "http"
      },
      "pronunciation-dicts_bearerAuth": {
        "description": "Telnyx API v2 key. Obtain from https://portal.telnyx.com",
        "scheme": "bearer",
        "type": "http"
      },
      "rcs-registration_bearerAuth": {
        "bearerFormat": "API key",
        "scheme": "bearer",
        "type": "http"
      },
      "stored-payment-transactions_bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "telnyxApiKey": {
        "description": "Management-only Telnyx account credential.",
        "scheme": "bearer",
        "type": "http"
      },
      "transcriptions-search_bearerAuth": {
        "description": "Telnyx API key. Results are automatically scoped to the authenticated user's organization.",
        "scheme": "bearer",
        "type": "http"
      },
      "web-search_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "email": "support@telnyx.com"
    },
    "description": "SIP trunking, SMS, MMS, Call Control and Telephony Data Services.",
    "title": "Telnyx API",
    "version": "2.0.0",
    "x-endpoint-cost": "light",
    "x-latency-category": "responsive"
  },
  "openapi": "3.1.0",
  "paths": {
    "/storage/kvs/{id}/keys": {
      "get": {
        "description": "Lists the keys in a namespace. Returns key names and metadata only, never values. Results are paginated with `limit` and an opaque `cursor`.",
        "operationId": "ListKvKeys",
        "parameters": [
          {
            "description": "KV namespace ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Return only keys that start with this prefix.",
            "in": "query",
            "name": "prefix",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Maximum number of keys to return. Values above 1000 are treated as 1000.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 1000,
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque pagination cursor from a previous response's `meta.cursor`.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KvKeyListResponseWrapper"
                }
              }
            },
            "description": "Keys retrieved successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Bad request — `id` is not a valid UUID, or `limit` is not a positive integer"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "KV namespace not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Conflict — the namespace is not ready (`status` is not `provision_ok`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List keys",
        "tags": [
          "kv keys"
        ]
      }
    },
    "/storage/kvs/{id}/keys/{key}": {
      "delete": {
        "description": "Deletes a key. Idempotent: deleting a key that does not exist still succeeds. The namespace itself must exist and be provisioned.",
        "operationId": "DeleteKvKey",
        "parameters": [
          {
            "description": "KV namespace ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Key name. Allowed characters: `a-z A-Z 0-9 - _ / = .`; maximum 256 characters; names starting with `_` are reserved for system use. May contain `/`. When calling the HTTP API directly, URL-encode the key so the whole string is treated as one key (for example `user/1` -\u003e `user%2F1`). SDK users should pass the key raw - SDKs URL-encode path parameters automatically.",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "maxLength": 256,
              "pattern": "^[-/_=.a-zA-Z0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key deleted (returned even if the key did not exist)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Bad request — invalid `id` or key name"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "KV namespace not found (a missing key is not an error)"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Conflict — the namespace is not ready (`status` is not `provision_ok`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Delete a key",
        "tags": [
          "kv keys"
        ]
      },
      "get": {
        "description": "Returns the raw stored value for a key. The response body is the value exactly as it was written; the `Content-Type` header echoes the value's stored content type (defaults to `application/octet-stream`).",
        "operationId": "GetKvKey",
        "parameters": [
          {
            "description": "KV namespace ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Key name. Allowed characters: `a-z A-Z 0-9 - _ / = .`; maximum 256 characters; names starting with `_` are reserved for system use. May contain `/`. When calling the HTTP API directly, URL-encode the key so the whole string is treated as one key (for example `user/1` -\u003e `user%2F1`). SDK users should pass the key raw - SDKs URL-encode path parameters automatically.",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "maxLength": 256,
              "pattern": "^[-/_=.a-zA-Z0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Value retrieved successfully. The `Content-Type` header is the value's stored content type (defaults to `application/octet-stream`)."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Bad request — invalid `id` or key name"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Key or namespace not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Conflict — the namespace is not ready (`status` is not `provision_ok`)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get a key's value",
        "tags": [
          "kv keys"
        ]
      },
      "put": {
        "description": "Creates or replaces the value for a key. The request body is stored verbatim as the value — no base64, no JSON envelope — up to 1 MiB. The request's `Content-Type` header is stored with the value and echoed back on retrieval. Returns `201` when the key is created and `200` when an existing key is updated.",
        "operationId": "PutKvKey",
        "parameters": [
          {
            "description": "KV namespace ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Key name. Allowed characters: `a-z A-Z 0-9 - _ / = .`; maximum 256 characters; names starting with `_` are reserved for system use. May contain `/`. When calling the HTTP API directly, URL-encode the key so the whole string is treated as one key (for example `user/1` -\u003e `user%2F1`). SDK users should pass the key raw - SDKs URL-encode path parameters automatically.",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "maxLength": 256,
              "pattern": "^[-/_=.a-zA-Z0-9]+$",
              "type": "string"
            }
          },
          {
            "description": "Time-to-live in seconds. When set, the key expires and is deleted after this duration. Requires a namespace provisioned with TTL support; namespaces without it return a `409`.",
            "in": "query",
            "name": "ttl_secs",
            "schema": {
              "format": "int64",
              "maximum": 9223372036,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "example": "my-value",
              "schema": {
                "description": "Raw value bytes, stored verbatim.",
                "format": "binary",
                "type": "string"
              }
            }
          },
          "description": "The value to store, sent as the raw request body. Maximum size: 1 MiB (1048576 bytes).",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Key updated"
          },
          "201": {
            "description": "Key created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Bad request — invalid `id`, key name, or request body"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "KV namespace not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Conflict — the namespace is not ready (`status` is not `provision_ok`), or `ttl_secs` was set on a namespace without TTL support"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Payload too large — the value exceeds 1 MiB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            },
            "description": "Unprocessable entity — `ttl_secs` is not a positive integer within range, or the unsupported `ttl` parameter was used"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Set a key's value",
        "tags": [
          "kv keys"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Version 2.0.0 of the Telnyx API",
      "url": "https://api.telnyx.com/v2"
    }
  ]
}
