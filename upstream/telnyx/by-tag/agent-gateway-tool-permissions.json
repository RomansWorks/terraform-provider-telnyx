                    ]
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AgentGatewayToolPermissions"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "servers": [
                      {
                        "id": "88d5a97b-4080-4855-8bac-a39811b1dc24",
                        "tools": [
                          "get_order"
                        ]
                      }
                    ]
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/AgentGatewayToolPermissionsResponse"
                }
              }
            },
            "description": "The grant"
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10013",
                      "detail": "One of the associated fields does not exist.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10013"
                      },
                      "source": {
                        "pointer": "/servers/0/id"
                      },
                      "title": "Missing association"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "A server that is not one of the instance's"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10009",
                      "detail": "The required authentication headers were either invalid or not included in the request.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10009"
                      },
                      "title": "Authentication failed"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10005",
                      "detail": "The requested resource or URL could not be found.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10005"
                      },
                      "title": "Resource not found"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "99901",
                      "detail": "The instance is not ready; its engine is not running.",
                      "title": "Instance not ready"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The instance is not `ready`"
          },
          "422": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "10027",
                      "detail": "The value is invalid.",
                      "meta": {
                        "url": "https://developers.telnyx.com/docs/overview/errors/10027"
                      },
                      "source": {
                        "pointer": "/servers"
                      },
                      "title": "Unprocessable Entity"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "A server named twice"
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "errors": [
                    {
                      "code": "99903",
                      "detail": "The instance's engine did not answer; try again shortly.",
                      "title": "Engine unavailable"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TelnyxErrors"
                }
              }
            },
            "description": "The instance's engine did not answer"
          }
        },
        "summary": "Set a key's tool permissions",
        "tags": [
          "Agent Gateway Tool Permissions"
        ]
      }
    },
