{
  "components": {
    "schemas": {
      "AgentGatewayPolicy": {
        "description": "A named set of guardrails.",
        "properties": {
          "base": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A policy this one builds on, by name. The policy starts with the base's guardrails."
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the policy's current version was created. An update creates a new version."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the policy is for."
          },
          "guardrails": {
            "$ref": "#/components/schemas/AgentGatewayPolicyGuardrails"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A condition on the model, by name or regular expression. The policy's guardrails run only on requests for a matching model. `null` matches every model."
          },
          "name": {
            "description": "A name, unique on the instance. A request names the policy in its `policies` field.",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "type": "string"
          },
          "pipeline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentGatewayPolicyPipeline"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ordered steps, in place of the guardrails running independently."
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the policy last changed."
          }
        },
        "required": [
          "name",
          "description",
          "base",
          "guardrails",
          "model",
          "pipeline",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "AgentGatewayPolicyCreate": {
        "properties": {
          "base": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A policy this one builds on, by name. The policy starts with the base's guardrails."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the policy is for."
          },
          "guardrails": {
            "$ref": "#/components/schemas/AgentGatewayPolicyGuardrails"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A condition on the model, by name or regular expression. The policy's guardrails run only on requests for a matching model. `null` matches every model."
          },
          "name": {
            "description": "A name, unique on the instance. A request names the policy in its `policies` field.",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "type": "string"
          },
          "pipeline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentGatewayPolicyPipeline"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ordered steps, in place of the guardrails running independently."
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "AgentGatewayPolicyGuardrails": {
        "description": "The guardrails a policy adds to its base's, and the ones it removes from them, by name.",
        "properties": {
          "add": {
            "default": [],
            "description": "Guardrails the policy runs in addition to its base's.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "remove": {
            "default": [],
            "description": "Guardrails from its base that the policy does not run.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "AgentGatewayPolicyListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AgentGatewayPolicy"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AgentGatewayPolicyPipeline": {
        "description": "Ordered steps that run in place of the policy's guardrails running independently.",
        "properties": {
          "hook": {
            "description": "`before_request` runs the steps on the request, and `after_request` on the model's response.",
            "enum": [
              "before_request",
              "after_request"
            ],
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentGatewayPolicyStep"
            },
            "type": "array"
          }
        },
        "required": [
          "hook",
          "steps"
        ],
        "type": "object"
      },
      "AgentGatewayPolicyResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AgentGatewayPolicy"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "AgentGatewayPolicyStep": {
        "description": "One pipeline step: a guardrail, and what happens when it passes, fails, or errors.",
        "properties": {
          "guardrail": {
            "description": "A guardrail on the instance, by name.",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The response that replaces the model's when an outcome is `respond`. Required with `respond`."
          },
          "on_error": {
            "anyOf": [
              {
                "enum": [
                  "next",
                  "allow",
                  "block",
                  "respond"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What happens when the guardrail errors. Left out, the same as `on_fail`."
          },
          "on_fail": {
            "default": "block",
            "description": "What happens when the guardrail fails.",
            "enum": [
              "next",
              "allow",
              "block",
              "respond"
            ],
            "type": "string"
          },
          "on_pass": {
            "default": "allow",
            "description": "What happens when the guardrail passes. `next` goes on to the next step, `allow` allows the request, `block` blocks it, and `respond` answers with `message`.",
            "enum": [
              "next",
              "allow",
              "block",
              "respond"
            ],
            "type": "string"
          },
          "pass_data": {
            "default": false,
            "description": "`true` hands the step's modified request, such as masked text, to the next step.",
            "type": "boolean"
          }
        },
        "required": [
          "guardrail"
        ],
        "type": "object"
      },
      "AgentGatewayPolicyUpdate": {
        "description": "A field left out stays as it is. `guardrails` and `pipeline` are replaced whole, and `model: null` removes the condition. The name cannot change.",
        "properties": {
          "base": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A policy this one builds on, by name. The policy starts with the base's guardrails."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the policy is for."
          },
          "guardrails": {
            "$ref": "#/components/schemas/AgentGatewayPolicyGuardrails"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A condition on the model, by name or regular expression. The policy's guardrails run only on requests for a matching model. `null` matches every model."
          },
          "pipeline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentGatewayPolicyPipeline"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ordered steps, in place of the guardrails running independently."
          }
        },
        "type": "object"
      },
      "TelnyxError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "meta": {
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "source": {
            "properties": {
              "parameter": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TelnyxErrors": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/TelnyxError"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API key",
        "description": "Telnyx API key supplied as `Authorization: Bearer \u003ctoken\u003e`. In production, auth may be validated by the API gateway and forwarded via Telnyx auth headers.",
        "scheme": "bearer",
        "type": "http"
      },
      "Payment": {
        "description": "Machine Payment Protocol credential used on paid retries, sent as `Authorization: Payment ...`. Obtained by paying a challenge returned in the `WWW-Authenticate` header of a 402 response. This is not a Telnyx API key; initial challenge requests use standard bearer authentication instead.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      },
      "agent-gateway_bearerAuth": {
        "description": "Telnyx API key",
        "scheme": "bearer",
        "type": "http"
      },
